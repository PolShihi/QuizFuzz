@using QuizFuzz.Shared.Dtos.Game

<MudPaper Elevation="2" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
        Scoreboard
    </MudText>

    @if (Scoreboard == null || !Scoreboard.Players.Any())
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            No scores yet...
        </MudText>
    }
    else
    {
        <MudSimpleTable>
            @foreach (var (player, index) in Scoreboard.Players.OrderByDescending(p => p.TotalScore).Select((p, i) => (p, i)))
            {
                <tr>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudChip T="string" Size="Size.Small" Color="@GetRankColor(index)">
                                #@(index + 1)
                            </MudChip>
                            <MudText>@player.Username</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                @player.TotalScore pts
                            </MudChip>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @player.CorrectAnswers correct
                            </MudText>
                        </MudStack>
                    </MudStack>
                </tr>
            }
        </MudSimpleTable>
    }
</MudPaper>

@code {
    [Parameter] public ScoreboardDto? Scoreboard { get; set; }

    private Color GetRankColor(int index)
    {
        return index switch
        {
            0 => Color.Warning,  // Gold
            1 => Color.Default,  // Silver
            2 => Color.Tertiary, // Bronze
            _ => Color.Default
        };
    }
}

