@using QuizFuzz.Shared.Dtos.Game
@using QuizFuzz.Client.Localization

<MudPaper Elevation="0" Class="qf-panel pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" />
        <MudText Typo="Typo.h6">@AppStrings.T("Scoreboard")</MudText>
    </MudStack>

    @if (Scoreboard == null || !Scoreboard.Players.Any())
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-4">
            <MudIcon Icon="@Icons.Material.Filled.Leaderboard" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("NoScoresYet")</MudText>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var item in Scoreboard.Players.OrderByDescending(p => p.TotalScore).Select((player, index) => new { player, index }))
            {
                <MudPaper Elevation="0" Class="qf-standing-row">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <span class="qf-rank-badge @(item.index == 0 ? "qf-rank-top" : string.Empty)">#@(item.index + 1)</span>
                            <MudText>@item.player.Username</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="qf-status-chip">
                                @item.player.TotalScore @AppStrings.T("PointsShort")
                            </MudChip>
                            <MudText Typo="Typo.caption" Class="qf-muted">@item.player.CorrectAnswers @AppStrings.T("CorrectShort")</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public ScoreboardDto? Scoreboard { get; set; }
}
