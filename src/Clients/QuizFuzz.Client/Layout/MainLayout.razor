@using System.Globalization
@using QuizFuzz.Client.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject AppThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<MudLayout Class="@LayoutClass">
    <MudAppBar Elevation="0" Class="qf-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" Class="qf-menu-button" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="qf-brand">
            <MudAvatar Size="Size.Medium" Class="qf-brand-mark">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
            </MudAvatar>
            <div class="qf-brand-copy">
                <MudText Typo="Typo.h6" Class="qf-brand-title">QuizFuzz</MudText>
                <MudText Typo="Typo.caption" Class="qf-brand-subtitle">@AppStrings.T("AppSubtitle")</MudText>
            </div>
        </MudStack>
        <MudSpacer />
        <MudSelect T="string"
                   Value="@CurrentCulture"
                   ValueChanged="@ChangeLanguageAsync"
                   Dense="true"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   Label='@AppStrings.T("Language")'
                   Class="qf-language-selector mr-2">
            <MudSelectItem T="string" Value='@("ru-RU")'>@AppStrings.T("Russian")</MudSelectItem>
            <MudSelectItem T="string" Value='@("en-US")'>@AppStrings.T("English")</MudSelectItem>
        </MudSelect>
        <MudTooltip Text="@ThemeToggleTooltip">
            <MudIconButton Icon="@ThemeToggleIcon" Color="Color.Inherit" OnClick="@ToggleThemeAsync" Class="qf-theme-toggle" />
        </MudTooltip>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/suggest-question" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Lightbulb" Class="qf-appbar-action">
                    @AppStrings.T("Suggest")
                </MudButton>
                <MudIconButton Href="/profile" Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">@AppStrings.T("Login")</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Class="qf-drawer" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader Class="qf-drawer-header">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Size="Size.Large" Class="qf-brand-mark qf-brand-mark-large">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h6" Class="qf-brand-title">QuizFuzz</MudText>
                    <MudText Typo="Typo.caption" Class="qf-brand-subtitle">@AppStrings.T("DrawerSubtitle")</MudText>
                </div>
            </MudStack>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="qf-main">
        <MudContainer MaxWidth="MaxWidth.False" Class="qf-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private string LayoutClass => ThemeService.IsDarkMode
        ? "qf-layout qf-theme-dark"
        : "qf-layout qf-theme-light";

    private string ThemeToggleIcon => ThemeService.IsDarkMode
        ? Icons.Material.Filled.LightMode
        : Icons.Material.Filled.DarkMode;

    private string ThemeToggleTooltip => ThemeService.IsDarkMode
        ? AppStrings.T("SwitchToLightTheme")
        : AppStrings.T("SwitchToDarkTheme");

    private string CurrentCulture => CultureInfo.CurrentUICulture.Name.StartsWith("ru", StringComparison.OrdinalIgnoreCase)
        ? "ru-RU"
        : "en-US";

    protected override void OnInitialized()
    {
        ThemeService.Changed += HandleThemeChanged;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeService.ToggleAsync();
    }

    private async Task ChangeLanguageAsync(string cultureName)
    {
        if (cultureName is not ("ru-RU" or "en-US") || cultureName == CurrentCulture)
            return;

        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "QuizFuzz.Culture", cultureName);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void HandleThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.Changed -= HandleThemeChanged;
    }
}
