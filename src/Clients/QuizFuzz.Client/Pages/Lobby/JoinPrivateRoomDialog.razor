@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
            <MudText Typo="Typo.h6">@AppStrings.T("PrivateRoom")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Class="qf-muted">
                @AppStrings.Tf("JoinPrivateRoomDescription", string.IsNullOrWhiteSpace(RoomName) ? AppStrings.T("PrivateRoom") : RoomName)
            </MudText>

            <MudTextField Label='@AppStrings.T("AccessCodeInput")'
                          @bind-Value="accessCode"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Immediate="true"
                          AutoFocus="true"
                          MaxLength="32"
                          Counter="32"
                          Required="true"
                          RequiredError='@AppStrings.T("AccessCodeInputRequired")'
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Key"
                          OnKeyDown="@HandleKeyDown" />

            @if (!string.IsNullOrWhiteSpace(validationError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@validationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">@AppStrings.T("Cancel")</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Login"
                   OnClick="@Submit">
            @AppStrings.T("Join")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? RoomName { get; set; }

    private string accessCode = string.Empty;
    private string? validationError;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        validationError = null;
        var code = accessCode.Trim();

        if (string.IsNullOrWhiteSpace(code))
        {
            validationError = AppStrings.T("AccessCodeInputRequired");
            return;
        }

        if (code.Length < 4)
        {
            validationError = AppStrings.T("AccessCodeMinLength");
            return;
        }

        if (code.Length > 32)
        {
            validationError = AppStrings.T("AccessCodeMaxLength");
            return;
        }

        MudDialog.Close(DialogResult.Ok(code));
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            Submit();
    }
}
