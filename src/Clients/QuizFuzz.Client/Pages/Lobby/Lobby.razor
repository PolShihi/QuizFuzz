@page "/lobby"
@page "/"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Client.Services.Auth
@using QuizFuzz.Shared.Dtos.Rooms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IRoomsApiClient RoomsClient
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@AppStrings.T("LobbyPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-6">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-4">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Class="qf-page-header-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" />
                    </MudAvatar>
                    <MudText Typo="Typo.h4" Class="qf-section-title">@AppStrings.T("LobbyHeading")</MudText>
                </MudStack>
                <MudText Typo="Typo.body1" Class="qf-muted">
                    @AppStrings.Tf("LobbyWelcome", currentUsername)
                </MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2" Class="qf-action-row">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Class="qf-choice-button"
                           OnClick="@OpenCreateRoomDialog">
                    @AppStrings.T("CreateRoom")
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Logout"
                           Class="qf-choice-button"
                           OnClick="@HandleLogout">
                    @AppStrings.T("Logout")
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="qf-muted">@AppStrings.T("LoadingRooms")</MudText>
        </MudPaper>
    }
    else if (rooms.Count == 0)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h5">@AppStrings.T("RoomsEmptyTitle")</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="qf-muted">
                @AppStrings.T("RoomsEmptyDescription")
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenCreateRoomDialog">
                @AppStrings.T("CreateFirstRoom")
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var room in rooms)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="0" Class="qf-room-card qf-card-hover">
                        <MudCardContent Class="pa-5 d-flex flex-column" Style="height: 100%;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-4">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.h6">@room.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="qf-muted">@AppStrings.Tf("RoomOwner", room.OwnerUsername)</MudText>
                                </MudStack>
                                @if (room.IsPrivate)
                                {
                                    <MudTooltip Text='@AppStrings.T("PrivateRoomTooltip")'>
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" />
                                    </MudTooltip>
                                }
                            </MudStack>

                            <MudStack Spacing="3" Class="flex-grow-1">
                                <MudChip T="string" Size="Size.Small" Color="GetStatusColor(room.Status)" Class="qf-status-chip" Icon="@GetStatusIcon(room.Status)">
                                    @GetStatusText(room.Status)
                                </MudChip>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2">@AppStrings.Tf("PlayersCount", room.CurrentPlayers, room.MaxPlayers)</MudText>
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.caption" Class="qf-muted">@AppStrings.Tf("CreatedAt", AppStrings.RelativeTime(room.CreatedAt))</MudText>
                                </MudStack>
                            </MudStack>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Class="qf-choice-button mt-5"
                                       StartIcon="@Icons.Material.Filled.Login"
                                       OnClick="@(() => JoinRoom(room))"
                                       Disabled="@(room.Status != "Lobby" || room.CurrentPlayers >= room.MaxPlayers)">
                                @(room.IsPrivate ? AppStrings.T("EnterCode") : AppStrings.T("JoinRoom"))
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<RoomListItemDto> rooms = new();
    private string currentUsername = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        currentUsername = user?.Username ?? AppStrings.T("Guest");
        await LoadRooms();
    }

    private async Task LoadRooms()
    {
        isLoading = true;
        rooms = await RoomsClient.GetRoomsAsync();
        isLoading = false;
    }

    private void OpenCreateRoomDialog() => Navigation.NavigateTo("/create-room");

    private async Task JoinRoom(RoomListItemDto room)
    {
        string? accessCode = null;

        if (room.IsPrivate)
        {
            var parameters = new DialogParameters<JoinPrivateRoomDialog>
            {
                { x => x.RoomName, room.Name }
            };

            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
                BackdropClick = false
            };

            var dialog = await DialogService.ShowAsync<JoinPrivateRoomDialog>(AppStrings.T("PrivateRoom"), parameters, options);
            var result = await dialog.Result;

            if (result.Canceled || result.Data is not string code)
                return;

            accessCode = code;
        }

        var success = await RoomsClient.JoinRoomAsync(room.Id, accessCode);
        if (success)
        {
            Navigation.NavigateTo($"/room/{room.Id}");
        }
        else
        {
            Snackbar.Add(room.IsPrivate
                ? AppStrings.T("JoinPrivateRoomFailed")
                : AppStrings.T("JoinRoomFailed"),
                Severity.Error);
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Lobby" => Color.Success,
            "InProgress" => Color.Warning,
            "Finished" => Color.Default,
            _ => Color.Default
        };
    }

    private string GetStatusIcon(string status)
    {
        return status switch
        {
            "Lobby" => Icons.Material.Filled.RadioButtonChecked,
            "InProgress" => Icons.Material.Filled.PlayCircle,
            "Finished" => Icons.Material.Filled.Flag,
            _ => Icons.Material.Filled.Circle
        };
    }


    private string GetStatusText(string status)
    {
        return status switch
        {
            "Lobby" => AppStrings.T("RoomStatusLobby"),
            "InProgress" => AppStrings.T("RoomStatusInProgress"),
            "Finished" => AppStrings.T("RoomStatusFinished"),
            _ => status
        };
    }

}
