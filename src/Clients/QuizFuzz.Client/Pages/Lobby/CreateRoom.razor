@page "/create-room"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Rooms
@using QuizFuzz.Shared.Dtos.Questions
@attribute [Authorize]
@inject IRoomsApiClient RoomsClient
@inject ITagsApiClient TagsClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@AppStrings.T("CreateRoomPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Class="qf-page-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" Class="qf-section-title">@AppStrings.T("CreateRoom")</MudText>
                <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("CreateRoomDescription")</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Class="qf-panel pa-6">
        <EditForm Model="@request" OnValidSubmit="@HandleCreateRoom" OnInvalidSubmit="@HandleInvalidSubmit">
            <DataAnnotationsValidator />

            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="qf-form-section">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" />
                        @AppStrings.T("RoomSettings")
                    </MudText>

                    <MudTextField @bind-Value="request.Name"
                                  Label='@AppStrings.T("RoomName")'
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.MeetingRoom"
                                  Class="mb-4"
                                  For="@(() => request.Name)" />

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="request.MaxPlayers"
                                             Label='@AppStrings.T("MaxPlayers")'
                                             Variant="Variant.Outlined"
                                             Min="2" Max="50"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.People" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="request.Visibility"
                                       Label='@AppStrings.T("Access")'
                                       Variant="Variant.Outlined"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Visibility">
                                <MudSelectItem Value="@("Public")">@AppStrings.T("Public")</MudSelectItem>
                                <MudSelectItem Value="@("Private")">@AppStrings.T("Private")</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    @if (IsPrivateRoom)
                    {
                        <MudTextField @bind-Value="request.AccessCode"
                                      Label='@AppStrings.T("AccessCode")'
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      Immediate="true"
                                      MaxLength="32"
                                      Counter="32"
                                      Required="true"
                                      RequiredError='@AppStrings.T("AccessCodeRequired")'
                                      HelperText='@AppStrings.T("AccessCodeHelper")'
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Key"
                                      Class="mt-4" />
                    }
                </MudPaper>

                <MudPaper Elevation="0" Class="qf-form-section">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
                        @AppStrings.T("VictoryCondition")
                    </MudText>

                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">
                        <MudButton OnClick="@(() => SelectVictoryMode("Points"))"
                                   Variant="@(selectedVictoryMode == "Points" ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.EmojiEvents"
                                   Class="qf-choice-button">
                            @AppStrings.T("WinByPoints")
                        </MudButton>
                        <MudButton OnClick="@(() => SelectVictoryMode("Questions"))"
                                   Variant="@(selectedVictoryMode == "Questions" ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Quiz"
                                   Class="qf-choice-button">
                            @AppStrings.T("WinByRounds")
                        </MudButton>
                    </MudButtonGroup>

                    @if (selectedVictoryMode == "Points")
                    {
                        <MudNumericField @bind-Value="request.VictoryValue"
                                         Label='@AppStrings.T("WinValue")'
                                         Min="50"
                                         Max="10000"
                                         Step="50"
                                         Variant="Variant.Outlined"
                                         HelperText='@AppStrings.T("WinByPoints")'
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Flag" />
                    }
                    else
                    {
                        <MudNumericField @bind-Value="request.NumberOfRounds"
                                         Label='@AppStrings.T("Questions")'
                                         Min="3"
                                         Max="20"
                                         Variant="Variant.Outlined"
                                         HelperText='@AppStrings.T("WinByRounds")'
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.QuestionAnswer" />
                    }
                </MudPaper>

                <MudPaper Elevation="0" Class="qf-form-section">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Class="mr-2" />
                        @AppStrings.T("DifficultyFilter")
                    </MudText>

                    <MudSelect T="string"
                               Label='@AppStrings.T("SelectTags")'
                               MultiSelection="true"
                               @bind-SelectedValues="selectedTagIds"
                               Variant="Variant.Outlined"
                               ToStringFunc="@GetTagName"
                               MultiSelectionTextFunc="@GetSelectedTagsText"
                               HelperText='@AppStrings.T("TagsHelper")'
                               Class="mb-4">
                        @foreach (var tag in availableTags)
                        {
                            <MudSelectItem T="string" Value="@tag.Id.ToString()">@tag.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string"
                               Label='@AppStrings.T("QuestionDifficulty")'
                               MultiSelection="true"
                               @bind-SelectedValues="selectedDifficulties"
                               Variant="Variant.Outlined"
                               HelperText='@AppStrings.T("DifficultyFilter")'>
                        <MudSelectItem T="string" Value="@("Easy")">@AppStrings.T("DifficultyEasy")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Medium")">@AppStrings.T("DifficultyMedium")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Hard")">@AppStrings.T("DifficultyHard")</MudSelectItem>
                    </MudSelect>
                </MudPaper>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                        @errorMessage
                    </MudAlert>
                }

                @if (validationErrors.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@AppStrings.T("FixErrors")</MudText>
                        <ul class="mb-0">
                            @foreach (var error in validationErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <MudStack Row="true" Spacing="2" Class="qf-action-row">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@isLoading"
                               StartIcon="@Icons.Material.Filled.Add">
                        @(isLoading ? AppStrings.T("CreatingRoom") : AppStrings.T("CreateRoom"))
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => Navigation.NavigateTo("/lobby"))">
                        @AppStrings.T("Cancel")
                    </MudButton>
                </MudStack>
            </MudStack>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private CreateRoomRequest request = new();
    private string errorMessage = string.Empty;
    private bool isLoading;
    private List<string> validationErrors = new();
    private List<TagDto> availableTags = new();
    private IEnumerable<string> selectedTagIds = new HashSet<string>();
    private IEnumerable<string> selectedDifficulties = new List<string>();
    private string selectedVictoryMode = "Points";

    private bool IsPrivateRoom => string.Equals(request.Visibility, "Private", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await LoadTags();
    }

    private void SelectVictoryMode(string newMode)
    {
        selectedVictoryMode = newMode;
    }

    private async Task LoadTags()
    {
        try
        {
            availableTags = await TagsClient.GetActiveTagsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = AppStrings.T("TagsLoadFailed");
            Snackbar.Add(AppStrings.Tf("TagsLoadFailedWithError", ex.Message), Severity.Error);
        }
    }

    private string GetTagName(string? tagId)
    {
        if (string.IsNullOrWhiteSpace(tagId))
            return string.Empty;

        var tag = availableTags.FirstOrDefault(t => t.Id.ToString() == tagId);
        return tag?.Name ?? tagId;
    }

    private string GetSelectedTagsText(List<string> selectedValues)
    {
        if (selectedValues.Count == 0)
            return string.Empty;

        return string.Join(", ", selectedValues.Select(GetTagName));
    }

    private void HandleInvalidSubmit()
    {
        validationErrors = new List<string> { AppStrings.T("FixRoomValidationErrors") };
        errorMessage = string.Empty;
    }

    private List<string> ValidateRoomRequest()
    {
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(request.Name))
            errors.Add(AppStrings.T("RoomNameRequired"));
        else
        {
            var nameLength = request.Name.Trim().Length;
            if (nameLength < 3) errors.Add(AppStrings.T("RoomNameMinLength"));
            if (nameLength > 100) errors.Add(AppStrings.T("RoomNameMaxLength"));
        }

        if (request.MaxPlayers is < 2 or > 50)
            errors.Add(AppStrings.T("MaxPlayersRange"));

        if (IsPrivateRoom)
        {
            var accessCode = request.AccessCode?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(accessCode))
                errors.Add(AppStrings.T("AccessCodeRequired"));
            else
            {
                if (accessCode.Length < 4) errors.Add(AppStrings.T("AccessCodeMinLength"));
                if (accessCode.Length > 32) errors.Add(AppStrings.T("AccessCodeMaxLength"));
            }
        }

        if (selectedVictoryMode == "Points")
        {
            if (request.VictoryValue is < 50 or > 10000)
                errors.Add(AppStrings.T("VictoryPointsRange"));
        }
        else if (selectedVictoryMode == "Questions")
        {
            if (request.NumberOfRounds is < 3 or > 20)
                errors.Add(AppStrings.T("QuestionCountRange"));
        }
        else
        {
            errors.Add(AppStrings.T("InvalidVictoryCondition"));
        }

        if (selectedTagIds.Any(id => !Guid.TryParse(id, out _)))
            errors.Add(AppStrings.T("InvalidTagsSelected"));

        var allowedDifficulties = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Easy", "Medium", "Hard" };
        if (selectedDifficulties.Any(d => !allowedDifficulties.Contains(d)))
            errors.Add(AppStrings.T("InvalidDifficultySelected"));

        return errors;
    }

    private async Task HandleCreateRoom()
    {
        errorMessage = string.Empty;
        validationErrors = ValidateRoomRequest();
        if (validationErrors.Count > 0)
            return;

        isLoading = true;

        try
        {
            request.Name = request.Name.Trim();
            request.Visibility = request.Visibility.Trim();
            request.AccessCode = IsPrivateRoom ? request.AccessCode?.Trim() : null;
            request.VictoryConditionType = selectedVictoryMode.ToUpperInvariant();

            request.TagSelections = selectedTagIds
                .Select(tagId => Guid.TryParse(tagId, out var parsed) ? parsed : Guid.Empty)
                .Where(tagId => tagId != Guid.Empty)
                .Select(tagId => new RoomTagSelectionDto { TagId = tagId, Weight = 1 })
                .ToList();

            request.DifficultyFilters = selectedDifficulties.ToList();

            var room = await RoomsClient.CreateRoomAsync(request);
            if (room != null)
            {
                Navigation.NavigateTo($"/room/{room.Id}");
            }
            else
            {
                errorMessage = AppStrings.T("RoomCreateFailed");
            }
        }
        catch (Exception ex)
        {
            errorMessage = AppStrings.Tf("GenericErrorWithMessage", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
