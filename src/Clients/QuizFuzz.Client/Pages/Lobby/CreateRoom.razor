@page "/create-room"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Rooms
@using QuizFuzz.Shared.Dtos.Questions
@attribute [Authorize]
@inject IRoomsApiClient RoomsClient
@inject ITagsApiClient TagsClient
@inject NavigationManager Navigation

<PageTitle>Create Room - QuizFuzz</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h4" GutterBottom="true">Create New Room</MudText>
        
        <EditForm Model="@request" OnValidSubmit="@HandleCreateRoom">
            <DataAnnotationsValidator />
            
            <MudTextField @bind-Value="request.Name" 
                          Label="Room Name" 
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          For="@(() => request.Name)" />

            <MudNumericField @bind-Value="request.MaxPlayers" 
                             Label="Max Players" 
                             Variant="Variant.Outlined"
                             Min="2" Max="50"
                             Class="mb-4" />

            <MudNumericField @bind-Value="request.NumberOfRounds" 
                             Label="Number of Rounds" 
                             Variant="Variant.Outlined"
                             Min="3" Max="20"
                             Class="mb-4"
                             HelperText="Choose how many questions in the game (3-20)" />

            <MudSelect @bind-Value="request.Visibility" 
                       Label="Visibility"
                       Variant="Variant.Outlined"
                       Class="mb-4">
                <MudSelectItem Value="@("Public")">Public</MudSelectItem>
                <MudSelectItem Value="@("Private")">Private</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="request.VictoryConditionType" 
                       Label="Victory Condition"
                       Variant="Variant.Outlined"
                       Class="mb-4">
                <MudSelectItem Value="@("POINTS")">Points</MudSelectItem>
                <MudSelectItem Value="@("QUESTIONS")">Questions</MudSelectItem>
            </MudSelect>

            <MudNumericField @bind-Value="request.VictoryValue" 
                             Label="Victory Value" 
                             Variant="Variant.Outlined"
                             Min="1"
                             Class="mb-4" />

            <MudSelect T="Guid" 
                       Label="Select Tags (optional)" 
                       MultiSelection="true" 
                       @bind-SelectedValues="selectedTagIds"
                       Variant="Variant.Outlined"
                       Class="mb-4"
                       HelperText="Select categories for questions (leave empty for all categories)">
                @foreach (var tag in availableTags)
                {
                    <MudSelectItem T="Guid" Value="@tag.Id">@tag.Name</MudSelectItem>
                }
            </MudSelect>
            
            <MudSelect T="string" 
                       Label="Select Difficulty (optional)" 
                       MultiSelection="true" 
                       @bind-SelectedValues="selectedDifficulties"
                       Variant="Variant.Outlined"
                       Class="mb-4"
                       HelperText="Select difficulty levels (leave empty for all difficulties)">
                <MudSelectItem T="string" Value="@("Easy")">🟢 Easy</MudSelectItem>
                <MudSelectItem T="string" Value="@("Medium")">🟡 Medium</MudSelectItem>
                <MudSelectItem T="string" Value="@("Hard")">🔴 Hard</MudSelectItem>
            </MudSelect>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary"
                           Disabled="@isLoading">
                    @(isLoading ? "Creating..." : "Create Room")
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           OnClick="@(() => Navigation.NavigateTo("/lobby"))">
                    Cancel
                </MudButton>
            </MudStack>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private CreateRoomRequest request = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private List<TagDto> availableTags = new();
    private IEnumerable<Guid> selectedTagIds = new List<Guid>();
    private IEnumerable<string> selectedDifficulties = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("📋 [CreateRoom] Loading available tags...");
        await LoadTags();
    }

    private async Task LoadTags()
    {
        try
        {
            Console.WriteLine("🏷️ [CreateRoom] Calling TagsClient.GetActiveTagsAsync()...");
            availableTags = await TagsClient.GetActiveTagsAsync();
            Console.WriteLine($"✅ [CreateRoom] Loaded {availableTags.Count} tags");
            
            foreach (var tag in availableTags)
            {
                Console.WriteLine($"   📌 Tag: {tag.Name} (ID: {tag.Id})");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ [CreateRoom] Error loading tags: {ex.Message}");
            errorMessage = "Failed to load tags. Please refresh the page.";
        }
    }

    private async Task HandleCreateRoom()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            Console.WriteLine($"🏠 [CreateRoom] Creating room: {request.Name}");
            Console.WriteLine($"   Max Players: {request.MaxPlayers}");
            Console.WriteLine($"   Number of Rounds: {request.NumberOfRounds}");
            Console.WriteLine($"   Victory Type: {request.VictoryConditionType}");
            Console.WriteLine($"   Victory Value: {request.VictoryValue}");
            Console.WriteLine($"   Selected Tags: {selectedTagIds.Count()}");
            Console.WriteLine($"   Selected Difficulties: {selectedDifficulties.Count()}");
            
            // Добавляем выбранные теги в запрос
            request.TagSelections = selectedTagIds.Select(tagId => new RoomTagSelectionDto 
            { 
                TagId = tagId, 
                Weight = 1 
            }).ToList();
            
            // Добавляем фильтры сложности
            request.DifficultyFilters = selectedDifficulties.ToList();
            
            if (request.TagSelections.Any())
            {
                Console.WriteLine($"🏷️ [CreateRoom] Tags being sent:");
                foreach (var tag in request.TagSelections)
                {
                    var tagInfo = availableTags.FirstOrDefault(t => t.Id == tag.TagId);
                    Console.WriteLine($"   📌 {tagInfo?.Name ?? "Unknown"} (ID: {tag.TagId})");
                }
            }
            else
            {
                Console.WriteLine($"🏷️ [CreateRoom] No tags selected - all categories will be used");
            }
            
            if (request.DifficultyFilters.Any())
            {
                Console.WriteLine($"📊 [CreateRoom] Difficulties being sent:");
                foreach (var diff in request.DifficultyFilters)
                {
                    Console.WriteLine($"   🎯 {diff}");
                }
            }
            else
            {
                Console.WriteLine($"📊 [CreateRoom] No difficulties selected - all levels will be used");
            }
            
            var room = await RoomsClient.CreateRoomAsync(request);
            
            if (room != null)
            {
                Console.WriteLine($"✅ [CreateRoom] Room created successfully!");
                Console.WriteLine($"   Room ID: {room.Id}");
                Console.WriteLine($"   Current Players: {room.CurrentPlayers}/{room.MaxPlayers}");
                Console.WriteLine($"➡️ [CreateRoom] Navigating to room...");
                
                Navigation.NavigateTo($"/room/{room.Id}");
            }
            else
            {
                Console.WriteLine($"❌ [CreateRoom] Failed to create room!");
                errorMessage = "Failed to create room. Check console for details.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ [CreateRoom] Exception: {ex.Message}");
            Console.WriteLine($"   Stack trace: {ex.StackTrace}");
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}

