@page "/create-room"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Rooms
@using QuizFuzz.Shared.Dtos.Questions
@attribute [Authorize]
@inject IRoomsApiClient RoomsClient
@inject ITagsApiClient TagsClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Create Room - QuizFuzz</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Class="qf-page-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" Class="qf-section-title">Create Room</MudText>
                <MudText Typo="Typo.body2" Class="qf-muted">Tune the rules, choose content filters and invite players.</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Class="qf-panel pa-6">
        <EditForm Model="@request" OnValidSubmit="@HandleCreateRoom" OnInvalidSubmit="@HandleInvalidSubmit">
            <DataAnnotationsValidator />

            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="qf-form-section">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" />
                        Room setup
                    </MudText>

                    <MudTextField @bind-Value="request.Name"
                                  Label="Room name"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.MeetingRoom"
                                  Class="mb-4"
                                  For="@(() => request.Name)" />

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="request.MaxPlayers"
                                             Label="Max players"
                                             Variant="Variant.Outlined"
                                             Min="2" Max="50"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.People" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="request.Visibility"
                                       Label="Visibility"
                                       Variant="Variant.Outlined"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Visibility">
                                <MudSelectItem Value="@("Public")">Public - anyone can join</MudSelectItem>
                                <MudSelectItem Value="@("Private")">Private - requires access code</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Elevation="0" Class="qf-form-section">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
                        Victory condition
                    </MudText>

                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">
                        <MudButton OnClick="@(() => SelectVictoryMode("Points"))"
                                   Variant="@(selectedVictoryMode == "Points" ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.EmojiEvents"
                                   Class="qf-choice-button">
                            Points Mode
                        </MudButton>
                        <MudButton OnClick="@(() => SelectVictoryMode("Questions"))"
                                   Variant="@(selectedVictoryMode == "Questions" ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Quiz"
                                   Class="qf-choice-button">
                            Questions Mode
                        </MudButton>
                    </MudButtonGroup>

                    @if (selectedVictoryMode == "Points")
                    {
                        <MudNumericField @bind-Value="request.VictoryValue"
                                         Label="Target points to win"
                                         Min="50"
                                         Max="10000"
                                         Step="50"
                                         Variant="Variant.Outlined"
                                         HelperText="First player to reach this score wins the game."
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Flag" />
                    }
                    else
                    {
                        <MudNumericField @bind-Value="request.NumberOfRounds"
                                         Label="Number of questions"
                                         Min="3"
                                         Max="20"
                                         Variant="Variant.Outlined"
                                         HelperText="After the final question, the highest score wins."
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.QuestionAnswer" />
                    }
                </MudPaper>

                <MudPaper Elevation="0" Class="qf-form-section">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Class="mr-2" />
                        Question filters
                    </MudText>

                    <MudSelect T="string"
                               Label="Select tags"
                               MultiSelection="true"
                               @bind-SelectedValues="selectedTagIds"
                               Variant="Variant.Outlined"
                               ToStringFunc="@GetTagName"
                               MultiSelectionTextFunc="@GetSelectedTagsText"
                               HelperText="Leave empty to include all tags."
                               Class="mb-4">
                        @foreach (var tag in availableTags)
                        {
                            <MudSelectItem T="string" Value="@tag.Id.ToString()">@tag.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string"
                               Label="Select difficulty"
                               MultiSelection="true"
                               @bind-SelectedValues="selectedDifficulties"
                               Variant="Variant.Outlined"
                               HelperText="Leave empty to include all difficulty levels.">
                        <MudSelectItem T="string" Value="@("Easy")">Easy</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Medium")">Medium</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Hard")">Hard</MudSelectItem>
                    </MudSelect>
                </MudPaper>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                        @errorMessage
                    </MudAlert>
                }

                @if (validationErrors.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Please fix the following issues:</MudText>
                        <ul class="mb-0">
                            @foreach (var error in validationErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </MudAlert>
                }

                <MudStack Row="true" Spacing="2" Class="qf-action-row">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@isLoading"
                               StartIcon=".Material.Filled.Add">
                        @(isLoading ? "Creating..." : "Create Room")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => Navigation.NavigateTo("/lobby"))">
                        Cancel
                    </MudButton>
                </MudStack>
            </MudStack>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private CreateRoomRequest request = new();
    private string errorMessage = string.Empty;
    private bool isLoading;
    private List<string> validationErrors = new();
    private List<TagDto> availableTags = new();
    private IEnumerable<string> selectedTagIds = new HashSet<string>();
    private IEnumerable<string> selectedDifficulties = new List<string>();
    private string selectedVictoryMode = "Points";

    protected override async Task OnInitializedAsync()
    {
        await LoadTags();
    }

    private void SelectVictoryMode(string newMode)
    {
        selectedVictoryMode = newMode;
    }

    private async Task LoadTags()
    {
        try
        {
            availableTags = await TagsClient.GetActiveTagsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load tags. Please refresh the page.";
            Snackbar.Add($"Failed to load tags: {ex.Message}", Severity.Error);
        }
    }

    private string GetTagName(string? tagId)
    {
        if (string.IsNullOrWhiteSpace(tagId))
            return string.Empty;

        var tag = availableTags.FirstOrDefault(t => t.Id.ToString() == tagId);
        return tag?.Name ?? tagId;
    }

    private string GetSelectedTagsText(List<string> selectedValues)
    {
        if (selectedValues.Count == 0)
            return string.Empty;

        return string.Join(", ", selectedValues.Select(GetTagName));
    }

    private void HandleInvalidSubmit()
    {
        validationErrors = new List<string> { "Please fix the highlighted validation errors before creating the room." };
        errorMessage = string.Empty;
    }

    private List<string> ValidateRoomRequest()
    {
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(request.Name))
            errors.Add("Room name is required.");
        else
        {
            var nameLength = request.Name.Trim().Length;
            if (nameLength < 3) errors.Add("Room name must be at least 3 characters.");
            if (nameLength > 100) errors.Add("Room name cannot exceed 100 characters.");
        }

        if (request.MaxPlayers is < 2 or > 50)
            errors.Add("Max players must be between 2 and 50.");

        if (selectedVictoryMode == "Points")
        {
            if (request.VictoryValue is < 50 or > 10000)
                errors.Add("Target points must be between 50 and 10000.");
        }
        else if (selectedVictoryMode == "Questions")
        {
            if (request.NumberOfRounds is < 3 or > 20)
                errors.Add("Number of questions must be between 3 and 20.");
        }
        else
        {
            errors.Add("Select a valid victory condition.");
        }

        if (selectedTagIds.Any(id => !Guid.TryParse(id, out _)))
            errors.Add("One or more selected tags are invalid. Please reselect tags.");

        var allowedDifficulties = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Easy", "Medium", "Hard" };
        if (selectedDifficulties.Any(d => !allowedDifficulties.Contains(d)))
            errors.Add("One or more selected difficulties are invalid.");

        return errors;
    }

    private async Task HandleCreateRoom()
    {
        errorMessage = string.Empty;
        validationErrors = ValidateRoomRequest();
        if (validationErrors.Count > 0)
            return;

        isLoading = true;

        try
        {
            request.Name = request.Name.Trim();
            request.Visibility = request.Visibility.Trim();
            request.VictoryConditionType = selectedVictoryMode.ToUpperInvariant();

            request.TagSelections = selectedTagIds
                .Select(tagId => Guid.TryParse(tagId, out var parsed) ? parsed : Guid.Empty)
                .Where(tagId => tagId != Guid.Empty)
                .Select(tagId => new RoomTagSelectionDto { TagId = tagId, Weight = 1 })
                .ToList();

            request.DifficultyFilters = selectedDifficulties.ToList();

            var room = await RoomsClient.CreateRoomAsync(request);
            if (room != null)
            {
                Navigation.NavigateTo($"/room/{room.Id}");
            }
            else
            {
                errorMessage = "Failed to create room. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
