@using QuizFuzz.Client.Localization
@using QuizFuzz.Shared.Dtos.Admin
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@AppStrings.Tf("BanUserTitle", User?.Username)</MudText>
    </TitleContent>
    <DialogContent>
        @if (User == null)
        {
            <MudAlert Severity="Severity.Error">@AppStrings.T("UserNotProvided")</MudAlert>
        }
        else
        {
            <MudStack Spacing="3">
                <MudPaper Elevation="0" Class="pa-3 mud-background-gray">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">@User.Username</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@User.Email</MudText>
                    </MudStack>
                </MudPaper>

                <MudSelect T="string" Label="@AppStrings.T("BanDuration")" @bind-Value="banDuration" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@BanDurationOneHour">@AppStrings.T("BanDurationOneHour")</MudSelectItem>
                    <MudSelectItem T="string" Value="@BanDurationOneDay">@AppStrings.T("BanDurationOneDay")</MudSelectItem>
                    <MudSelectItem T="string" Value="@BanDurationSevenDays">@AppStrings.T("BanDurationSevenDays")</MudSelectItem>
                    <MudSelectItem T="string" Value="@BanDurationThirtyDays">@AppStrings.T("BanDurationThirtyDays")</MudSelectItem>
                    <MudSelectItem T="string" Value="@BanDurationCustomHours">@AppStrings.T("BanDurationCustomHours")</MudSelectItem>
                    <MudSelectItem T="string" Value="@BanDurationPermanent">@AppStrings.T("Permanent")</MudSelectItem>
                </MudSelect>

                @if (banDuration == BanDurationCustomHours)
                {
                    <MudNumericField T="int" Label="@AppStrings.T("Hours")" @bind-Value="customBanHours" Min="1" Max="8760" Variant="Variant.Outlined" />
                }

                <MudTextField Label="@AppStrings.T("Reason")"
                              @bind-Value="banReason"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Placeholder="@AppStrings.T("OptionalModerationNote")" />

                @if (!string.IsNullOrWhiteSpace(validationError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@validationError</MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@GetBanPreview()</MudAlert>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">@AppStrings.T("Cancel")</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(User == null)" OnClick="@Submit">
            @AppStrings.T("Ban")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string BanDurationOneHour = "1h";
    private const string BanDurationOneDay = "1d";
    private const string BanDurationSevenDays = "7d";
    private const string BanDurationThirtyDays = "30d";
    private const string BanDurationCustomHours = "custom";
    private const string BanDurationPermanent = "permanent";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public UserManagementDto? User { get; set; }

    private string banReason = string.Empty;
    private string banDuration = BanDurationSevenDays;
    private int customBanHours = 24;
    private string? validationError;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        validationError = null;

        if (User == null)
        {
            validationError = AppStrings.T("UserNotProvided");
            return;
        }

        if (banDuration == BanDurationCustomHours && customBanHours < 1)
        {
            validationError = AppStrings.T("CustomBanDurationMin");
            return;
        }

        var request = new BanUserRequest
        {
            UserId = User.Id,
            Reason = banReason?.Trim() ?? string.Empty,
            BannedUntil = CalculateBannedUntil()
        };

        MudDialog.Close(DialogResult.Ok(request));
    }

    private DateTime? CalculateBannedUntil()
    {
        var utcNow = DateTime.UtcNow;
        return banDuration switch
        {
            BanDurationOneHour => utcNow.AddHours(1),
            BanDurationOneDay => utcNow.AddDays(1),
            BanDurationSevenDays => utcNow.AddDays(7),
            BanDurationThirtyDays => utcNow.AddDays(30),
            BanDurationCustomHours => utcNow.AddHours(customBanHours),
            BanDurationPermanent => null,
            _ => utcNow.AddDays(7)
        };
    }

    private string GetBanPreview()
    {
        var bannedUntil = CalculateBannedUntil();
        return bannedUntil.HasValue
            ? AppStrings.Tf("BanPreviewUntil", bannedUntil.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
            : AppStrings.T("BanPreviewPermanent");
    }
}
