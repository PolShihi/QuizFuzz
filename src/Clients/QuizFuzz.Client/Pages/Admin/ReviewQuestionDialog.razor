@using MudBlazor
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Moderation
@using QuizFuzz.Client.Localization
@inject IModerationApiClient ModerationClient

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@AppStrings.T("ReviewQuestion")</MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="3">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Color="Color.Secondary">@AppStrings.T("CommonLoading")</MudText>
            </MudStack>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@error</MudAlert>
        }
        else if (question != null)
        {
            <MudStack Spacing="3">
                <MudTextField Label="@AppStrings.T("Title")" @bind-Value="question.Title" ReadOnly="true" Variant="Variant.Outlined" />
                <MudTextField Label="@AppStrings.T("QuestionText")"
                              @bind-Value="question.PromptText"
                              Lines="3"
                              ReadOnly="true"
                              Variant="Variant.Outlined" />

                <MudStack Row="true" Spacing="2">
                    <MudChip T="string" Size="Size.Small">@AppStrings.QuestionType(question.Type)</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@AppStrings.QuestionDifficulty(question.Difficulty)</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@AppStrings.QuestionStatus(question.Status)</MudChip>
                </MudStack>


                @if (!string.IsNullOrWhiteSpace(question.MediaUrl))
                {
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@AppStrings.T("MediaPreview")</MudText>
                        @if (question.Type.Equals("Image", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudImage Src="@question.MediaUrl" Alt="@AppStrings.T("QuestionImageAlt")" Class="rounded-lg" Style="max-height: 260px; max-width: 100%; object-fit: contain;" />
                        }
                        else if (question.Type.Equals("Audio", StringComparison.OrdinalIgnoreCase))
                        {
                            <audio controls style="width: 100%;">
                                <source src="@question.MediaUrl" />
                                @AppStrings.T("AudioElementNotSupported")
                            </audio>
                        }
                        else
                        {
                            <MudLink Href="@question.MediaUrl" Target="_blank">@AppStrings.T("OpenMedia")</MudLink>
                        }
                    </MudPaper>
                }

                <MudText Typo="Typo.h6">@AppStrings.T("Answers")</MudText>
                @foreach (var answer in question.Answers)
                {
                    <MudPaper Elevation="1" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText><strong>@answer.AnswerText</strong></MudText>
                                @if (answer.IsPrimary)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@AppStrings.T("Primary")</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @AppStrings.T("AcceptanceThreshold"): @((answer.MinConfidence ?? 0.75m).ToString("P0"))
                            </MudText>
                            @if (answer.Aliases?.Any() == true)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @AppStrings.T("Aliases"): @string.Join(", ", answer.Aliases.Select(a => a.AliasText))
                                </MudText>
                            }
                        </MudStack>
                    </MudPaper>
                }



                <MudText Typo="Typo.h6">@AppStrings.T("Hints")</MudText>
                @if (question.Hints?.Any() == true)
                {
                    @foreach (var hint in question.Hints.OrderBy(h => h.OrderIndex).ThenBy(h => h.RevealTimeSeconds).Select((h, index) => new { Hint = h, Index = index }))
                    {
                        <MudPaper Elevation="1" Class="pa-3">
                            <MudStack Spacing="1">
                                <MudText><strong>@AppStrings.Tf("HintNumber", hint.Index + 1)</strong></MudText>
                                <MudText Typo="Typo.body2">@hint.Hint.HintText</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@AppStrings.Tf("RevealAtSecondsValue", hint.Hint.RevealTimeSeconds)</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@AppStrings.T("NoHints")</MudText>
                }

                <MudTextField Label="@AppStrings.T("CommentOptional")"
                              @bind-Value="comment"
                              Lines="2"
                              Variant="Variant.Outlined" />
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@isSubmitting" OnClick="@Cancel">@AppStrings.T("Cancel")</MudButton>
        <MudButton Disabled="@isSubmitting"
                   Color="Color.Error"
                   Variant="Variant.Filled"
                   OnClick="@Reject">
            @AppStrings.T("CommonReject")
        </MudButton>
        <MudButton Disabled="@isSubmitting"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="@Approve">
            @AppStrings.T("CommonApprove")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid QuestionId { get; set; }
    [Parameter] public string? CurrentStatus { get; set; }

    private ModerationQuestionDetailsDto? question;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? error;
    private string comment = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            question = await ModerationClient.GetQuestionForModerationAsync(QuestionId);
            if (question == null)
            {
                error = AppStrings.T("QuestionDetailsLoadFailed");
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Approve()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        error = null;
        try
        {
            var ok = await ModerationClient.ApproveAsync(new ModerationActionRequest
            {
                QueueId = QuestionId,
                Action = "APPROVE",
                Comment = comment
            });
            if (!ok)
            {
                error = AppStrings.T("ApproveFailed");
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Reject()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        error = null;
        try
        {
            var reason = string.IsNullOrWhiteSpace(comment) ? AppStrings.T("RejectedByModerator") : comment;
            var ok = await ModerationClient.RejectAsync(new ModerationActionRequest
            {
                QueueId = QuestionId,
                Action = "REJECT",
                Comment = comment,
                Reason = reason
            });
            if (!ok)
            {
                error = AppStrings.T("RejectFailed");
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
