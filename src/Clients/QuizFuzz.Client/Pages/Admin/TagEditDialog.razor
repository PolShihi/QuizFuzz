@using QuizFuzz.Client.Localization
@using QuizFuzz.Shared.Dtos.Questions
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@AppStrings.T("EditTagTitle")</MudText>
    </TitleContent>
    <DialogContent>
        @if (Tag == null)
        {
            <MudAlert Severity="Severity.Error">@AppStrings.T("TagNotProvided")</MudAlert>
        }
        else
        {
            <MudStack Spacing="3">
                <MudTextField Label="@AppStrings.T("Name")"
                              Value="@Tag.Name"
                              Variant="Variant.Outlined"
                              Disabled="true"
                              HelperText="@AppStrings.T("TagNameFixedHelper")" />
                <MudTextField Label="@AppStrings.T("Description")"
                              @bind-Value="description"
                              Lines="4"
                              MaxLength="500"
                              Counter="500"
                              Variant="Variant.Outlined" />
                @if (!string.IsNullOrWhiteSpace(validationError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@validationError</MudAlert>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">@AppStrings.T("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(Tag == null)" OnClick="@Submit">@AppStrings.T("CommonSave")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TagDto? Tag { get; set; }

    private string description = string.Empty;
    private string? validationError;

    protected override void OnParametersSet()
    {
        description = Tag?.Description ?? string.Empty;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var trimmedDescription = description?.Trim() ?? string.Empty;
        if (trimmedDescription.Length > 500)
        {
            validationError = AppStrings.T("DescriptionMax");
            return;
        }

        MudDialog.Close(DialogResult.Ok(trimmedDescription));
    }
}
