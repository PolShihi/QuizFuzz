@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Moderator,Admin")]
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard - QuizFuzz</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-8">Admin Dashboard</MudText>

    <MudGrid>
        <AuthorizeView Roles="Moderator,Admin" Context="modContext">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="cursor-pointer" Style="height: 200px;" @onclick="@(() => Navigation.NavigateTo("/admin/moderation"))">
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Large" Color="Color.Warning" />
                        <MudText Typo="Typo.h5" Class="mt-4">Moderation Queue</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Review submitted questions</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="cursor-pointer" Style="height: 200px;" @onclick="@(() => Navigation.NavigateTo("/admin/questions"))">
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.Quiz" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h5" Class="mt-4">Questions</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Manage all questions</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </AuthorizeView>

        <AuthorizeView Roles="Admin" Context="adminContext">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="cursor-pointer" Style="height: 200px;" @onclick="@(() => Navigation.NavigateTo("/admin/users"))">
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Info" />
                        <MudText Typo="Typo.h5" Class="mt-4">Users</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Manage users and roles</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="cursor-pointer" Style="height: 200px;" @onclick="@(() => Navigation.NavigateTo("/admin/tags"))">
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Large" Color="Color.Success" />
                        <MudText Typo="Typo.h5" Class="mt-4">Tags</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Manage question tags</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </AuthorizeView>
    </MudGrid>

    <MudPaper Elevation="2" Class="pa-4 mt-8">
        <MudText Typo="Typo.h6" Class="mb-2">Quick Stats</MudText>
        <MudText Color="Color.Secondary">Dashboard statistics coming soon...</MudText>
    </MudPaper>
</MudContainer>
