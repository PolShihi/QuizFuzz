@page "/admin"
@using QuizFuzz.Client.Localization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Moderator,Admin")]
@inject NavigationManager Navigation

<PageTitle>@AppStrings.T("AdminDashboardPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Class="qf-page-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" Class="qf-section-title">@AppStrings.T("AdminDashboardHeading")</MudText>
                <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("AdminDashboardDescription")</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="3">
        <AuthorizeView Roles="Moderator,Admin" Context="modContext">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="0" Class="qf-dashboard-card" @onclick="@(() => Navigation.NavigateTo("/admin/moderation"))">
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Large" Color="Color.Warning" />
                        <MudText Typo="Typo.h5" Class="mt-4">@AppStrings.T("ModerationQueue")</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("ModerationCardDescription")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="0" Class="qf-dashboard-card" @onclick="@(() => Navigation.NavigateTo("/admin/questions"))">
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.Quiz" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h5" Class="mt-4">@AppStrings.T("Questions")</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("QuestionsManagementDescription")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="0" Class="qf-dashboard-card" @onclick="@(() => Navigation.NavigateTo("/admin/tags"))">
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Large" Color="Color.Success" />
                        <MudText Typo="Typo.h5" Class="mt-4">@AppStrings.T("Tags")</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("TagsManagementDescription")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </AuthorizeView>

        <AuthorizeView Roles="Admin" Context="adminContext">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="0" Class="qf-dashboard-card" @onclick="@(() => Navigation.NavigateTo("/admin/users"))">
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Info" />
                        <MudText Typo="Typo.h5" Class="mt-4">@AppStrings.T("Users")</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("UsersManagementDescription")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </AuthorizeView>
    </MudGrid>

    <MudPaper Elevation="0" Class="qf-panel pa-5 mt-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Secondary" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@AppStrings.T("BriefStats")</MudText>
                <MudText Class="qf-muted">@AppStrings.T("StatsComingSoon")</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>
