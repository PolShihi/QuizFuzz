@page "/admin/tags"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Questions
@using QuizFuzz.Client.Localization
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = "Moderator,Admin")]
@inject IAdminApiClient AdminClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@AppStrings.T("TagsManagementPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-2">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Label" Class="mr-2" />
                @AppStrings.T("TagsManagementHeading")
            </MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="@LoadTags">
                    @AppStrings.T("Refresh")
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@OpenCreateDialog">
                    @AppStrings.T("CreateTag")
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="qf-table-panel"><MudTable Items="@tags" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Filter="new Func<TagDto, bool>(FilterFunc)">
            <ToolBarContent>
                <MudTextField @bind-Value="searchString"
                              Placeholder="@AppStrings.T("TagsSearchPlaceholder")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Immediate="true"
                              Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@AppStrings.T("Name")</MudTh>
                <MudTh>@AppStrings.T("Description")</MudTh>
                <MudTh>@AppStrings.T("Status")</MudTh>
                <MudTh>@AppStrings.T("Actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@AppStrings.T("Name")">
                    <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("Description")">
                    <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.Description) ? "—" : context.Description)</MudText>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("Status")">
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Warning)">
                        @(context.IsActive ? AppStrings.T("Active") : AppStrings.T("SuggestedInactive"))
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("Actions")">
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Title="@AppStrings.T("EditDescription")"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(context))" />
                        @if (!context.IsActive)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Title="@AppStrings.T("ApproveActivateTag")"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="@(() => ActivateTag(context))" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Title="@AppStrings.T("DeleteDeactivateTag")"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteTag(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">@AppStrings.T("NoTagsFound")</MudText>
            </NoRecordsContent>
        </MudTable></MudPaper>
    }
</MudContainer>

@code {
    private List<TagDto> tags = new();
    private bool isLoading = true;
    private bool isSaving;
    private string searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTags();
    }

    private async Task LoadTags()
    {
        try
        {
            isLoading = true;
            tags = await AdminClient.GetTagsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(AppStrings.Tf("FailedLoadTags", ex.Message), Severity.Error);
            tags = new List<TagDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<TagCreateDialog>(AppStrings.T("CreateTag"), options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not TagEditModel model)
            return;

        await CreateTag(model);
    }

    private async Task OpenEditDialog(TagDto tag)
    {
        var parameters = new DialogParameters<TagEditDialog>
        {
            { x => x.Tag, tag }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<TagEditDialog>(AppStrings.Tf("EditTagTitleWithName", tag.Name), parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not string description)
            return;

        await UpdateDescription(tag, description);
    }

    private async Task CreateTag(TagEditModel model)
    {
        if (isSaving)
            return;

        try
        {
            isSaving = true;
            var created = await AdminClient.CreateTagAsync(model.Name, model.Description);
            if (created == null)
            {
                Snackbar.Add(AppStrings.T("FailedCreateTag"), Severity.Error);
                return;
            }

            Snackbar.Add(AppStrings.T("TagCreated"), Severity.Success);
            await LoadTags();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateDescription(TagDto tag, string? description)
    {
        if (isSaving)
            return;

        try
        {
            isSaving = true;
            var updated = await AdminClient.UpdateTagDescriptionAsync(tag.Id, description);
            if (updated == null)
            {
                Snackbar.Add(AppStrings.T("FailedUpdateTag"), Severity.Error);
                return;
            }

            Snackbar.Add(AppStrings.T("TagUpdated"), Severity.Success);
            await LoadTags();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ActivateTag(TagDto tag)
    {
        if (isSaving)
            return;

        try
        {
            isSaving = true;
            var success = await AdminClient.ActivateTagAsync(tag.Id);
            if (!success)
            {
                Snackbar.Add(AppStrings.T("FailedActivateTag"), Severity.Error);
                return;
            }

            Snackbar.Add(AppStrings.T("TagActivated"), Severity.Success);
            await LoadTags();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteTag(TagDto tag)
    {
        if (isSaving)
            return;

        var confirm = await DialogService.ShowMessageBox(
            AppStrings.T("DeleteTagTitle"),
            AppStrings.Tf("DeleteTagMessage", tag.Name),
            yesText: AppStrings.T("CommonDelete"),
            cancelText: AppStrings.T("Cancel"));

        if (confirm != true)
            return;

        try
        {
            isSaving = true;
            var success = await AdminClient.DeleteTagAsync(tag.Id);
            if (!success)
            {
                Snackbar.Add(AppStrings.T("FailedDeleteTag"), Severity.Error);
                return;
            }

            Snackbar.Add(AppStrings.T("TagDeleted"), Severity.Success);
            await LoadTags();
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool FilterFunc(TagDto tag)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var value = searchString.Trim();
        return tag.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
            || (tag.Description?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)
            || (tag.IsActive ? "active" : "suggested inactive pending").Contains(value, StringComparison.OrdinalIgnoreCase);
    }
}
