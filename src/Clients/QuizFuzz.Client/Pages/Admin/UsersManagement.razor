@page "/admin/users"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Admin
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IAdminApiClient AdminClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@AppStrings.T("UsersManagementPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                @AppStrings.T("UsersManagementHeading")
            </MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@LoadUsers">
                @AppStrings.T("Refresh")
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="qf-table-panel"><MudTable Items="@users" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Filter="new Func<UserManagementDto, bool>(FilterFunc)">
            <ToolBarContent>
                <MudTextField @bind-Value="searchString"
                              Placeholder='@AppStrings.T("UsersSearchPlaceholder")'
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Immediate="true"
                              Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@AppStrings.T("UsernameColumn")</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>@AppStrings.T("Roles")</MudTh>
                <MudTh>@AppStrings.T("Status")</MudTh>
                <MudTh>@AppStrings.T("Registration")</MudTh>
                <MudTh>@AppStrings.T("LastLogin")</MudTh>
                <MudTh>@AppStrings.T("CommonActions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel='@AppStrings.T("UsernameColumn")'>
                    <MudText Typo="Typo.body2"><b>@context.Username</b></MudText>
                </MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel='@AppStrings.T("Roles")'>
                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        @foreach (var role in context.Roles.OrderBy(GetRoleSortOrder))
                        {
                            <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(role)">@AppStrings.Role(role)</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel='@AppStrings.T("Status")'>
                    @if (context.IsBanned)
                    {
                        <MudStack Spacing="0">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@AppStrings.T("UserBanned")</MudChip>
                            <MudText Typo="Typo.caption">@GetBanCaption(context)</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@AppStrings.T("UserActive")</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel='@AppStrings.T("Registration")'>
                    <MudText Typo="Typo.caption">@context.CreatedAt.ToString("dd/MM/yyyy")</MudText>
                </MudTd>
                <MudTd DataLabel='@AppStrings.T("LastLogin")'>
                    <MudText Typo="Typo.caption">@(context.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? AppStrings.T("Never"))</MudText>
                </MudTd>
                <MudTd DataLabel='@AppStrings.T("CommonActions")'>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts"
                                       Title='@AppStrings.T("ChangeRoles")'
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenRolesDialog(context))" />
                        @if (!context.IsBanned)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Block"
                                           Title='@AppStrings.T("BanUser")'
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => OpenBanDialog(context))" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Title='@AppStrings.T("UnbanUser")'
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="@(() => UnbanUser(context))" />
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">@AppStrings.T("NoUsersFound")</MudText>
            </NoRecordsContent>
        </MudTable></MudPaper>
    }
</MudContainer>

@code {
    private List<UserManagementDto> users = new();
    private bool isLoading = true;
    private bool isSaving;
    private string searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            isLoading = true;
            users = await AdminClient.GetUsersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(AppStrings.T("FailedLoadUsers"), ex.Message), Severity.Error);
            users = new List<UserManagementDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenRolesDialog(UserManagementDto user)
    {
        var parameters = new DialogParameters<UserRolesDialog>
        {
            { x => x.User, user }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<UserRolesDialog>(string.Format(AppStrings.T("ManageRolesTitle"), user.Username), parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not List<string> roles)
            return;

        await SaveRoles(user, roles);
    }

    private async Task SaveRoles(UserManagementDto user, List<string> roles)
    {
        if (isSaving)
            return;

        var normalizedRoles = roles
            .Where(role => !string.IsNullOrWhiteSpace(role))
            .Select(role => role.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!normalizedRoles.Contains("User", StringComparer.OrdinalIgnoreCase))
            normalizedRoles.Insert(0, "User");

        var request = new UpdateUserRolesRequest
        {
            UserId = user.Id,
            Roles = normalizedRoles
        };

        try
        {
            isSaving = true;
            var success = await AdminClient.UpdateUserRolesAsync(request);
            if (success)
            {
                Snackbar.Add(AppStrings.T("UserRolesUpdated"), Severity.Success);
                await LoadUsers();
            }
            else
            {
                Snackbar.Add(AppStrings.T("FailedUpdateUserRoles"), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(AppStrings.T("FailedUpdateUserRoles") + ": {0}", ex.Message), Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OpenBanDialog(UserManagementDto user)
    {
        var parameters = new DialogParameters<UserBanDialog>
        {
            { x => x.User, user }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<UserBanDialog>(string.Format(AppStrings.T("BanUserTitle"), user.Username), parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not BanUserRequest request)
            return;

        await ConfirmBan(request);
    }

    private async Task ConfirmBan(BanUserRequest request)
    {
        if (isSaving)
            return;

        try
        {
            isSaving = true;
            var success = await AdminClient.BanUserAsync(request);
            if (success)
            {
                Snackbar.Add(AppStrings.T("UserBannedMessage"), Severity.Success);
                await LoadUsers();
            }
            else
            {
                Snackbar.Add(AppStrings.T("FailedBanUser"), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(AppStrings.T("FailedBanUser") + ": {0}", ex.Message), Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UnbanUser(UserManagementDto user)
    {
        if (isSaving)
            return;

        try
        {
            isSaving = true;
            var success = await AdminClient.UnbanUserAsync(user.Id);
            if (success)
            {
                Snackbar.Add(AppStrings.T("UserUnbannedMessage"), Severity.Success);
                await LoadUsers();
            }
            else
            {
                Snackbar.Add(AppStrings.T("FailedUnbanUser"), Severity.Error);
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetBanCaption(UserManagementDto user)
    {
        return user.BannedUntil.HasValue
            ? string.Format(AppStrings.T("UntilDate"), user.BannedUntil.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
            : AppStrings.T("Permanent");
    }

    private bool FilterFunc(UserManagementDto user)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var search = searchString.Trim();
        return user.Username.Contains(search, StringComparison.OrdinalIgnoreCase)
               || user.Email.Contains(search, StringComparison.OrdinalIgnoreCase)
               || user.Roles.Any(r => r.Contains(search, StringComparison.OrdinalIgnoreCase))
               || (user.IsBanned ? "banned" : "active").Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static Color GetRoleColor(string role) => role switch
    {
        "Admin" => Color.Error,
        "Moderator" => Color.Warning,
        "User" => Color.Primary,
        _ => Color.Default
    };

    private static int GetRoleSortOrder(string role) => role switch
    {
        "Admin" => 0,
        "Moderator" => 1,
        "User" => 2,
        _ => 3
    };
}
