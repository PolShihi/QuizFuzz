@page "/admin/moderation"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Moderation
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Moderator,Admin")]
@inject IModerationApiClient ModerationClient
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Moderation Queue - QuizFuzz</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" />
                Moderation Queue
            </MudText>
            <MudChip T="string" Color="Color.Warning">@pendingCount Under Review</MudChip>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Class="qf-toolbar pa-4 mb-5">
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="@(selectedStatus == "UnderReview" ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Warning"
                       OnClick="@(() => FilterByStatus("UnderReview"))">
                Under Review (@pendingCount)
            </MudButton>
            <MudButton Variant="@(selectedStatus == "APPROVED" ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Success"
                       OnClick="@(() => FilterByStatus("APPROVED"))">
                Approved
            </MudButton>
            <MudButton Variant="@(selectedStatus == "REJECTED" ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Error"
                       OnClick="@(() => FilterByStatus("REJECTED"))">
                Rejected
            </MudButton>
            <MudButton Variant="@(selectedStatus == null ? Variant.Filled : Variant.Outlined)"
                       OnClick="@(() => FilterByStatus(null))">
                All
            </MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@LoadQueue">
                Refresh
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudPaper>
    }
    else if (!queue.Any())
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                <MudText Typo="Typo.h6">No items in queue</MudText>
                <MudText Color="Color.Secondary">All caught up!</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="qf-table-panel"><MudTable Items="@queue" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Question</MudTh>
                <MudTh>Submitted By</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Question">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body1"><strong>@context.QuestionTitle</strong></MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(context.QuestionText.Length > 100 ? context.QuestionText.Substring(0, 100) + "..." : context.QuestionText)
                        </MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Submitted By">
                    <MudText>@context.SubmittedByUsername</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Date">
                    <MudText Typo="Typo.caption">@context.CreatedAt.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Filled"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.RateReview"
                                   OnClick="@(async () => await ReviewQuestion(context))">
                            Review
                        </MudButton>
                        @if (context.Status == "UnderReview")
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       OnClick="@(async () => await QuickApprove(context))">
                                Approve
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Cancel"
                                       OnClick="@(async () => await QuickReject(context))">
                                Reject
                            </MudButton>
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable></MudPaper>
    }
</MudContainer>

@code {
    private List<ModerationQueueDto> queue = new();
    private bool isLoading = true;
    private string? selectedStatus = "UnderReview";
    private int pendingCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadQueue();
    }

    private async Task LoadQueue()
    {
        isLoading = true;
        queue = await ModerationClient.GetModerationQueueAsync(selectedStatus);
        pendingCount = queue.Count(q => q.Status == "UnderReview");
        isLoading = false;
    }

    private async Task FilterByStatus(string? status)
    {
        selectedStatus = status;
        await LoadQueue();
    }

    private async Task ReviewQuestion(ModerationQueueDto item)
    {
        var parameters = new DialogParameters
        {
            ["QuestionId"] = item.QuestionId,
            ["CurrentStatus"] = item.Status
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = DialogService.Show<ReviewQuestionDialog>("Review Question", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadQueue();
        }
    }

    private async Task QuickApprove(ModerationQueueDto item)
    {
        var request = new ModerationActionRequest
        {
            QueueId = item.Id,
            Action = "APPROVE"
        };

        var success = await ModerationClient.ApproveAsync(request);
        if (success)
        {
            await LoadQueue();
        }
    }

    private async Task QuickReject(ModerationQueueDto item)
    {
        var request = new ModerationActionRequest
        {
            QueueId = item.Id,
            Action = "REJECT",
            Reason = "Quick reject"
        };

        var success = await ModerationClient.RejectAsync(request);
        if (success)
        {
            await LoadQueue();
        }
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "UnderReview" => Color.Warning,
            "APPROVED" => Color.Success,
            "REJECTED" => Color.Error,
            _ => Color.Default
        };
    }
}

