@using QuizFuzz.Client.Localization
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@AppStrings.T("CreateTagTitle")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="@AppStrings.T("Name")"
                          @bind-Value="name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="@AppStrings.T("TagNameRequired")"
                          Immediate="true"
                          MaxLength="50"
                          Counter="50"
                          HelperText="@AppStrings.T("TagNameHelper")" />
            <MudTextField Label="@AppStrings.T("Description")"
                          @bind-Value="description"
                          Lines="3"
                          MaxLength="500"
                          Counter="500"
                          Variant="Variant.Outlined" />

            @if (!string.IsNullOrWhiteSpace(validationError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@validationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">@AppStrings.T("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Submit">@AppStrings.T("CommonCreate")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string name = string.Empty;
    private string description = string.Empty;
    private string? validationError;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        validationError = null;

        var trimmedName = name.Trim();
        var trimmedDescription = description?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            validationError = AppStrings.T("TagNameRequired");
            return;
        }

        if (trimmedName.Length < 2)
        {
            validationError = AppStrings.T("TagNameMin");
            return;
        }

        if (trimmedName.Length > 50)
        {
            validationError = AppStrings.T("TagNameMax");
            return;
        }

        if (trimmedDescription.Length > 500)
        {
            validationError = AppStrings.T("DescriptionMax");
            return;
        }

        MudDialog.Close(DialogResult.Ok(new TagEditModel
        {
            Name = trimmedName,
            Description = trimmedDescription
        }));
    }
}
