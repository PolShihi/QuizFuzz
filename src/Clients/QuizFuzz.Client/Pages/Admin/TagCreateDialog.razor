@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create Tag</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Name"
                          @bind-Value="name"
                          Variant="Variant.Outlined"
                          Required="true"
                          Immediate="true"
                          HelperText="Tag name is fixed after creation." />
            <MudTextField Label="Description"
                          @bind-Value="description"
                          Lines="3"
                          Variant="Variant.Outlined" />

            @if (!string.IsNullOrWhiteSpace(validationError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@validationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string name = string.Empty;
    private string description = string.Empty;
    private string? validationError;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        validationError = null;

        if (string.IsNullOrWhiteSpace(name))
        {
            validationError = "Tag name is required.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new TagEditModel
        {
            Name = name.Trim(),
            Description = description?.Trim()
        }));
    }
}
