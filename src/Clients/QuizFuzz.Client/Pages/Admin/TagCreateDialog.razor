@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create Tag</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Name"
                          @bind-Value="name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Tag name is required."
                          Immediate="true"
                          MaxLength="50"
                          Counter="50"
                          HelperText="Tag name is fixed after creation. Use 2-50 characters." />
            <MudTextField Label="Description"
                          @bind-Value="description"
                          Lines="3"
                          MaxLength="500"
                          Counter="500"
                          Variant="Variant.Outlined" />

            @if (!string.IsNullOrWhiteSpace(validationError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@validationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string name = string.Empty;
    private string description = string.Empty;
    private string? validationError;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        validationError = null;

        var trimmedName = name.Trim();
        var trimmedDescription = description?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            validationError = "Tag name is required.";
            return;
        }

        if (trimmedName.Length < 2)
        {
            validationError = "Tag name must be at least 2 characters.";
            return;
        }

        if (trimmedName.Length > 50)
        {
            validationError = "Tag name cannot exceed 50 characters.";
            return;
        }

        if (trimmedDescription.Length > 500)
        {
            validationError = "Description cannot exceed 500 characters.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new TagEditModel
        {
            Name = trimmedName,
            Description = trimmedDescription
        }));
    }
}
