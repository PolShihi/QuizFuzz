@using MudBlazor
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Questions
@using QuizFuzz.Client.Localization
@using Microsoft.AspNetCore.Components.Forms
@inject IQuestionsApiClient QuestionsClient
@inject IAdminApiClient AdminClient
@inject IMediaApiClient MediaClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@title</MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="3">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Color="Color.Secondary">@AppStrings.T("CommonLoading")</MudText>
            </MudStack>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@error</MudAlert>
        }
        else if (question != null)
        {
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudStack Spacing="3">
                        <MudTextField T="string" Label="@AppStrings.T("Title")"
                                      @bind-Value="question.Title"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      ReadOnly="@(!isEdit)" />

                        <MudTextField T="string" Label="@AppStrings.T("QuestionText")"
                                      @bind-Value="question.PromptText"
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      ReadOnly="@(!isEdit)" />

                        <MudStack Row="true" Spacing="2">
                            <MudSelect T="string" Label="@AppStrings.T("Type")" @bind-Value="question.QuestionType" Variant="Variant.Outlined" ReadOnly="@(!isEdit)">
                                <MudSelectItem T="string" Value='@("TEXT")'>@AppStrings.QuestionType("Text")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("IMAGE")'>@AppStrings.QuestionType("Image")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("AUDIO")'>@AppStrings.QuestionType("Audio")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("VIDEO")'>@AppStrings.QuestionType("Video")</MudSelectItem>
                            </MudSelect>

                            <MudSelect T="string" Label="@AppStrings.T("Difficulty")" @bind-Value="question.Difficulty" Variant="Variant.Outlined" ReadOnly="@(!isEdit)">
                                <MudSelectItem T="string" Value='@("Easy")'>@AppStrings.Difficulty("Easy")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("Medium")'>@AppStrings.Difficulty("Medium")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("Hard")'>@AppStrings.Difficulty("Hard")</MudSelectItem>
                            </MudSelect>
                        </MudStack>

                        @if (!IsTextQuestion(question.QuestionType))
                        {
                            <MudTextField T="string" Label="@AppStrings.T("MediaUrl")"
                                          @bind-Value="question.MediaUrl"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!isEdit)" />

                            @if (isEdit)
                            {
                                <MudPaper Elevation="0" Class="pa-3" Outlined="true">
                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.subtitle2">
                                            <MudIcon Icon="@MediaIcon" Class="mr-1" />
                                            @(question.QuestionType?.ToUpperInvariant() switch
                                            {
                                                "IMAGE" => AppStrings.T("ImageFile"),
                                                "AUDIO" => AppStrings.T("AudioFile"),
                                                "VIDEO" => AppStrings.T("VideoFile"),
                                                _ => AppStrings.T("MediaUrl")
                                            })
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @(question.QuestionType?.ToUpperInvariant() switch
                                            {
                                                "IMAGE" => AppStrings.T("UploadImageHelp"),
                                                "AUDIO" => AppStrings.T("UploadAudioHelp"),
                                                "VIDEO" => AppStrings.T("UploadVideoHelp"),
                                                _ => string.Empty
                                            })
                                        </MudText>

                                        <InputFile OnChange="OnMediaFileSelected" accept="@MediaAccept" />

                                        @if (selectedMediaFile is not null)
                                        {
                                            <MudText Typo="Typo.caption">
                                                @AppStrings.Tf("SelectedFile", selectedMediaFile.Name, FormatFileSize(selectedMediaFile.Size))
                                            </MudText>
                                        }

                                        @if (isUploadingMedia)
                                        {
                                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                            <MudText Typo="Typo.caption">@AppStrings.T("UploadingMedia")</MudText>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(mediaUploadError))
                                        {
                                            <MudAlert Severity="Severity.Error" Dense="true">@mediaUploadError</MudAlert>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }

                            <MudPaper Elevation="1" Class="pa-3" Outlined="true">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">@AppStrings.T("MediaPreview")</MudText>
                                @if (string.IsNullOrWhiteSpace(question.MediaUrl))
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                        @AppStrings.T("NoMediaUrl")
                                    </MudAlert>
                                }
                                else if (IsImageQuestion(question.QuestionType, question.MediaUrl))
                                {
                                    <img src="@question.MediaUrl"
                                         alt="@AppStrings.T("QuestionMediaPreviewAlt")"
                                         style="max-width: 100%; max-height: 360px; object-fit: contain; border-radius: 8px; display: block;"
                                         @onerror="OnMediaPreviewError" />
                                    @if (mediaPreviewFailed)
                                    {
                                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">
                                            @AppStrings.T("ImageLoadFailed")
                                        </MudAlert>
                                    }
                                }
                                else if (IsAudioQuestion(question.QuestionType, question.MediaUrl))
                                {
                                    <audio controls style="width: 100%;">
                                        <source src="@question.MediaUrl" />
                                        @AppStrings.T("AudioNotSupported")
                                    </audio>
                                }
                                else if (IsVideoQuestion(question.QuestionType, question.MediaUrl))
                                {
                                    <video controls style="width: 100%; max-height: 360px; border-radius: 8px;">
                                        <source src="@question.MediaUrl" />
                                        @AppStrings.T("VideoNotSupported")
                                    </video>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                        @AppStrings.T("PreviewNotAvailable")
                                    </MudAlert>
                                }

                                @if (!string.IsNullOrWhiteSpace(question.MediaUrl))
                                {
                                    <MudLink Href="@question.MediaUrl" Target="_blank" Class="mt-2 d-inline-block">@AppStrings.T("OpenMediaNewTab")</MudLink>
                                }
                            </MudPaper>
                        }

                        <MudText Typo="Typo.h6" Class="mt-4">@AppStrings.T("Answers") (@question.Answers.Count)</MudText>
                        @if (question.Answers.Count == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                @AppStrings.T("NoAnswersFromApi")
                            </MudAlert>
                        }

                        @for (var i = 0; i < question.Answers.Count; i++)
                        {
                            var index = i;
                            var answer = question.Answers[index];
                            var answerKey = answer.Id == Guid.Empty ? $"new-answer-{index}" : answer.Id.ToString();

                            <MudPaper @key="answerKey" Elevation="2" Class="pa-3">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center">
                                        <MudTextField T="string" Label="@AppStrings.AnswerLabel(index + 1)"
                                                      @bind-Value="answer.AnswerText"
                                                      Variant="Variant.Outlined"
                                                      FullWidth="true"
                                                      ReadOnly="@(!isEdit)" />
                                        <MudCheckBox T="bool" @bind-Value="answer.IsPrimary" Label="@AppStrings.T("Primary")" Disabled="@(!isEdit)" />
                                        @if (isEdit)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveAnswer(index))" />
                                        }
                                    </MudStack>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap gap-2">
                                        <MudSwitch T="bool"
                                                   @bind-Value="answer.AllowFuzzyMatch"
                                                   Color="Color.Primary"
                                                   Label="@AppStrings.T("EnableFuzzy")"
                                                   Disabled="@(!isEdit)" />
                                        <MudNumericField T="decimal?"
                                                         @bind-Value="answer.MinConfidence"
                                                         Label="@AppStrings.T("AcceptanceThreshold")"
                                                         Variant="Variant.Outlined"
                                                         Min="0.5m"
                                                         Max="1.0m"
                                                         Step="0.05m"
                                                         Format="P0"
                                                         Disabled="@(!isEdit || !answer.AllowFuzzyMatch)"
                                                         Style="width: 220px;" />
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @AppStrings.T("AcceptanceThresholdHelp")
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        }
                        @if (isEdit)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@AddAnswer">
                                @AppStrings.T("AddAnswer")
                            </MudButton>
                        }

                        <MudText Typo="Typo.h6" Class="mt-4">@AppStrings.T("Hints") (@question.Hints.Count)</MudText>
                        @if (question.Hints.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                @AppStrings.T("NoHints")
                            </MudAlert>
                        }

                        @for (var i = 0; i < question.Hints.Count; i++)
                        {
                            var index = i;
                            var hint = question.Hints[index];
                            var hintKey = hint.Id == Guid.Empty ? $"new-hint-{index}" : hint.Id.ToString();

                            <MudPaper @key="hintKey" Elevation="2" Class="pa-3">
                                <MudStack Row="true" AlignItems="AlignItems.Start" Class="flex-wrap gap-2">
                                    <MudTextField T="string" Label="@AppStrings.Tf("HintNumber", index + 1)"
                                                  @bind-Value="hint.HintText"
                                                  Variant="Variant.Outlined"
                                                  FullWidth="true"
                                                  ReadOnly="@(!isEdit)" />
                                    <MudNumericField T="int"
                                                     @bind-Value="hint.RevealTimeSeconds"
                                                     Label="@AppStrings.T("RevealAtSeconds")"
                                                     Variant="Variant.Outlined"
                                                     Min="0"
                                                     Max="300"
                                                     ReadOnly="@(!isEdit)"
                                                     Style="width: 160px;" />
                                    @if (isEdit)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RemoveHint(index))" />
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                        @if (isEdit)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@AddHint">
                                @AppStrings.T("AddHint")
                            </MudButton>
                        }

                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Elevation="2" Class="pa-3">
                        <MudText Typo="Typo.h6" Class="mb-3">@AppStrings.T("Tags")</MudText>
                        @if (isEdit)
                        {
                            <MudSelect T="string"
                                       Label="@AppStrings.T("SelectTags")"
                                       MultiSelection="true"
                                       SelectedValues="@selectedTagIds"
                                       SelectedValuesChanged="@OnSelectedTagsChanged"
                                       ToStringFunc="@GetTagName"
                                       MultiSelectionTextFunc="@GetSelectedTagsText"
                                       Variant="Variant.Outlined">
                                @foreach (var tag in availableTags)
                                {
                                    <MudSelectItem T="string" Value="@tag.Id.ToString()">@tag.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else if (question.Tags.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@AppStrings.T("NoTags")</MudText>
                        }
                        else
                        {
                            @foreach (var tag in question.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ma-1">@tag.Name</MudChip>
                            }
                        }
                    </MudPaper>

                    <MudPaper Elevation="2" Class="pa-3 mt-3">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@AppStrings.T("CommonInfo")</MudText>
                        <MudText Typo="Typo.caption">@AppStrings.T("Status"): @AppStrings.QuestionStatus(question.Status)</MudText><br />
                        <MudText Typo="Typo.caption">@AppStrings.T("Author"): @(question.AuthorUsername ?? AppStrings.T("CommonSystem"))</MudText><br />
                        <MudText Typo="Typo.caption">@AppStrings.T("CommonCreated"): @question.CreatedAt.ToString("dd/MM/yyyy")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@isSaving" OnClick="@Close">@closeText</MudButton>
        @if (isEdit)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="@Save"
                       Disabled="@isSaving">
                @(isSaving ? AppStrings.T("CommonSaving") : AppStrings.T("CommonSave"))
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid QuestionId { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    private bool isEdit => IsEdit;
    private string title => isEdit ? AppStrings.T("EditQuestion") : AppStrings.T("ViewQuestion");
    private string closeText => isEdit ? AppStrings.T("Cancel") : AppStrings.T("CommonClose");

    private QuestionDto? question;
    private List<TagDto> availableTags = new();
    private IEnumerable<string> selectedTagIds = Array.Empty<string>();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool mediaPreviewFailed = false;
    private bool isUploadingMedia = false;
    private IBrowserFile? selectedMediaFile;
    private string? mediaUploadError;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var loadQuestionTask = QuestionsClient.GetQuestionAsync(QuestionId);
            var loadTagsTask = AdminClient.GetTagsAsync();
            await Task.WhenAll(loadQuestionTask, loadTagsTask);

            question = loadQuestionTask.Result;
            availableTags = loadTagsTask.Result ?? new List<TagDto>();

            if (question == null)
            {
                error = AppStrings.T("QuestionLoadFailed");
                return;
            }

            question.Answers ??= new List<QuestionAnswerDto>();
            question.Hints ??= new List<HintDto>();
            question.Hints = question.Hints.OrderBy(h => h.OrderIndex).ThenBy(h => h.RevealTimeSeconds).ToList();
            question.Tags ??= new List<TagDto>();
            mediaPreviewFailed = false;
            selectedTagIds = question.Tags.Select(t => t.Id.ToString()).ToArray();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Close() => MudDialog.Cancel();

    private void OnSelectedTagsChanged(IEnumerable<string> values)
    {
        selectedTagIds = values?.Where(v => !string.IsNullOrWhiteSpace(v)).ToArray() ?? Array.Empty<string>();
    }

    private string GetSelectedTagsText(List<string> values)
    {
        if (values == null || values.Count == 0)
        {
            return string.Empty;
        }

        var names = values
            .Select(GetTagName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList();

        return names.Count == 0 ? string.Empty : string.Join(", ", names);
    }

    private string GetTagName(string? tagId)
    {
        if (string.IsNullOrWhiteSpace(tagId))
        {
            return string.Empty;
        }

        var tag = availableTags.FirstOrDefault(t => string.Equals(t.Id.ToString(), tagId, StringComparison.OrdinalIgnoreCase))
            ?? question?.Tags.FirstOrDefault(t => string.Equals(t.Id.ToString(), tagId, StringComparison.OrdinalIgnoreCase));

        return string.IsNullOrWhiteSpace(tag?.Name) ? tagId : tag.Name;
    }

    private void AddAnswer()
    {
        question?.Answers.Add(new QuestionAnswerDto
        {
            AnswerText = string.Empty,
            IsPrimary = question.Answers.Count == 0,
            IsActive = true,
            AllowFuzzyMatch = true,
            MinConfidence = 0.75m,
            Aliases = new List<FuzzyAliasDto>()
        });
    }

    private void RemoveAnswer(int index)
    {
        if (question?.Answers.Count > 1 && index >= 0 && index < question.Answers.Count)
        {
            question.Answers.RemoveAt(index);
            if (!question.Answers.Any(a => a.IsPrimary))
            {
                question.Answers[0].IsPrimary = true;
            }
        }
    }

    private void AddHint()
    {
        if (question == null) return;

        var revealTime = question.Hints.Count == 0
            ? 15
            : Math.Min(300, question.Hints.Max(h => h.RevealTimeSeconds) + 15);

        question.Hints.Add(new HintDto
        {
            OrderIndex = question.Hints.Count,
            HintText = string.Empty,
            RevealTimeSeconds = revealTime
        });
    }

    private void RemoveHint(int index)
    {
        if (question == null || index < 0 || index >= question.Hints.Count) return;

        question.Hints.RemoveAt(index);
        for (var i = 0; i < question.Hints.Count; i++)
        {
            question.Hints[i].OrderIndex = i;
        }
    }

    private async Task Save()
    {
        if (question == null) return;
        isSaving = true;
        error = null;

        try
        {
            var answers = question.Answers
                .Where(a => !string.IsNullOrWhiteSpace(a.AnswerText))
                .ToList();

            if (answers.Count == 0)
            {
                error = AppStrings.T("AtLeastOneAnswerRequired");
                return;
            }

            if (!answers.Any(a => a.IsPrimary))
            {
                answers[0].IsPrimary = true;
            }

            var hints = question.Hints
                .Where(h => !string.IsNullOrWhiteSpace(h.HintText))
                .OrderBy(h => h.RevealTimeSeconds)
                .Select((h, index) => new { Hint = h, Index = index })
                .ToList();

            if (hints.Any(h => h.Hint.RevealTimeSeconds < 0 || h.Hint.RevealTimeSeconds > 300))
            {
                error = AppStrings.T("HintRevealTimeRange");
                return;
            }

            var request = new UpdateQuestionFullRequest
            {
                Title = question.Title,
                PromptText = question.PromptText,
                Difficulty = NormalizeDifficulty(question.Difficulty),
                MediaUrl = question.MediaUrl,
                TagIds = selectedTagIds.Select(ParseGuid).Where(id => id.HasValue).Select(id => id!.Value).ToList(),
                Answers = answers.Select(a => new UpdateAnswerRequest
                {
                    Id = a.Id == Guid.Empty ? null : a.Id,
                    AnswerText = a.AnswerText,
                    IsPrimary = a.IsPrimary,
                    AllowFuzzyMatch = a.AllowFuzzyMatch,
                    MaxEditDistance = a.MaxEditDistance,
                    MinConfidence = a.AcceptanceThreshold,
                    Aliases = (a.Aliases ?? new List<FuzzyAliasDto>()).Where(al => !string.IsNullOrWhiteSpace(al.AliasText)).Select(al => new UpdateAliasRequest
                    {
                        Id = al.Id == Guid.Empty ? null : al.Id,
                        AliasText = al.AliasText,
                        Kind = al.Kind
                    }).ToList()
                }).ToList(),
                Hints = hints.Select(h => new UpdateHintRequest
                {
                    Id = h.Hint.Id == Guid.Empty ? null : h.Hint.Id,
                    OrderIndex = h.Index,
                    HintText = h.Hint.HintText?.Trim() ?? string.Empty,
                    RevealTimeSeconds = h.Hint.RevealTimeSeconds
                }).ToList()
            };

            if (isUploadingMedia)
            {
                error = AppStrings.T("WaitMediaUpload");
                return;
            }

            var updated = await QuestionsClient.UpdateQuestionAsync(question.Id, request);
            if (updated == null)
            {
                error = AppStrings.T("QuestionSaveFailedCheckApi");
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var guid) ? guid : null;

    private static string NormalizeDifficulty(string? difficulty) => difficulty?.ToLowerInvariant() switch
    {
        "easy" => "Easy",
        "medium" => "Medium",
        "hard" => "Hard",
        _ => "Medium"
    };

    private async Task OnMediaFileSelected(InputFileChangeEventArgs e)
    {
        if (question == null)
        {
            return;
        }

        selectedMediaFile = e.File;
        mediaUploadError = null;

        if (selectedMediaFile is null)
        {
            return;
        }

        var maxSize = MaxMediaSize;
        if (selectedMediaFile.Size > maxSize)
        {
            mediaUploadError = question.QuestionType?.ToUpperInvariant() switch
            {
                "IMAGE" => AppStrings.T("ImageFileTooLarge"),
                "AUDIO" => AppStrings.T("AudioFileTooLarge"),
                "VIDEO" => AppStrings.T("VideoFileTooLarge"),
                _ => AppStrings.T("MediaUploadFailed")
            };
            Snackbar.Add(mediaUploadError, Severity.Error);
            return;
        }

        try
        {
            isUploadingMedia = true;
            var result = question.QuestionType?.ToUpperInvariant() switch
            {
                "IMAGE" => await MediaClient.UploadImageAsync(selectedMediaFile),
                "AUDIO" => await MediaClient.UploadAudioAsync(selectedMediaFile),
                "VIDEO" => await MediaClient.UploadVideoAsync(selectedMediaFile),
                _ => null
            };

            if (result is null || string.IsNullOrWhiteSpace(result.Url))
            {
                mediaUploadError = AppStrings.T("MediaUploadFailed");
                Snackbar.Add(mediaUploadError, Severity.Error);
                return;
            }

            question.MediaUrl = result.Url;
            mediaPreviewFailed = false;
            Snackbar.Add(AppStrings.T("MediaUploaded"), Severity.Success);
        }
        catch (Exception ex)
        {
            mediaUploadError = AppStrings.Tf("MediaUploadFailedWithError", ex.Message);
            Snackbar.Add(mediaUploadError, Severity.Error);
        }
        finally
        {
            isUploadingMedia = false;
        }
    }

    private string MediaAccept => question?.QuestionType?.ToUpperInvariant() switch
    {
        "IMAGE" => ".jpg,.jpeg,.png,.gif,.webp,image/*",
        "AUDIO" => ".mp3,.wav,.ogg,.m4a,audio/*",
        "VIDEO" => ".mp4,.webm,.ogg,.ogv,.mov,video/*",
        _ => string.Empty
    };

    private string MediaIcon => question?.QuestionType?.ToUpperInvariant() switch
    {
        "IMAGE" => Icons.Material.Filled.Image,
        "AUDIO" => Icons.Material.Filled.AudioFile,
        "VIDEO" => Icons.Material.Filled.Videocam,
        _ => Icons.Material.Filled.AttachFile
    };

    private long MaxMediaSize => question?.QuestionType?.ToUpperInvariant() switch
    {
        "IMAGE" => 10 * 1024 * 1024L,
        "AUDIO" => 20 * 1024 * 1024L,
        "VIDEO" => 50 * 1024 * 1024L,
        _ => 20 * 1024 * 1024L
    };

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d:0.##} MB";
        }

        return $"{bytes / 1024d:0.##} KB";
    }

    private void OnMediaPreviewError()
    {
        mediaPreviewFailed = true;
    }

    private static bool IsTextQuestion(string? questionType) =>
        string.Equals(questionType, "TEXT", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(questionType, "Text", StringComparison.OrdinalIgnoreCase);

    private static bool IsImageQuestion(string? questionType, string? mediaUrl) =>
        string.Equals(questionType, "IMAGE", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(questionType, "Image", StringComparison.OrdinalIgnoreCase) ||
        HasExtension(mediaUrl, ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".svg");

    private static bool IsAudioQuestion(string? questionType, string? mediaUrl) =>
        string.Equals(questionType, "AUDIO", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(questionType, "Audio", StringComparison.OrdinalIgnoreCase) ||
        HasExtension(mediaUrl, ".mp3", ".wav", ".ogg", ".m4a", ".aac", ".flac");

    private static bool IsVideoQuestion(string? questionType, string? mediaUrl) =>
        string.Equals(questionType, "VIDEO", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(questionType, "Video", StringComparison.OrdinalIgnoreCase) ||
        HasExtension(mediaUrl, ".mp4", ".webm", ".ogv", ".mov");

    private static bool HasExtension(string? value, params string[] extensions)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var path = value.Split('?', '#')[0];
        return extensions.Any(ext => path.EndsWith(ext, StringComparison.OrdinalIgnoreCase));
    }
}
