@page "/admin/questions"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Questions
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Moderator,Admin")]
@inject IQuestionsApiClient QuestionsClient
@inject IAdminApiClient AdminClient
@inject IDialogService DialogService

<PageTitle>Questions Management - QuizFuzz</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Quiz" Class="mr-2" />
                Questions Management
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenCreateDialog">
                Create Question
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Class="qf-toolbar pa-4 mb-5">
        <MudStack Row="true" Spacing="2">
            <MudSelect T="string" Label="Status" @bind-Value="filterStatus" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@(null)">All</MudSelectItem>
                <MudSelectItem T="string" Value='@("Draft")'>Draft</MudSelectItem>
                <MudSelectItem T="string" Value='@("UnderReview")'>Under Review</MudSelectItem>
                <MudSelectItem T="string" Value='@("Approved")'>Approved</MudSelectItem>
                <MudSelectItem T="string" Value='@("Rejected")'>Rejected</MudSelectItem>
            </MudSelect>
            
            <MudSelect T="string" Label="Difficulty" @bind-Value="filterDifficulty" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@(null)">All</MudSelectItem>
                <MudSelectItem T="string" Value='@("Easy")'>Easy</MudSelectItem>
                <MudSelectItem T="string" Value='@("Medium")'>Medium</MudSelectItem>
                <MudSelectItem T="string" Value='@("Hard")'>Hard</MudSelectItem>
            </MudSelect>

            <MudButton Variant="Variant.Filled"
                       OnClick="@LoadQuestions">
                Apply Filters
            </MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@LoadQuestions">
                Refresh
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudPaper>
    }
    else if (!questions.Any())
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudText Align="Align.Center" Color="Color.Secondary">No questions found</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="qf-table-panel"><MudTable Items="@questions" Hover="true" Breakpoint="Breakpoint.Sm" Striped="true">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Difficulty</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Author</MudTh>
                <MudTh>Answers</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">
                    <MudStack Spacing="1">
                        <MudText><strong>@context.Title</strong></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(context.PromptText.Length > 60 ? context.PromptText.Substring(0, 60) + "..." : context.PromptText)
                        </MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small">@context.QuestionType</MudChip>
                </MudTd>
                <MudTd DataLabel="Difficulty">
                    <MudChip T="string" Size="Size.Small" Color="@GetDifficultyColor(context.Difficulty)">
                        @context.Difficulty
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Author">
                    <MudText Typo="Typo.caption">@(context.AuthorUsername ?? "System")</MudText>
                </MudTd>
                <MudTd DataLabel="Answers">
                    <MudText>@context.AnswersCount</MudText>
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="@(async () => await ViewQuestion(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(async () => await EditQuestion(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteQuestion(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable></MudPaper>
    }
</MudContainer>

<!-- View/Edit Dialog -->
<MudDialog @bind-IsVisible="@showDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(isEditMode ? "Edit Question" : isCreateMode ? "Create Question" : "View Question")</MudText>
    </TitleContent>
    <DialogContent>
        @if (currentQuestion != null)
        {
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudStack Spacing="3">
                        <MudTextField T="string" Label="Title"
                                      @bind-Value="currentQuestion.Title"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      ReadOnly="@(!isEditMode && !isCreateMode)" />

                        <MudTextField T="string" Label="Question Text"
                                      @bind-Value="currentQuestion.PromptText"
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      ReadOnly="@(!isEditMode && !isCreateMode)" />

                        <MudStack Row="true" Spacing="2">
                            <MudSelect T="string" Label="Type" @bind-Value="currentQuestion.QuestionType" Variant="Variant.Outlined" ReadOnly="@(!isEditMode && !isCreateMode)">
                                <MudSelectItem T="string" Value='@("TEXT")'>Text</MudSelectItem>
                                <MudSelectItem T="string" Value='@("IMAGE")'>Image</MudSelectItem>
                                <MudSelectItem T="string" Value='@("AUDIO")'>Audio</MudSelectItem>
                            </MudSelect>

                            <MudSelect T="string" Label="Difficulty" @bind-Value="currentQuestion.Difficulty" Variant="Variant.Outlined" ReadOnly="@(!isEditMode && !isCreateMode)">
                                <MudSelectItem T="string" Value='@("Easy")'>Easy</MudSelectItem>
                                <MudSelectItem T="string" Value='@("Medium")'>Medium</MudSelectItem>
                                <MudSelectItem T="string" Value='@("Hard")'>Hard</MudSelectItem>
                            </MudSelect>
                        </MudStack>

                        @if (currentQuestion.QuestionType != "TEXT")
                        {
                            <MudTextField T="string" Label="Media URL"
                                          @bind-Value="currentQuestion.MediaUrl"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!isEditMode && !isCreateMode)" />
                        }

                        <MudText Typo="Typo.h6" Class="mt-4">Answers</MudText>
                        @for (var i = 0; i < currentQuestion.Answers.Count; i++)
                        {
                            var index = i;
                            var answer = currentQuestion.Answers[index];
                            var answerKey = answer.Id == Guid.Empty ? $"new-answer-{index}" : answer.Id.ToString();

                            <MudPaper @key="answerKey" Elevation="2" Class="pa-3">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center">
                                        <MudTextField T="string" Label="@($"Answer {index + 1}")"
                                                      @bind-Value="answer.AnswerText"
                                                      Variant="Variant.Outlined"
                                                      FullWidth="true"
                                                      ReadOnly="@(!isEditMode && !isCreateMode)" />
                                        <MudCheckBox T="bool" @bind-Value="answer.IsPrimary" Label="Primary" Disabled="@(!isEditMode && !isCreateMode)" />
                                        @if (isEditMode || isCreateMode)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveAnswer(index))" />
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        }
                        @if (isEditMode || isCreateMode)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@AddAnswer">
                                Add Answer
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Elevation="2" Class="pa-3">
                        <MudText Typo="Typo.h6" Class="mb-3">Tags</MudText>
                        @if (isEditMode || isCreateMode)
                        {
                            <MudSelect T="string" Label="Select Tags" MultiSelection="true" SelectedValues="@selectedTagIds" SelectedValuesChanged="@OnSelectedTagsChanged" Variant="Variant.Outlined">
                                @foreach (var tag in availableTags)
                                {
                                    <MudSelectItem T="string" Value="@tag.Id.ToString()">@tag.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            @foreach (var tag in currentQuestion.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ma-1">@tag.Name</MudChip>
                            }
                        }
                    </MudPaper>

                    @if (!isCreateMode)
                    {
                        <MudPaper Elevation="2" Class="pa-3 mt-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Info</MudText>
                            <MudText Typo="Typo.caption">Status: @currentQuestion.Status</MudText><br/>
                            <MudText Typo="Typo.caption">Author: @(currentQuestion.AuthorUsername ?? "System")</MudText><br/>
                            <MudText Typo="Typo.caption">Created: @currentQuestion.CreatedAt.ToString("dd/MM/yyyy")</MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => showDialog = false)">
            @(isEditMode || isCreateMode ? "Cancel" : "Close")
        </MudButton>
        @if (isEditMode || isCreateMode)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="@SaveQuestion"
                       Disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private List<QuestionDto> questions = new();
    private List<TagDto> availableTags = new();
    private List<TagDto> allTags = new();
    private QuestionDto? currentQuestion;
    private bool isLoading = true;
    private bool showDialog = false;
    private bool isEditMode = false;
    private bool isCreateMode = false;
    private bool isSaving = false;
    private string? filterStatus;
    private string? filterDifficulty;
    private IEnumerable<string> selectedTagIds = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadQuestions(), LoadTags());
    }

    private async Task LoadQuestions()
    {
        isLoading = true;
        questions = await QuestionsClient.GetQuestionsAsync(filterStatus, filterDifficulty);
        isLoading = false;
    }

    private async Task LoadTags()
    {
        availableTags = await AdminClient.GetTagsAsync();
    }

    private void OpenCreateDialog()
    {
        currentQuestion = new QuestionDto
        {
            Title = "",
            PromptText = "",
            QuestionType = "TEXT",
            Difficulty = "MEDIUM",
            Answers = new List<QuestionAnswerDto>
            {
                new() { AnswerText = "", IsPrimary = true, IsActive = true, AllowFuzzyMatch = true }
            },
            Tags = new List<TagDto>()
        };
        selectedTagIds = Array.Empty<string>();
        isCreateMode = true;
        isEditMode = false;
        showDialog = true;
    }

    private async Task ViewQuestion(QuestionDto question)
    {
        var parameters = new DialogParameters
        {
            ["QuestionId"] = question.Id,
            ["IsEdit"] = false
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        var dialog = DialogService.Show<QuestionViewEditDialog>("View Question", parameters, options);
        await dialog.Result;
    }

    private async Task EditQuestion(QuestionDto question)
    {
        var parameters = new DialogParameters
        {
            ["QuestionId"] = question.Id,
            ["IsEdit"] = true
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        var dialog = DialogService.Show<QuestionViewEditDialog>("Edit Question", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadQuestions();
        }
    }

    private async Task DeleteQuestion(QuestionDto question)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Delete question?",
            $"Delete \"{question.Title}\"? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm != true)
            return;

        var success = await QuestionsClient.DeleteQuestionAsync(question.Id);
        if (success)
        {
            await LoadQuestions();
        }
    }

    private void AddAnswer()
    {
        currentQuestion?.Answers.Add(new QuestionAnswerDto
        {
            AnswerText = "",
            IsPrimary = currentQuestion.Answers.Count == 0,
            IsActive = true,
            AllowFuzzyMatch = true
        });
    }

    private void RemoveAnswer(int index)
    {
        if (currentQuestion?.Answers.Count > 1 && index >= 0 && index < currentQuestion.Answers.Count)
        {
            currentQuestion.Answers.RemoveAt(index);
            if (!currentQuestion.Answers.Any(a => a.IsPrimary))
            {
                currentQuestion.Answers[0].IsPrimary = true;
            }
        }
    }

    private void OnSelectedTagsChanged(IEnumerable<string> values)
    {
        selectedTagIds = values?.Where(v => !string.IsNullOrWhiteSpace(v)).ToArray() ?? Array.Empty<string>();
    }

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var guid) ? guid : null;

    private async Task SaveQuestion()
    {
        if (currentQuestion == null) return;

        isSaving = true;

        var answers = currentQuestion.Answers
            .Where(a => !string.IsNullOrWhiteSpace(a.AnswerText))
            .ToList();

        if (answers.Count == 0)
        {
            isSaving = false;
            return;
        }

        if (!answers.Any(a => a.IsPrimary))
        {
            answers[0].IsPrimary = true;
        }

        bool success;
        if (isCreateMode)
        {
            var request = new CreateQuestionRequest
            {
                Title = currentQuestion.Title,
                PromptText = currentQuestion.PromptText,
                QuestionType = currentQuestion.QuestionType,
                Difficulty = currentQuestion.Difficulty,
                MediaUrl = currentQuestion.MediaUrl,
                TagIds = selectedTagIds.Select(ParseGuid).Where(id => id.HasValue).Select(id => id!.Value).ToList(),
                Answers = answers.Select(a => new CreateAnswerRequest
                {
                    AnswerText = a.AnswerText,
                    IsPrimary = a.IsPrimary,
                    AllowFuzzyMatch = a.AllowFuzzyMatch,
                    MaxEditDistance = a.MaxEditDistance,
                    MinConfidence = a.MinConfidence,
                    Aliases = (a.Aliases ?? new List<FuzzyAliasDto>()).Where(al => !string.IsNullOrWhiteSpace(al.AliasText)).Select(al => new CreateAliasRequest
                    {
                        AliasText = al.AliasText,
                        Kind = al.Kind
                    }).ToList()
                }).ToList()
            };

            var result = await QuestionsClient.CreateQuestionAsync(request);
            success = result != null;
        }
        else
        {
            var request = new UpdateQuestionFullRequest
            {
                Title = currentQuestion.Title,
                PromptText = currentQuestion.PromptText,
                Difficulty = currentQuestion.Difficulty,
                MediaUrl = currentQuestion.MediaUrl,
                TagIds = selectedTagIds.Select(ParseGuid).Where(id => id.HasValue).Select(id => id!.Value).ToList(),
                Answers = answers.Select(a => new UpdateAnswerRequest
                {
                    Id = a.Id == Guid.Empty ? null : a.Id,
                    AnswerText = a.AnswerText,
                    IsPrimary = a.IsPrimary,
                    AllowFuzzyMatch = a.AllowFuzzyMatch,
                    MaxEditDistance = a.MaxEditDistance,
                    MinConfidence = a.MinConfidence,
                    Aliases = (a.Aliases ?? new List<FuzzyAliasDto>()).Where(al => !string.IsNullOrWhiteSpace(al.AliasText)).Select(al => new UpdateAliasRequest
                    {
                        Id = al.Id == Guid.Empty ? null : al.Id,
                        AliasText = al.AliasText,
                        Kind = al.Kind
                    }).ToList()
                }).ToList()
            };

            var result = await QuestionsClient.UpdateQuestionAsync(currentQuestion.Id, request);
            success = result != null;
        }

        if (success)
        {
            showDialog = false;
            await LoadQuestions();
        }

        isSaving = false;
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" or "DRAFT" => Color.Default,
        "UnderReview" or "UNDER_REVIEW" => Color.Warning,
        "Approved" or "APPROVED" => Color.Success,
        "Rejected" or "REJECTED" => Color.Error,
        _ => Color.Default
    };

    private Color GetDifficultyColor(string difficulty) => difficulty switch
    {
        "Easy" or "EASY" => Color.Success,
        "Medium" or "MEDIUM" => Color.Warning,
        "Hard" or "HARD" => Color.Error,
        _ => Color.Default
    };
}

