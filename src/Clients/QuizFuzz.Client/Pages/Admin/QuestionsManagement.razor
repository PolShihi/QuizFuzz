@page "/admin/questions"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Questions
@using QuizFuzz.Client.Localization
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Moderator,Admin")]
@inject IQuestionsApiClient QuestionsClient
@inject IAdminApiClient AdminClient
@inject IDialogService DialogService

<PageTitle>@AppStrings.T("QuestionsManagementPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Quiz" Class="mr-2" />
                @AppStrings.T("QuestionsManagementHeading")
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenCreateDialog">
                @AppStrings.T("CreateQuestion")
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Class="qf-toolbar pa-4 mb-5">
        <MudStack Row="true" Spacing="2">
            <MudSelect T="string" Label="@AppStrings.T("FilterStatus")" @bind-Value="filterStatus" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@(null)">@AppStrings.T("CommonAll")</MudSelectItem>
                <MudSelectItem T="string" Value='@("Draft")'>@AppStrings.QuestionStatus("Draft")</MudSelectItem>
                <MudSelectItem T="string" Value='@("UnderReview")'>@AppStrings.QuestionStatus("UnderReview")</MudSelectItem>
                <MudSelectItem T="string" Value='@("Approved")'>@AppStrings.QuestionStatus("Approved")</MudSelectItem>
                <MudSelectItem T="string" Value='@("Rejected")'>@AppStrings.QuestionStatus("Rejected")</MudSelectItem>
            </MudSelect>
            
            <MudSelect T="string" Label="@AppStrings.T("FilterDifficulty")" @bind-Value="filterDifficulty" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@(null)">@AppStrings.T("CommonAll")</MudSelectItem>
                <MudSelectItem T="string" Value='@("Easy")'>@AppStrings.Difficulty("Easy")</MudSelectItem>
                <MudSelectItem T="string" Value='@("Medium")'>@AppStrings.Difficulty("Medium")</MudSelectItem>
                <MudSelectItem T="string" Value='@("Hard")'>@AppStrings.Difficulty("Hard")</MudSelectItem>
            </MudSelect>

            <MudSelect T="string"
                       Label="@AppStrings.T("Tags")"
                       MultiSelection="true"
                       SelectedValues="@selectedFilterTagIds"
                       SelectedValuesChanged="@OnSelectedFilterTagsChanged"
                       ToStringFunc="@GetTagName"
                       MultiSelectionTextFunc="@GetSelectedFilterTagsText"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                @foreach (var tag in availableTags)
                {
                    <MudSelectItem T="string" Value="@tag.Id.ToString()">@tag.Name</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled"
                       OnClick="@LoadQuestions">
                @AppStrings.T("CommonApplyFilters")
            </MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@LoadQuestions">
                @AppStrings.T("CommonRefresh")
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudPaper>
    }
    else if (!questions.Any())
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudText Align="Align.Center" Color="Color.Secondary">@AppStrings.T("NoQuestionsFound")</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="qf-table-panel"><MudTable Items="@questions" Hover="true" Breakpoint="Breakpoint.Sm" Striped="true">
            <HeaderContent>
                <MudTh>@AppStrings.T("Title")</MudTh>
                <MudTh>@AppStrings.T("Type")</MudTh>
                <MudTh>@AppStrings.T("Difficulty")</MudTh>
                <MudTh>@AppStrings.T("Tags")</MudTh>
                <MudTh>@AppStrings.T("Status")</MudTh>
                <MudTh>@AppStrings.T("Author")</MudTh>
                <MudTh>@AppStrings.T("Answers")</MudTh>
                <MudTh>@AppStrings.T("Actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@AppStrings.T("Title")">
                    <MudStack Spacing="1">
                        <MudText><strong>@context.Title</strong></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(context.PromptText.Length > 60 ? context.PromptText.Substring(0, 60) + "..." : context.PromptText)
                        </MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("Type")">
                    <MudChip T="string" Size="Size.Small">@AppStrings.QuestionType(context.QuestionType)</MudChip>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("FilterDifficulty")">
                    <MudChip T="string" Size="Size.Small" Color="@GetDifficultyColor(context.Difficulty)">
                        @AppStrings.QuestionDifficulty(context.Difficulty)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("Tags")">
                    @if (context.Tags.Any())
                    {
                        @foreach (var tag in context.Tags)
                        {
                            <MudChip T="string" Size="Size.Small" Class="ma-1">@tag.Name</MudChip>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("FilterStatus")">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                        @AppStrings.QuestionStatus(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("Author")">
                    <MudText Typo="Typo.caption">@(context.AuthorUsername ?? AppStrings.T("CommonSystem"))</MudText>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("Answers")">
                    <MudText>@context.AnswersCount</MudText>
                </MudTd>
                <MudTd DataLabel="@AppStrings.T("Actions")">
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="@(async () => await ViewQuestion(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(async () => await EditQuestion(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteQuestion(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable></MudPaper>
    }
</MudContainer>

<!-- View/Edit Dialog -->
<MudDialog @bind-IsVisible="@showDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(isEditMode ? AppStrings.T("EditQuestion") : isCreateMode ? AppStrings.T("CreateQuestion") : AppStrings.T("ViewQuestion"))</MudText>
    </TitleContent>
    <DialogContent>
        @if (currentQuestion != null)
        {
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudStack Spacing="3">
                        <MudTextField T="string" Label="@AppStrings.T("Title")"
                                      @bind-Value="currentQuestion.Title"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      ReadOnly="@(!isEditMode && !isCreateMode)" />

                        <MudTextField T="string" Label="@AppStrings.T("QuestionText")"
                                      @bind-Value="currentQuestion.PromptText"
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      ReadOnly="@(!isEditMode && !isCreateMode)" />

                        <MudStack Row="true" Spacing="2">
                            <MudSelect T="string" Label="@AppStrings.T("Type")" @bind-Value="currentQuestion.QuestionType" Variant="Variant.Outlined" ReadOnly="@(!isEditMode && !isCreateMode)">
                                <MudSelectItem T="string" Value='@("TEXT")'>@AppStrings.QuestionType("Text")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("IMAGE")'>@AppStrings.QuestionType("Image")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("AUDIO")'>@AppStrings.QuestionType("Audio")</MudSelectItem>
                            </MudSelect>

                            <MudSelect T="string" Label="@AppStrings.T("FilterDifficulty")" @bind-Value="currentQuestion.Difficulty" Variant="Variant.Outlined" ReadOnly="@(!isEditMode && !isCreateMode)">
                                <MudSelectItem T="string" Value='@("Easy")'>@AppStrings.Difficulty("Easy")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("Medium")'>@AppStrings.Difficulty("Medium")</MudSelectItem>
                                <MudSelectItem T="string" Value='@("Hard")'>@AppStrings.Difficulty("Hard")</MudSelectItem>
                            </MudSelect>
                        </MudStack>

                        @if (currentQuestion.QuestionType != "TEXT")
                        {
                            <MudTextField T="string" Label="@AppStrings.T("MediaUrl")"
                                          @bind-Value="currentQuestion.MediaUrl"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!isEditMode && !isCreateMode)" />
                        }

                        <MudText Typo="Typo.h6" Class="mt-4">@AppStrings.T("Answers")</MudText>
                        @for (var i = 0; i < currentQuestion.Answers.Count; i++)
                        {
                            var index = i;
                            var answer = currentQuestion.Answers[index];
                            var answerKey = answer.Id == Guid.Empty ? $"new-answer-{index}" : answer.Id.ToString();

                            <MudPaper @key="answerKey" Elevation="2" Class="pa-3">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center">
                                        <MudTextField T="string" Label="@AppStrings.AnswerLabel(index + 1)"
                                                      @bind-Value="answer.AnswerText"
                                                      Variant="Variant.Outlined"
                                                      FullWidth="true"
                                                      ReadOnly="@(!isEditMode && !isCreateMode)" />
                                        <MudCheckBox T="bool" @bind-Value="answer.IsPrimary" Label="@AppStrings.T("Primary")" Disabled="@(!isEditMode && !isCreateMode)" />
                                        @if (isEditMode || isCreateMode)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveAnswer(index))" />
                                        }
                                    </MudStack>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap gap-2">
                                        <MudSwitch T="bool"
                                                   @bind-Value="answer.AllowFuzzyMatch"
                                                   Color="Color.Primary"
                                                   Label="@AppStrings.T("EnableFuzzy")"
                                                   Disabled="@(!isEditMode && !isCreateMode)" />
                                        <MudNumericField T="decimal?"
                                                         @bind-Value="answer.MinConfidence"
                                                         Label="@AppStrings.T("AcceptanceThreshold")"
                                                         Variant="Variant.Outlined"
                                                         Min="0.5m"
                                                         Max="1.0m"
                                                         Step="0.05m"
                                                         Format="P0"
                                                         Disabled="@((!isEditMode && !isCreateMode) || !answer.AllowFuzzyMatch)"
                                                         Style="width: 220px;" />
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @AppStrings.T("AcceptanceThresholdHelp")
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        }
                        @if (isEditMode || isCreateMode)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@AddAnswer">
                                @AppStrings.T("AddAnswer")
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Elevation="2" Class="pa-3">
                        <MudText Typo="Typo.h6" Class="mb-3">@AppStrings.T("Tags")</MudText>
                        @if (isEditMode || isCreateMode)
                        {
                            <MudSelect T="string"
                                       Label="@AppStrings.T("SelectTags")"
                                       MultiSelection="true"
                                       SelectedValues="@selectedTagIds"
                                       SelectedValuesChanged="@OnSelectedTagsChanged"
                                       ToStringFunc="@GetTagName"
                                       MultiSelectionTextFunc="@GetSelectedTagsText"
                                       Variant="Variant.Outlined">
                                @foreach (var tag in availableTags)
                                {
                                    <MudSelectItem T="string" Value="@tag.Id.ToString()">@tag.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            @foreach (var tag in currentQuestion.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ma-1">@tag.Name</MudChip>
                            }
                        }
                    </MudPaper>

                    @if (!isCreateMode)
                    {
                        <MudPaper Elevation="2" Class="pa-3 mt-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@AppStrings.T("CommonInfo")</MudText>
                            <MudText Typo="Typo.caption">@AppStrings.T("Status"): @AppStrings.QuestionStatus(currentQuestion.Status)</MudText><br/>
                            <MudText Typo="Typo.caption">@AppStrings.T("Author"): @(currentQuestion.AuthorUsername ?? AppStrings.T("CommonSystem"))</MudText><br/>
                            <MudText Typo="Typo.caption">@AppStrings.T("CommonCreated"): @currentQuestion.CreatedAt.ToString("dd/MM/yyyy")</MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => showDialog = false)">
            @(isEditMode || isCreateMode ? AppStrings.T("Cancel") : AppStrings.T("CommonClose"))
        </MudButton>
        @if (isEditMode || isCreateMode)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="@SaveQuestion"
                       Disabled="@isSaving">
                @(isSaving ? AppStrings.T("CommonSaving") : AppStrings.T("CommonSave"))
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private List<QuestionDto> questions = new();
    private List<TagDto> availableTags = new();
    private List<TagDto> allTags = new();
    private QuestionDto? currentQuestion;
    private bool isLoading = true;
    private bool showDialog = false;
    private bool isEditMode = false;
    private bool isCreateMode = false;
    private bool isSaving = false;
    private string? filterStatus;
    private string? filterDifficulty;
    private IEnumerable<string> selectedFilterTagIds = Array.Empty<string>();
    private IEnumerable<string> selectedTagIds = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadQuestions(), LoadTags());
    }

    private async Task LoadQuestions()
    {
        isLoading = true;
        var tagIds = selectedFilterTagIds
            .Select(ParseGuid)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToList();

        questions = await QuestionsClient.GetQuestionsAsync(filterStatus, filterDifficulty, tagIds);
        isLoading = false;
    }

    private async Task LoadTags()
    {
        availableTags = await AdminClient.GetTagsAsync();
    }

    private void OpenCreateDialog()
    {
        currentQuestion = new QuestionDto
        {
            Title = "",
            PromptText = "",
            QuestionType = "TEXT",
            Difficulty = "MEDIUM",
            Answers = new List<QuestionAnswerDto>
            {
                new() { AnswerText = "", IsPrimary = true, IsActive = true, AllowFuzzyMatch = true, MinConfidence = 0.75m }
            },
            Tags = new List<TagDto>()
        };
        selectedTagIds = Array.Empty<string>();
        isCreateMode = true;
        isEditMode = false;
        showDialog = true;
    }

    private async Task ViewQuestion(QuestionDto question)
    {
        var parameters = new DialogParameters
        {
            ["QuestionId"] = question.Id,
            ["IsEdit"] = false
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        var dialog = DialogService.Show<QuestionViewEditDialog>(AppStrings.T("ViewQuestion"), parameters, options);
        await dialog.Result;
    }

    private async Task EditQuestion(QuestionDto question)
    {
        var parameters = new DialogParameters
        {
            ["QuestionId"] = question.Id,
            ["IsEdit"] = true
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        var dialog = DialogService.Show<QuestionViewEditDialog>(AppStrings.T("EditQuestion"), parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadQuestions();
        }
    }

    private async Task DeleteQuestion(QuestionDto question)
    {
        var confirm = await DialogService.ShowMessageBox(
            AppStrings.T("DeleteQuestionTitle"),
            AppStrings.Tf("DeleteQuestionMessage", question.Title),
            yesText: AppStrings.T("CommonDelete"),
            cancelText: AppStrings.T("Cancel"));

        if (confirm != true)
            return;

        var success = await QuestionsClient.DeleteQuestionAsync(question.Id);
        if (success)
        {
            await LoadQuestions();
        }
    }

    private void AddAnswer()
    {
        currentQuestion?.Answers.Add(new QuestionAnswerDto
        {
            AnswerText = "",
            IsPrimary = currentQuestion.Answers.Count == 0,
            IsActive = true,
            AllowFuzzyMatch = true,
            MinConfidence = 0.75m
        });
    }

    private void RemoveAnswer(int index)
    {
        if (currentQuestion?.Answers.Count > 1 && index >= 0 && index < currentQuestion.Answers.Count)
        {
            currentQuestion.Answers.RemoveAt(index);
            if (!currentQuestion.Answers.Any(a => a.IsPrimary))
            {
                currentQuestion.Answers[0].IsPrimary = true;
            }
        }
    }

    private void OnSelectedFilterTagsChanged(IEnumerable<string> values)
    {
        selectedFilterTagIds = values?.Where(v => !string.IsNullOrWhiteSpace(v)).ToArray() ?? Array.Empty<string>();
    }

    private void OnSelectedTagsChanged(IEnumerable<string> values)
    {
        selectedTagIds = values?.Where(v => !string.IsNullOrWhiteSpace(v)).ToArray() ?? Array.Empty<string>();
    }

    private string GetSelectedFilterTagsText(List<string> values) => GetSelectedTagsDisplayText(values);

    private string GetSelectedTagsText(List<string> values) => GetSelectedTagsDisplayText(values);

    private string GetSelectedTagsDisplayText(IReadOnlyCollection<string>? values)
    {
        if (values == null || values.Count == 0)
        {
            return string.Empty;
        }

        var names = values
            .Select(GetTagName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList();

        return names.Count == 0 ? string.Empty : string.Join(", ", names);
    }

    private string GetTagName(string? tagId)
    {
        if (string.IsNullOrWhiteSpace(tagId))
        {
            return string.Empty;
        }

        var tag = availableTags.FirstOrDefault(t => t.Id.ToString() == tagId);
        return tag?.Name ?? tagId;
    }

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var guid) ? guid : null;

    private async Task SaveQuestion()
    {
        if (currentQuestion == null) return;

        isSaving = true;

        var answers = currentQuestion.Answers
            .Where(a => !string.IsNullOrWhiteSpace(a.AnswerText))
            .ToList();

        if (answers.Count == 0)
        {
            isSaving = false;
            return;
        }

        if (!answers.Any(a => a.IsPrimary))
        {
            answers[0].IsPrimary = true;
        }

        bool success;
        if (isCreateMode)
        {
            var request = new CreateQuestionRequest
            {
                Title = currentQuestion.Title,
                PromptText = currentQuestion.PromptText,
                QuestionType = currentQuestion.QuestionType,
                Difficulty = currentQuestion.Difficulty,
                MediaUrl = currentQuestion.MediaUrl,
                TagIds = selectedTagIds.Select(ParseGuid).Where(id => id.HasValue).Select(id => id!.Value).ToList(),
                Answers = answers.Select(a => new CreateAnswerRequest
                {
                    AnswerText = a.AnswerText,
                    IsPrimary = a.IsPrimary,
                    AllowFuzzyMatch = a.AllowFuzzyMatch,
                    MaxEditDistance = a.MaxEditDistance,
                    MinConfidence = a.AcceptanceThreshold,
                    Aliases = (a.Aliases ?? new List<FuzzyAliasDto>()).Where(al => !string.IsNullOrWhiteSpace(al.AliasText)).Select(al => new CreateAliasRequest
                    {
                        AliasText = al.AliasText,
                        Kind = al.Kind
                    }).ToList()
                }).ToList()
            };

            var result = await QuestionsClient.CreateQuestionAsync(request);
            success = result != null;
        }
        else
        {
            var request = new UpdateQuestionFullRequest
            {
                Title = currentQuestion.Title,
                PromptText = currentQuestion.PromptText,
                Difficulty = currentQuestion.Difficulty,
                MediaUrl = currentQuestion.MediaUrl,
                TagIds = selectedTagIds.Select(ParseGuid).Where(id => id.HasValue).Select(id => id!.Value).ToList(),
                Answers = answers.Select(a => new UpdateAnswerRequest
                {
                    Id = a.Id == Guid.Empty ? null : a.Id,
                    AnswerText = a.AnswerText,
                    IsPrimary = a.IsPrimary,
                    AllowFuzzyMatch = a.AllowFuzzyMatch,
                    MaxEditDistance = a.MaxEditDistance,
                    MinConfidence = a.AcceptanceThreshold,
                    Aliases = (a.Aliases ?? new List<FuzzyAliasDto>()).Where(al => !string.IsNullOrWhiteSpace(al.AliasText)).Select(al => new UpdateAliasRequest
                    {
                        Id = al.Id == Guid.Empty ? null : al.Id,
                        AliasText = al.AliasText,
                        Kind = al.Kind
                    }).ToList()
                }).ToList()
            };

            var result = await QuestionsClient.UpdateQuestionAsync(currentQuestion.Id, request);
            success = result != null;
        }

        if (success)
        {
            showDialog = false;
            await LoadQuestions();
        }

        isSaving = false;
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" or "DRAFT" => Color.Default,
        "UnderReview" or "UNDER_REVIEW" => Color.Warning,
        "Approved" or "APPROVED" => Color.Success,
        "Rejected" or "REJECTED" => Color.Error,
        _ => Color.Default
    };

    private Color GetDifficultyColor(string difficulty) => difficulty switch
    {
        "Easy" or "EASY" => Color.Success,
        "Medium" or "MEDIUM" => Color.Warning,
        "Hard" or "HARD" => Color.Error,
        _ => Color.Default
    };
}

