@page "/suggest-question"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Questions
@using QuizFuzz.Shared.Dtos.Moderation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using QuizFuzz.Shared.Enums
@attribute [Authorize]
@inject IQuestionsApiClient QuestionsClient
@inject ITagsApiClient TagsClient
@inject IMediaApiClient MediaClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<SuggestQuestion> Logger

<PageTitle>Suggest a Question - QuizFuzz</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Class="mr-2" />
            Suggest a Question
        </MudText>

        <MudText Color="Color.Info" Class="mb-6">
            Submit your question for moderation. Once approved, it will be available in the game!
        </MudText>

        @if (isSubmitting)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
        }

        <MudForm @ref="form" @bind-IsValid="@isValid">
            <MudGrid>
                <!-- Title -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="title"
                                  Label="Title (Optional)"
                                  Variant="Variant.Outlined"
                                  HelperText="Short descriptive title for your question" />
                </MudItem>

                <!-- Question Text -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="promptText"
                                  Label="Question Text"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Required="true"
                                  RequiredError="Question text is required"
                                  HelperText="Enter your question here" />
                </MudItem>

                <!-- Type -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Value="@questionType"
                               ValueChanged="@OnQuestionTypeChanged"
                               Label="Question Type"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem T="string" Value="@("Text")">Text</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Image")">Image</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Audio")">Audio</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Difficulty -->
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="difficulty"
                               Label="Difficulty"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem Value="@("Easy")">Easy</MudSelectItem>
                        <MudSelectItem Value="@("Medium")">Medium</MudSelectItem>
                        <MudSelectItem Value="@("Hard")">Hard</MudSelectItem>
                        <MudSelectItem Value="@("Expert")">Expert</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (RequiresMedia)
                {
                    <MudItem xs="12">
                        <MudPaper Class="pa-4" Outlined="true">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">
                                    <MudIcon Icon="@MediaIcon" Class="mr-2" />
                                    @(questionType == "Image" ? "Image file" : "Audio file")
                                </MudText>

                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @(questionType == "Image"
                                        ? "Upload JPG, PNG, GIF or WEBP up to 10 MB."
                                        : "Upload MP3, WAV, OGG or M4A up to 20 MB.")
                                </MudText>

                                <InputFile OnChange="OnMediaFileSelected" accept="@MediaAccept" />

                                @if (selectedMediaFile is not null)
                                {
                                    <MudText Typo="Typo.caption">
                                        Selected: @selectedMediaFile.Name (@FormatFileSize(selectedMediaFile.Size))
                                    </MudText>
                                }

                                @if (isUploadingMedia)
                                {
                                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                    <MudText Typo="Typo.caption">Uploading media...</MudText>
                                }

                                @if (!string.IsNullOrWhiteSpace(mediaUploadError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">@mediaUploadError</MudAlert>
                                }

                                @if (!string.IsNullOrWhiteSpace(uploadedMediaUrl))
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true">Media uploaded successfully.</MudAlert>

                                    @if (questionType == "Image")
                                    {
                                        <MudImage Src="@uploadedMediaUrl" Alt="Uploaded question image preview" Class="rounded-lg" Style="max-height: 240px; max-width: 100%; object-fit: contain;" />
                                    }
                                    else if (questionType == "Audio")
                                    {
                                        <audio controls style="width: 100%;">
                                            <source src="@uploadedMediaUrl" />
                                            Your browser does not support the audio element.
                                        </audio>
                                    }
                                }
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }

                <!-- Correct Answers -->
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-2">Correct Answers</MudText>
                    @for (int i = 0; i < correctAnswers.Count; i++)
                    {
                        var index = i;
                        var answer = correctAnswers[index];
                        
                        <MudStack Class="mb-3" @key="@index">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudTextField @bind-Value="answer.Text"
                                              Label="Answer"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              Style="flex-grow: 1;" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveAnswerAtIndex(index))"
                                               Disabled="@(correctAnswers.Count <= 1)" />
                            </MudStack>
                            
                            <!-- Fuzzy Matching Settings -->
                            <MudPaper Class="pa-3 mt-2" Outlined="true">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">⚙️ Fuzzy Matching Settings</MudText>
                                <MudStack Spacing="2">
                                    <MudSwitch T="bool"
                                               @bind-Value="answer.AllowFuzzyMatch"
                                               Color="Color.Primary"
                                               Label="Enable Fuzzy Matching" />
                                    
                                    @if (answer.AllowFuzzyMatch)
                                    {
                                        <MudStack>
                                            <MudText Typo="Typo.caption">
                                                Min Confidence: @answer.MinConfidence.ToString("P0")
                                            </MudText>
                                            <MudSlider T="double"
                                                       @bind-Value="answer.MinConfidence"
                                                       Min="0.0"
                                                       Max="1.0"
                                                       Step="0.05"
                                                       Color="Color.Info" />
                                            
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @GetConfidenceDescription(answer.MinConfidence)
                                            </MudText>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudStack>
                    }
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddAnswer"
                               Class="mt-2">
                        Add Answer
                    </MudButton>
                </MudItem>

                <!-- Tags -->
                <MudItem xs="12">
                    <MudSelect T="string"
                               @bind-SelectedValues="selectedTagIds"
                               Label="Tags"
                               Variant="Variant.Outlined"
                               MultiSelection="true"
                               ToStringFunc="@GetTagName"
                               MultiSelectionTextFunc="@GetSelectedTagsText"
                               HelperText="Select relevant tags for your question">
                        @foreach (var tag in availableTags)
                        {
                            <MudSelectItem T="string" Value="@tag.Id.ToString()">@tag.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Suggest Tag -->
                <MudItem xs="12">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">
                                <MudIcon Icon="@Icons.Material.Filled.NewLabel" Class="mr-1" />
                                Missing a tag?
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Suggest a new tag. It will appear for moderators/admins in Tags Management and can be approved later.
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Start" Class="flex-wrap gap-2">
                                <MudTextField @bind-Value="suggestedTagName"
                                              Label="New tag name"
                                              Variant="Variant.Outlined"
                                              Immediate="true"
                                              Style="min-width: 220px; flex-grow: 1;" />
                                <MudTextField @bind-Value="suggestedTagDescription"
                                              Label="Description"
                                              Variant="Variant.Outlined"
                                              Style="min-width: 260px; flex-grow: 2;" />
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Send"
                                           Disabled="@(isSuggestingTag || string.IsNullOrWhiteSpace(suggestedTagName))"
                                           OnClick="@SuggestTag">
                                    Suggest Tag
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <!-- Explanation -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="explanation"
                                  Label="Explanation (Optional)"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  HelperText="Provide additional context or explanation for the answer" />
                </MudItem>

                <!-- Submit Button -->
                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                        <MudButton Variant="Variant.Outlined"
                                   OnClick="@(() => Navigation.NavigateTo("/lobby"))">
                            Cancel
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!isValid || isSubmitting)"
                                   OnClick="SubmitQuestion">
                            @if (isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ml-2">Submitting...</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" />
                                <MudText>Submit for Review</MudText>
                            }
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm form = null!;
    private bool isValid;
    private bool isSubmitting;
    private bool isSuggestingTag;

    private string title = string.Empty;
    private string promptText = string.Empty;
    private string questionType = "Text";
    private string difficulty = "Medium";
    private string explanation = string.Empty;
    private string suggestedTagName = string.Empty;
    private string suggestedTagDescription = string.Empty;
    private IBrowserFile? selectedMediaFile;
    private string? uploadedMediaUrl;
    private string? mediaUploadError;

    private bool isUploadingMedia;
    private List<AnswerItem> correctAnswers = new() { new AnswerItem() };
    private IEnumerable<string> selectedTagIds = new HashSet<string>();
    private List<QuizFuzz.Shared.Dtos.Questions.TagDto> availableTags = new();

    private bool RequiresMedia => questionType is "Image" or "Audio";
    private string MediaAccept => questionType == "Image"
        ? ".jpg,.jpeg,.png,.gif,.webp,image/*"
        : ".mp3,.wav,.ogg,.m4a,audio/*";
    private string MediaIcon => questionType == "Image"
        ? Icons.Material.Filled.Image
        : Icons.Material.Filled.AudioFile;

    private class AnswerItem
    {
        public string Text { get; set; } = string.Empty;
        public bool AllowFuzzyMatch { get; set; } = true;
        public double MinConfidence { get; set; } = 0.7;
    }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("💡 [SuggestQuestion] Page initialized");
        await LoadTags();
    }

    private async Task LoadTags()
    {
        try
        {
            Logger.LogInformation("🏷️ [SuggestQuestion] Loading tags...");
            availableTags = await TagsClient.GetAllTagsAsync();
            Logger.LogInformation("✅ [SuggestQuestion] Loaded {Count} tags", availableTags.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ [SuggestQuestion] Error loading tags");
            Snackbar.Add($"Error loading tags: {ex.Message}", Severity.Error);
        }
    }

    private Task OnQuestionTypeChanged(string value)
    {
        if (questionType != value)
        {
            questionType = value;
            selectedMediaFile = null;
            uploadedMediaUrl = null;
            mediaUploadError = null;
        }

        return Task.CompletedTask;
    }

    private async Task OnMediaFileSelected(InputFileChangeEventArgs e)
    {
        selectedMediaFile = e.File;
        uploadedMediaUrl = null;
        mediaUploadError = null;

        if (selectedMediaFile is null)
            return;

        var maxSize = questionType == "Image" ? 10 * 1024 * 1024L : 20 * 1024 * 1024L;
        if (selectedMediaFile.Size > maxSize)
        {
            mediaUploadError = questionType == "Image"
                ? "Image file size must not exceed 10 MB."
                : "Audio file size must not exceed 20 MB.";
            Snackbar.Add(mediaUploadError, Severity.Error);
            return;
        }

        try
        {
            isUploadingMedia = true;
            var result = questionType == "Image"
                ? await MediaClient.UploadImageAsync(selectedMediaFile)
                : await MediaClient.UploadAudioAsync(selectedMediaFile);

            if (result is null || string.IsNullOrWhiteSpace(result.Url))
            {
                mediaUploadError = "Media upload failed. Please try another file.";
                Snackbar.Add(mediaUploadError, Severity.Error);
                return;
            }

            uploadedMediaUrl = result.Url;
            Snackbar.Add("Media uploaded successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ [SuggestQuestion] Error uploading media");
            mediaUploadError = $"Media upload failed: {ex.Message}";
            Snackbar.Add(mediaUploadError, Severity.Error);
        }
        finally
        {
            isUploadingMedia = false;
        }
    }

    private string GetTagName(string? tagId)
    {
        if (string.IsNullOrWhiteSpace(tagId))
            return string.Empty;

        var tag = availableTags.FirstOrDefault(t => t.Id.ToString() == tagId);
        return tag?.Name ?? tagId;
    }

    private string GetSelectedTagsText(List<string> selectedValues)
    {
        if (selectedValues.Count == 0)
            return string.Empty;

        return string.Join(", ", selectedValues.Select(GetTagName));
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024d / 1024d:0.##} MB";

        return $"{bytes / 1024d:0.##} KB";
    }

    private string GetConfidenceDescription(double confidence)
    {
        return confidence switch
        {
            >= 0.9 => "Very strict - only near-exact matches",
            >= 0.8 => "Strict - minor typos allowed",
            >= 0.7 => "Moderate - common typos and variations",
            >= 0.6 => "Lenient - more variations allowed",
            _ => "Very lenient - accepts many variations"
        };
    }

    private void AddAnswer()
    {
        correctAnswers.Add(new AnswerItem());
        StateHasChanged();
    }

    private void RemoveAnswerAtIndex(int index)
    {
        if (correctAnswers.Count > 1 && index >= 0 && index < correctAnswers.Count)
        {
            correctAnswers.RemoveAt(index);
            StateHasChanged();
        }
    }



    private async Task SuggestTag()
    {
        if (isSuggestingTag)
            return;

        if (string.IsNullOrWhiteSpace(suggestedTagName))
        {
            Snackbar.Add("Enter a tag name first.", Severity.Warning);
            return;
        }

        try
        {
            isSuggestingTag = true;
            var suggested = await TagsClient.SuggestTagAsync(suggestedTagName, suggestedTagDescription);
            if (suggested == null)
            {
                Snackbar.Add("Failed to suggest tag. It may already exist or be pending review.", Severity.Error);
                return;
            }

            Snackbar.Add($"Tag '{suggested.Name}' suggested for moderation.", Severity.Success);
            suggestedTagName = string.Empty;
            suggestedTagDescription = string.Empty;
            await LoadTags();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ [SuggestQuestion] Error suggesting tag");
            Snackbar.Add($"Error suggesting tag: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSuggestingTag = false;
        }
    }

    private async Task SubmitQuestion()
    {
        Logger.LogInformation("📤 [SuggestQuestion] Starting question submission");
        
        await form.Validate();
        if (!isValid)
        {
            Logger.LogWarning("⚠️ [SuggestQuestion] Form validation failed");
            Snackbar.Add("Please fill in all required fields", Severity.Warning);
            return;
        }

        if (correctAnswers.All(a => string.IsNullOrWhiteSpace(a.Text)))
        {
            Logger.LogWarning("⚠️ [SuggestQuestion] No correct answers provided");
            Snackbar.Add("Please provide at least one correct answer", Severity.Warning);
            return;
        }

        if (RequiresMedia && string.IsNullOrWhiteSpace(uploadedMediaUrl))
        {
            Snackbar.Add(questionType == "Image"
                ? "Please upload an image file for this question."
                : "Please upload an audio file for this question.", Severity.Warning);
            return;
        }

        isSubmitting = true;

        try
        {
            Logger.LogInformation("🔧 [SuggestQuestion] Building request - Type: {Type}, Difficulty: {Difficulty}, Answers: {Count}", 
                questionType, difficulty, correctAnswers.Count);

            var request = new SuggestQuestionRequest
            {
                Title = string.IsNullOrWhiteSpace(title) ? null : title,
                PromptText = promptText,
                Type = Enum.Parse<QuestionType>(questionType),
                Difficulty = Enum.Parse<Difficulty>(difficulty),
                CorrectAnswers = correctAnswers
                    .Where(a => !string.IsNullOrWhiteSpace(a.Text))
                    .Select(a => new AnswerWithSettings 
                    { 
                        Text = a.Text,
                        AllowFuzzyMatch = a.AllowFuzzyMatch,
                        MinConfidence = a.MinConfidence
                    })
                    .ToList(),
                TagIds = selectedTagIds
                    .Select(id => Guid.TryParse(id, out var parsed) ? parsed : Guid.Empty)
                    .Where(id => id != Guid.Empty)
                    .ToList(),
                MediaUrl = RequiresMedia ? uploadedMediaUrl : null,
                Explanation = string.IsNullOrWhiteSpace(explanation) ? null : explanation
            };

            Logger.LogInformation("📡 [SuggestQuestion] Sending request to API...");
            var success = await QuestionsClient.SuggestQuestionAsync(request);

            if (success)
            {
                Logger.LogInformation("✅ [SuggestQuestion] Question submitted successfully!");
                Snackbar.Add("Question submitted successfully! It will be reviewed by moderators.", Severity.Success);
                Navigation.NavigateTo("/lobby");
            }
            else
            {
                Logger.LogError("❌ [SuggestQuestion] API returned failure");
                Snackbar.Add("Failed to submit question. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "💥 [SuggestQuestion] Exception during submission");
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            Logger.LogInformation("🏁 [SuggestQuestion] Submission process completed");
        }
    }
}
