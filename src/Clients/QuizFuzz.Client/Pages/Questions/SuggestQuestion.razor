@page "/suggest-question"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Questions
@using QuizFuzz.Shared.Dtos.Moderation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using QuizFuzz.Shared.Enums
@using QuizFuzz.Client.Localization
@attribute [Authorize]
@inject IQuestionsApiClient QuestionsClient
@inject ITagsApiClient TagsClient
@inject IMediaApiClient MediaClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<SuggestQuestion> Logger

<PageTitle>@AppStrings.T("SuggestQuestionPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Class="qf-page-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" Class="qf-section-title">@AppStrings.T("SuggestQuestionHeading")</MudText>
                <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("SuggestQuestionDescription")</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Class="qf-panel pa-6">

        @if (isSubmitting)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
        }

        @if (validationErrors.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@AppStrings.T("FixErrors")</MudText>
                <ul class="mb-0">
                    @foreach (var error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </MudAlert>
        }

        <MudForm @ref="form" @bind-IsValid="@isValid">
            <MudGrid>
                <!-- Title -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="title"
                                  Label="@AppStrings.T("QuestionTitleOptional")"
                                  Variant="Variant.Outlined"
                                  MaxLength="100"
                                  Counter="100"
                                  Immediate="true"
                                  HelperText="@AppStrings.T("QuestionTitleHelper")" />
                </MudItem>

                <!-- Question Text -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="promptText"
                                  Label="@AppStrings.T("QuestionText")"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Required="true"
                                  RequiredError="@AppStrings.T("QuestionTextRequired")"
                                  MaxLength="2000"
                                  Counter="2000"
                                  Immediate="true"
                                  HelperText="@AppStrings.T("QuestionTextHelper")" />
                </MudItem>

                <!-- Type -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Value="@questionType"
                               ValueChanged="@OnQuestionTypeChanged"
                               Label="@AppStrings.T("QuestionType")"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem T="string" Value="@("Text")">@AppStrings.QuestionType("Text")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Image")">@AppStrings.QuestionType("Image")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Audio")">@AppStrings.QuestionType("Audio")</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Difficulty -->
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="difficulty"
                               Label="@AppStrings.T("Difficulty")"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem Value="@("Easy")">@AppStrings.Difficulty("Easy")</MudSelectItem>
                        <MudSelectItem Value="@("Medium")">@AppStrings.Difficulty("Medium")</MudSelectItem>
                        <MudSelectItem Value="@("Hard")">@AppStrings.Difficulty("Hard")</MudSelectItem>
                        <MudSelectItem Value="@("Expert")">@AppStrings.Difficulty("Expert")</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (RequiresMedia)
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="qf-form-section">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">
                                    <MudIcon Icon="@MediaIcon" Class="mr-2" />
                                    @(questionType == "Image" ? AppStrings.T("ImageFile") : AppStrings.T("AudioFile"))
                                </MudText>

                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @(questionType == "Image"
                                        ? AppStrings.T("UploadImageHelp")
                                        : AppStrings.T("UploadAudioHelp"))
                                </MudText>

                                <InputFile OnChange="OnMediaFileSelected" accept="@MediaAccept" />

                                @if (selectedMediaFile is not null)
                                {
                                    <MudText Typo="Typo.caption">
                                        @AppStrings.Tf("SelectedFile", selectedMediaFile.Name, FormatFileSize(selectedMediaFile.Size))
                                    </MudText>
                                }

                                @if (isUploadingMedia)
                                {
                                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                    <MudText Typo="Typo.caption">@AppStrings.T("UploadingMedia")</MudText>
                                }

                                @if (!string.IsNullOrWhiteSpace(mediaUploadError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">@mediaUploadError</MudAlert>
                                }

                                @if (!string.IsNullOrWhiteSpace(uploadedMediaUrl))
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true">@AppStrings.T("MediaUploaded")</MudAlert>

                                    @if (questionType == "Image")
                                    {
                                        <MudImage Src="@uploadedMediaUrl" Alt="@AppStrings.T("UploadedImagePreviewAlt")" Class="rounded-lg" Style="max-height: 240px; max-width: 100%; object-fit: contain;" />
                                    }
                                    else if (questionType == "Audio")
                                    {
                                        <audio controls style="width: 100%;">
                                            <source src="@uploadedMediaUrl" />
                                            @AppStrings.T("AudioElementNotSupported")
                                        </audio>
                                    }
                                }
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }

                <!-- Correct Answers -->
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-2">@AppStrings.T("CorrectAnswers")</MudText>
                    @for (int i = 0; i < correctAnswers.Count; i++)
                    {
                        var index = i;
                        var answer = correctAnswers[index];
                        
                        <MudStack Class="mb-3" @key="@index">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudTextField @bind-Value="answer.Text"
                                              Label="@AppStrings.T("Answer")"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="@AppStrings.T("AnswerRequired")"
                                              MaxLength="200"
                                              Counter="200"
                                              Immediate="true"
                                              Style="flex-grow: 1;" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveAnswerAtIndex(index))"
                                               Disabled="@(correctAnswers.Count <= 1)" />
                            </MudStack>
                            
                            <!-- Fuzzy Matching Settings -->
                            <MudPaper Elevation="0" Class="qf-form-section mt-2">
                                <MudText Typo="Typo.subtitle2" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Class="mr-1" />@AppStrings.T("FuzzySettings")</MudText>
                                <MudStack Spacing="2">
                                    <MudSwitch T="bool"
                                               @bind-Value="answer.AllowFuzzyMatch"
                                               Color="Color.Primary"
                                               Label="@AppStrings.T("EnableFuzzy")" />
                                    
                                    @if (answer.AllowFuzzyMatch)
                                    {
                                        <MudStack>
                                            <MudText Typo="Typo.caption">
                                                @AppStrings.Tf("AcceptanceThresholdValue", answer.AcceptanceThreshold.ToString("P0"))
                                            </MudText>
                                            <MudSlider T="double"
                                                       @bind-Value="answer.AcceptanceThreshold"
                                                       Min="0.5"
                                                       Max="1.0"
                                                       Step="0.05"
                                                       Color="Color.Info" />
                                            
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @GetAcceptanceThresholdDescription(answer.AcceptanceThreshold)
                                            </MudText>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudStack>
                    }
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddAnswer"
                               Disabled="@(correctAnswers.Count >= MaxAnswers)"
                               Class="mt-2">
                        @AppStrings.T("AddAnswer")
                    </MudButton>
                </MudItem>



                <!-- Hints -->
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="qf-form-section">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">
                                        <MudIcon Icon="@Icons.Material.Outlined.Lightbulb" Class="mr-1" />
                                        @AppStrings.T("Hints")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @AppStrings.T("HintsDescription")
                                    </MudText>
                                </MudStack>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddHint"
                                           Disabled="@(hints.Count >= MaxHints)">
                                    @AppStrings.T("AddHint")
                                </MudButton>
                            </MudStack>

                            @if (hints.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@AppStrings.T("NoHintsAdded")</MudText>
                            }

                            @for (var i = 0; i < hints.Count; i++)
                            {
                                var index = i;
                                var hint = hints[index];

                                <MudPaper @key="index" Elevation="1" Class="pa-3">
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Class="flex-wrap gap-2">
                                        <MudTextField @bind-Value="hint.HintText"
                                                      Label="@AppStrings.Tf("HintNumber", index + 1)"
                                                      Variant="Variant.Outlined"
                                                      MaxLength="300"
                                                      Counter="300"
                                                      Immediate="true"
                                                      Style="min-width: 260px; flex-grow: 1;" />
                                        <MudNumericField T="int"
                                                         @bind-Value="hint.RevealTimeSeconds"
                                                         Label="@AppStrings.T("RevealAtSeconds")"
                                                         Variant="Variant.Outlined"
                                                         Min="0"
                                                         Max="300"
                                                         Style="width: 160px;" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       OnClick="@(() => RemoveHintAtIndex(index))" />
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <!-- Tags -->
                <MudItem xs="12">
                    <MudSelect T="string"
                               @bind-SelectedValues="selectedTagIds"
                               Label="@AppStrings.T("Tags")"
                               Variant="Variant.Outlined"
                               MultiSelection="true"
                               ToStringFunc="@GetTagName"
                               MultiSelectionTextFunc="@GetSelectedTagsText"
                               HelperText="@AppStrings.T("TagsHelper")">
                        @foreach (var tag in availableTags)
                        {
                            <MudSelectItem T="string" Value="@tag.Id.ToString()">@tag.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Suggest Tag -->
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="qf-form-section">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">
                                <MudIcon Icon="@Icons.Material.Filled.NewLabel" Class="mr-1" />
                                @AppStrings.T("MissingTag")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @AppStrings.T("SuggestTagDescription")
                            </MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Start" Class="flex-wrap gap-2">
                                <MudTextField @bind-Value="suggestedTagName"
                                              Label="@AppStrings.T("NewTagName")"
                                              Variant="Variant.Outlined"
                                              Immediate="true"
                                              MaxLength="50"
                                              Counter="50"
                                              Style="min-width: 220px; flex-grow: 1;" />
                                <MudTextField @bind-Value="suggestedTagDescription"
                                              Label="@AppStrings.T("Description")"
                                              Variant="Variant.Outlined"
                                              MaxLength="500"
                                              Counter="500"
                                              Style="min-width: 260px; flex-grow: 2;" />
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Send"
                                           Disabled="@(isSuggestingTag || string.IsNullOrWhiteSpace(suggestedTagName))"
                                           OnClick="@SuggestTag">
                                    @AppStrings.T("SuggestTag")
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <!-- Explanation -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="explanation"
                                  Label="@AppStrings.T("ExplanationOptional")"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  MaxLength="1000"
                                  Counter="1000"
                                  HelperText="@AppStrings.T("ExplanationHelper")" />
                </MudItem>

                <!-- Submit Button -->
                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => Navigation.NavigateTo("/lobby"))">
                            @AppStrings.T("Cancel")
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(isSubmitting || isUploadingMedia)"
                                   OnClick="SubmitQuestion">
                            @if (isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ml-2">@AppStrings.T("Submitting")</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" />
                                <MudText>@AppStrings.T("SubmitForReview")</MudText>
                            }
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm form = null!;
    private bool isValid;
    private bool isSubmitting;
    private bool isSuggestingTag;

    private string title = string.Empty;
    private string promptText = string.Empty;
    private string questionType = "Text";
    private string difficulty = "Medium";
    private string explanation = string.Empty;
    private string suggestedTagName = string.Empty;
    private string suggestedTagDescription = string.Empty;
    private IBrowserFile? selectedMediaFile;
    private string? uploadedMediaUrl;
    private string? mediaUploadError;

    private const int MaxAnswers = 10;
    private const int MaxHints = 6;
    private const int MaxSelectedTags = 8;

    private bool isUploadingMedia;
    private List<string> validationErrors = new();
    private List<AnswerItem> correctAnswers = new() { new AnswerItem() };
    private List<HintItem> hints = new();
    private IEnumerable<string> selectedTagIds = new HashSet<string>();
    private List<QuizFuzz.Shared.Dtos.Questions.TagDto> availableTags = new();

    private bool RequiresMedia => questionType is "Image" or "Audio";
    private string MediaAccept => questionType == "Image"
        ? ".jpg,.jpeg,.png,.gif,.webp,image/*"
        : ".mp3,.wav,.ogg,.m4a,audio/*";
    private string MediaIcon => questionType == "Image"
        ? Icons.Material.Filled.Image
        : Icons.Material.Filled.AudioFile;

    private class AnswerItem
    {
        public string Text { get; set; } = string.Empty;
        public bool AllowFuzzyMatch { get; set; } = true;
        public double AcceptanceThreshold { get; set; } = 0.7;
    }

    private class HintItem
    {
        public string HintText { get; set; } = string.Empty;
        public int RevealTimeSeconds { get; set; } = 15;
    }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("[SuggestQuestion] Page initialized");
        await LoadTags();
    }

    private async Task LoadTags()
    {
        try
        {
            Logger.LogDebug("[SuggestQuestion] Loading tags...");
            availableTags = await TagsClient.GetAllTagsAsync();
            Logger.LogDebug("[SuggestQuestion] Loaded {Count} tags", availableTags.Count);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "[SuggestQuestion] Error loading tags");
            Snackbar.Add(AppStrings.Tf("TagsLoadFailedWithError", ex.Message), Severity.Error);
        }
    }

    private Task OnQuestionTypeChanged(string value)
    {
        if (questionType != value)
        {
            questionType = value;
            selectedMediaFile = null;
            uploadedMediaUrl = null;
            mediaUploadError = null;
        }

        return Task.CompletedTask;
    }

    private async Task OnMediaFileSelected(InputFileChangeEventArgs e)
    {
        selectedMediaFile = e.File;
        uploadedMediaUrl = null;
        mediaUploadError = null;

        if (selectedMediaFile is null)
            return;

        var maxSize = questionType == "Image" ? 10 * 1024 * 1024L : 20 * 1024 * 1024L;
        if (selectedMediaFile.Size > maxSize)
        {
            mediaUploadError = questionType == "Image"
                ? AppStrings.T("ImageFileTooLarge")
                : AppStrings.T("AudioFileTooLarge");
            Snackbar.Add(mediaUploadError, Severity.Error);
            return;
        }

        try
        {
            isUploadingMedia = true;
            var result = questionType == "Image"
                ? await MediaClient.UploadImageAsync(selectedMediaFile)
                : await MediaClient.UploadAudioAsync(selectedMediaFile);

            if (result is null || string.IsNullOrWhiteSpace(result.Url))
            {
                mediaUploadError = AppStrings.T("MediaUploadFailed");
                Snackbar.Add(mediaUploadError, Severity.Error);
                return;
            }

            uploadedMediaUrl = result.Url;
            Snackbar.Add(AppStrings.T("MediaUploaded"), Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "[SuggestQuestion] Error uploading media");
            mediaUploadError = AppStrings.Tf("MediaUploadFailedWithError", ex.Message);
            Snackbar.Add(mediaUploadError, Severity.Error);
        }
        finally
        {
            isUploadingMedia = false;
        }
    }

    private string GetTagName(string? tagId)
    {
        if (string.IsNullOrWhiteSpace(tagId))
            return string.Empty;

        var tag = availableTags.FirstOrDefault(t => t.Id.ToString() == tagId);
        return tag?.Name ?? tagId;
    }

    private string GetSelectedTagsText(List<string> selectedValues)
    {
        if (selectedValues.Count == 0)
            return string.Empty;

        return string.Join(", ", selectedValues.Select(GetTagName));
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024d / 1024d:0.##} MB";

        return $"{bytes / 1024d:0.##} KB";
    }

    private string GetAcceptanceThresholdDescription(double threshold)
    {
        return threshold switch
        {
            >= 0.9 => AppStrings.T("AcceptanceThresholdVeryStrict"),
            >= 0.8 => AppStrings.T("AcceptanceThresholdStrict"),
            >= 0.7 => AppStrings.T("AcceptanceThresholdModerate"),
            >= 0.6 => AppStrings.T("AcceptanceThresholdLenient"),
            _ => AppStrings.T("AcceptanceThresholdVeryLenient")
        };
    }

    private void AddAnswer()
    {
        if (correctAnswers.Count >= MaxAnswers)
        {
            Snackbar.Add(AppStrings.Tf("MaxAnswersInfo", MaxAnswers), Severity.Info);
            return;
        }

        correctAnswers.Add(new AnswerItem());
        StateHasChanged();
    }

    private void RemoveAnswerAtIndex(int index)
    {
        if (correctAnswers.Count > 1 && index >= 0 && index < correctAnswers.Count)
        {
            correctAnswers.RemoveAt(index);
            StateHasChanged();
        }
    }

    private void AddHint()
    {
        if (hints.Count >= MaxHints)
        {
            Snackbar.Add(AppStrings.Tf("MaxHintsInfo", MaxHints), Severity.Info);
            return;
        }

        var revealTime = hints.Count == 0 ? 15 : Math.Min(300, hints.Max(h => h.RevealTimeSeconds) + 15);
        hints.Add(new HintItem { RevealTimeSeconds = revealTime });
        StateHasChanged();
    }

    private void RemoveHintAtIndex(int index)
    {
        if (index >= 0 && index < hints.Count)
        {
            hints.RemoveAt(index);
            StateHasChanged();
        }
    }



    private async Task SuggestTag()
    {
        if (isSuggestingTag)
            return;

        var tagValidationError = ValidateSuggestedTag();
        if (tagValidationError is not null)
        {
            Snackbar.Add(tagValidationError, Severity.Warning);
            return;
        }

        try
        {
            isSuggestingTag = true;
            var suggested = await TagsClient.SuggestTagAsync(suggestedTagName.Trim(), suggestedTagDescription.Trim());
            if (suggested == null)
            {
                Snackbar.Add(AppStrings.T("SuggestTagFailed"), Severity.Error);
                return;
            }

            Snackbar.Add(AppStrings.Tf("TagSuggestedForModeration", suggested.Name), Severity.Success);
            suggestedTagName = string.Empty;
            suggestedTagDescription = string.Empty;
            await LoadTags();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "[SuggestQuestion] Error suggesting tag");
            Snackbar.Add(AppStrings.Tf("SuggestTagError", ex.Message), Severity.Error);
        }
        finally
        {
            isSuggestingTag = false;
        }
    }
    private List<string> ValidateQuestionSuggestion()
    {
        var errors = new List<string>();

        if (!string.IsNullOrWhiteSpace(title) && title.Trim().Length > 100)
            errors.Add(AppStrings.T("QuestionTitleMaxLength"));

        if (string.IsNullOrWhiteSpace(promptText))
            errors.Add(AppStrings.T("QuestionTextRequired"));
        else
        {
            var promptLength = promptText.Trim().Length;
            if (promptLength < 10)
                errors.Add(AppStrings.T("QuestionTextMinLength"));
            if (promptLength > 2000)
                errors.Add(AppStrings.T("QuestionTextMaxLength"));
        }

        if (questionType is not ("Text" or "Image" or "Audio"))
            errors.Add(AppStrings.T("InvalidQuestionType"));

        if (difficulty is not ("Easy" or "Medium" or "Hard" or "Expert"))
            errors.Add(AppStrings.T("InvalidQuestionDifficulty"));

        var nonEmptyAnswers = correctAnswers
            .Select(a => a.Text?.Trim() ?? string.Empty)
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .ToList();

        if (nonEmptyAnswers.Count == 0)
            errors.Add(AppStrings.T("AtLeastOneAnswerRequired"));

        if (correctAnswers.Count > MaxAnswers)
            errors.Add(AppStrings.Tf("MaxAnswersValidation", MaxAnswers));

        var tooLongAnswer = nonEmptyAnswers.FirstOrDefault(a => a.Length > 200);
        if (tooLongAnswer is not null)
            errors.Add(AppStrings.T("AnswerMaxLength"));

        var duplicateAnswer = nonEmptyAnswers
            .GroupBy(NormalizeForDuplicateCheck)
            .FirstOrDefault(g => g.Count() > 1);
        if (duplicateAnswer is not null)
            errors.Add(AppStrings.Tf("DuplicateAnswer", duplicateAnswer.First()));

        var nonEmptyHints = hints
            .Where(h => !string.IsNullOrWhiteSpace(h.HintText))
            .ToList();

        if (hints.Count > MaxHints)
            errors.Add(AppStrings.Tf("MaxHintsValidation", MaxHints));

        if (hints.Any(h => !string.IsNullOrWhiteSpace(h.HintText) && h.HintText.Trim().Length > 300))
            errors.Add(AppStrings.T("HintMaxLength"));


        if (nonEmptyHints.Any(h => h.RevealTimeSeconds < 0 || h.RevealTimeSeconds > 300))
            errors.Add(AppStrings.T("HintRevealTimeRange"));

        var duplicateHintTime = nonEmptyHints.GroupBy(h => h.RevealTimeSeconds).FirstOrDefault(g => g.Count() > 1);
        if (duplicateHintTime is not null)
            errors.Add(AppStrings.Tf("DuplicateHintRevealTime", duplicateHintTime.Key));

        if (RequiresMedia)
        {
            if (isUploadingMedia)
                errors.Add(AppStrings.T("WaitMediaUpload"));
            else if (string.IsNullOrWhiteSpace(uploadedMediaUrl))
                errors.Add(questionType == "Image"
                    ? AppStrings.T("UploadImageRequired")
                    : AppStrings.T("UploadAudioRequired"));
        }

        var validTagIds = selectedTagIds
            .Where(id => Guid.TryParse(id, out _))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (validTagIds.Count > MaxSelectedTags)
            errors.Add(AppStrings.Tf("MaxTagsValidation", MaxSelectedTags));

        if (!string.IsNullOrWhiteSpace(explanation) && explanation.Trim().Length > 1000)
            errors.Add(AppStrings.T("ExplanationMaxLength"));

        return errors;
    }

    private string? ValidateSuggestedTag()
    {
        var name = suggestedTagName.Trim();
        if (string.IsNullOrWhiteSpace(name))
            return AppStrings.T("EnterTagNameFirst");
        if (name.Length < 2)
            return AppStrings.T("TagNameMin");
        if (name.Length > 50)
            return AppStrings.T("TagNameMax");
        if (availableTags.Any(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase)))
            return AppStrings.T("TagAlreadyExistsOrPending");
        if (!string.IsNullOrWhiteSpace(suggestedTagDescription) && suggestedTagDescription.Trim().Length > 500)
            return AppStrings.T("DescriptionMax");

        return null;
    }

    private static string NormalizeForDuplicateCheck(string value)
        => string.Join(' ', value.Trim().ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries));


    private async Task SubmitQuestion()
    {
        Logger.LogDebug("[SuggestQuestion] Starting question submission");
        
        await form.Validate();
        validationErrors = ValidateQuestionSuggestion();

        if (!isValid || validationErrors.Count > 0)
        {
            Logger.LogDebug("[SuggestQuestion] Form validation failed: {Errors}", string.Join("; ", validationErrors));
            Snackbar.Add(AppStrings.T("FixValidationErrorsBeforeSubmit"), Severity.Warning);
            StateHasChanged();
            return;
        }

        isSubmitting = true;

        try
        {
            Logger.LogDebug("[SuggestQuestion] Building request - Type: {Type}, Difficulty: {Difficulty}, Answers: {Count}", 
                questionType, difficulty, correctAnswers.Count);

            var request = new SuggestQuestionRequest
            {
                Title = string.IsNullOrWhiteSpace(title) ? null : title.Trim(),
                PromptText = promptText.Trim(),
                Type = Enum.Parse<QuestionType>(questionType),
                Difficulty = Enum.Parse<Difficulty>(difficulty),
                CorrectAnswers = correctAnswers
                    .Where(a => !string.IsNullOrWhiteSpace(a.Text))
                    .Select(a => new AnswerWithSettings 
                    { 
                        Text = a.Text.Trim(),
                        AllowFuzzyMatch = a.AllowFuzzyMatch,
                        MinConfidence = a.AcceptanceThreshold
                    })
                    .ToList(),
                TagIds = selectedTagIds
                    .Select(id => Guid.TryParse(id, out var parsed) ? parsed : Guid.Empty)
                    .Where(id => id != Guid.Empty)
                    .ToList(),
                MediaUrl = RequiresMedia ? uploadedMediaUrl : null,
                Explanation = string.IsNullOrWhiteSpace(explanation) ? null : explanation.Trim(),
                Hints = hints
                    .Where(h => !string.IsNullOrWhiteSpace(h.HintText))
                    .OrderBy(h => h.RevealTimeSeconds)
                    .Select((h, index) => new CreateHintRequest
                    {
                        OrderIndex = index,
                        HintText = h.HintText.Trim(),
                        RevealTimeSeconds = h.RevealTimeSeconds
                    })
                    .ToList()
            };

            Logger.LogDebug("[SuggestQuestion] Sending request to API...");
            var success = await QuestionsClient.SuggestQuestionAsync(request);

            if (success)
            {
                Logger.LogDebug("[SuggestQuestion] Question submitted successfully.");
                Snackbar.Add(AppStrings.T("QuestionSubmittedSuccess"), Severity.Success);
                Navigation.NavigateTo("/lobby");
            }
            else
            {
                Logger.LogDebug("[SuggestQuestion] API returned failure");
                Snackbar.Add(AppStrings.T("QuestionSubmitFailed"), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "[SuggestQuestion] Exception during submission");
            Snackbar.Add(AppStrings.Tf("GenericErrorWithMessage", ex.Message), Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            Logger.LogDebug("[SuggestQuestion] Submission process completed");
        }
    }
}
