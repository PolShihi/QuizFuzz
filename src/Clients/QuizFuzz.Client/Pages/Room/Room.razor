@page "/room/{RoomId:guid}"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Client.Services.Auth
@using QuizFuzz.Client.Services.SignalR
@using QuizFuzz.Shared.Dtos.Rooms
@using Microsoft.AspNetCore.SignalR.Client
@attribute [Authorize]
@inject IRoomsApiClient RoomsClient
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Room - QuizFuzz</PageTitle>

@if (room == null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" />
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Elevation="3" Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack>
                            <MudText Typo="Typo.h4">@room.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Host: @room.OwnerUsername
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="2">
                            @if (isOwner && room.Status == "Lobby")
                            {
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           OnClick="@StartGame"
                                           Disabled="@(room.Players.Count < 2)">
                                    Start Game
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Error"
                                       OnClick="@LeaveRoom">
                                Leave Room
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        Players (@room.Players.Count / @room.MaxPlayers)
                    </MudText>

                    @if (!room.Players.Any())
                    {
                        <MudText Color="Color.Secondary">Waiting for players...</MudText>
                    }
                    else
                    {
                        <MudList T="string">
                            @foreach (var player in room.Players)
                            {
                                <MudListItem T="string">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                        <MudText>@player.Username</MudText>
                                        @if (player.IsOwner)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Host</MudChip>
                                        }
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">Room Settings</MudText>
                    <MudStack Spacing="3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Status</MudText>
                            <MudChip T="string" Color="@GetStatusColor(room.Status)">@room.Status</MudChip>
                        </MudStack>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Victory Condition</MudText>
                            <MudText>@room.VictoryConditionType: @room.VictoryValue</MudText>
                        </MudStack>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Privacy</MudText>
                            <MudText>@(room.IsPrivate ? "Private" : "Public")</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

@code {
    [Parameter] public Guid RoomId { get; set; }

    private RoomDetailsDto? room;
    private HubConnection? hubConnection;
    private bool isOwner;
    private Guid currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        currentUserId = user?.Id ?? Guid.Empty;

        await LoadRoomDetails();
        await InitializeSignalR();
    }

    private async Task LoadRoomDetails()
    {
        Console.WriteLine($"📥 [Room] Loading room details for: {RoomId}");
        
        room = await RoomsClient.GetRoomAsync(RoomId);
        
        if (room != null)
        {
            Console.WriteLine($"✅ [Room] Room loaded successfully:");
            Console.WriteLine($"   Name: {room.Name}");
            Console.WriteLine($"   Owner: {room.OwnerUsername}");
            Console.WriteLine($"   Players: {room.Players?.Count ?? 0}/{room.MaxPlayers}");
            Console.WriteLine($"   Status: {room.Status}");
            
            isOwner = room.OwnerId == currentUserId;
            Console.WriteLine($"   Is Owner: {isOwner}");
            
            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"❌ [Room] Failed to load room details!");
        }
    }

    private async Task InitializeSignalR()
    {
        // Backend API URL - НЕ Navigation.BaseUri!
        var hubUrl = "https://localhost:7001/hubs/lobby";
        
        try
        {
            var token = await AuthService.GetTokenAsync();
            
            Console.WriteLine($"🔌 [SignalR] Connecting to: {hubUrl}");
            Console.WriteLine($"🔑 [SignalR] Token: {(string.IsNullOrEmpty(token) ? "MISSING!" : "EXISTS")}");
            
            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult(token);
                })
                .ConfigureLogging(logging =>
                {
                    logging.SetMinimumLevel(LogLevel.Debug);
                })
                .WithAutomaticReconnect()
                .Build();
                
            Console.WriteLine("✅ [SignalR] HubConnection created");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ [SignalR] Error creating connection: {ex.Message}");
            throw;
        }

        // Setup event handlers
        hubConnection.On<string>("PlayerJoined", (username) =>
        {
            Console.WriteLine($"📣 [SignalR Event] PlayerJoined - Username: {username}");
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<string>("PlayerLeft", (username) =>
        {
            Console.WriteLine($"📣 [SignalR Event] PlayerLeft - Username: {username}");
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Guid>("GameStarted", (sessionId) =>
        {
            Console.WriteLine($"📣 [SignalR Event] GameStarted - SessionId: {sessionId}");
            Navigation.NavigateTo($"/game/{sessionId}");
        });

        try
        {
            Console.WriteLine($"🚀 [SignalR] Starting connection to LobbyHub...");
            Console.WriteLine($"   URL: {hubUrl}");
            Console.WriteLine($"   RoomId: {RoomId}");
            
            await hubConnection.StartAsync();
            Console.WriteLine("✅ [SignalR] Connection started successfully!");
            Console.WriteLine($"   ConnectionId: {hubConnection.ConnectionId}");
            Console.WriteLine($"   State: {hubConnection.State}");
            
            Console.WriteLine($"📡 [SignalR] Invoking JoinRoomGroup with RoomId: {RoomId}");
            await hubConnection.InvokeAsync("JoinRoomGroup", RoomId.ToString());
            Console.WriteLine("✅ [SignalR] Successfully joined room group!");
        }
        catch (HttpRequestException httpEx)
        {
            Console.WriteLine($"❌ [SignalR] HTTP error: {httpEx.StatusCode}");
            Console.WriteLine($"❌ [SignalR] Message: {httpEx.Message}");
            Console.WriteLine($"❌ [SignalR] This usually means:");
            Console.WriteLine($"   - Backend API is not running");
            Console.WriteLine($"   - Wrong URL (check https://localhost:7001)");
            Console.WriteLine($"   - CORS not configured properly");
            throw;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ [SignalR] Connection error: {ex.GetType().Name}");
            Console.WriteLine($"❌ [SignalR] Message: {ex.Message}");
            if (ex.InnerException != null)
            {
                Console.WriteLine($"❌ [SignalR] Inner exception: {ex.InnerException.Message}");
            }
            Console.WriteLine($"❌ [SignalR] Stack trace: {ex.StackTrace}");
            throw;
        }
    }

    private async Task StartGame()
    {
        var success = await RoomsClient.StartGameAsync(RoomId);
        if (!success)
        {
            // TODO: РїРѕРєР°Р·Р°С‚СЊ РѕС€РёР±РєСѓ
        }
    }

    private async Task LeaveRoom()
    {
        if (hubConnection != null)
        {
            await hubConnection.InvokeAsync("LeaveRoomGroup", RoomId.ToString());
        }
        
        await RoomsClient.LeaveRoomAsync(RoomId);
        Navigation.NavigateTo("/lobby");
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Lobby" => Color.Success,
            "InProgress" => Color.Warning,
            "Finished" => Color.Default,
            _ => Color.Default
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}

