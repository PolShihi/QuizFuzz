@page "/room/{RoomId:guid}"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Client.Services.Auth
@using QuizFuzz.Shared.Dtos.Rooms
@using QuizFuzz.Client.Localization
@using Microsoft.AspNetCore.SignalR.Client
@attribute [Authorize]
@inject IRoomsApiClient RoomsClient
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>@AppStrings.T("RoomPageTitle")</PageTitle>

@if (room == null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="qf-page-shell">
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Class="qf-muted">@AppStrings.T("LoadingRoom")</MudText>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="qf-page-shell">
        <MudPaper Elevation="0" Class="qf-hero mb-5">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-4">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Class="qf-page-header-icon">
                            <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" />
                        </MudAvatar>
                        <MudText Typo="Typo.h4" Class="qf-section-title">@room.Name</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.Tf("RoomOwner", room.OwnerUsername)</MudText>
                </MudStack>
                <MudStack Row="true" Spacing="2" Class="qf-action-row">
                    @if (isOwner && room.Status == "Lobby")
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Class="qf-choice-button"
                                   OnClick="@StartGame"
                                   Disabled="@(room.Players.Count < 2)">
                            @AppStrings.T("StartGame")
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.ExitToApp"
                               Class="qf-choice-button"
                               OnClick="@LeaveRoom">
                        @AppStrings.T("LeaveRoom")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="8">
                <MudPaper Elevation="0" Class="qf-panel pa-5">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Class="mr-2" />
                            @AppStrings.T("Players")
                        </MudText>
                        <MudChip T="string" Color="Color.Primary" Class="qf-status-chip">
                            @room.Players.Count / @room.MaxPlayers
                        </MudChip>
                    </MudStack>

                    @if (!room.Players.Any())
                    {
                        <MudPaper Elevation="0" Class="qf-empty-state" Style="min-height: 240px;">
                            <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Color="Color.Secondary" />
                            <MudText Typo="Typo.h6">@AppStrings.T("WaitingForPlayers")</MudText>
                            <MudText Class="qf-muted">@AppStrings.T("WaitingForPlayersDescription")</MudText>
                        </MudPaper>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var player in room.Players)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudPaper Elevation="0" Class="qf-player-row">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudAvatar Size="Size.Small" Color="Color.Primary">
                                                @GetInitial(player.Username)
                                            </MudAvatar>
                                            <MudText>@player.Username</MudText>
                                            @if (player.HasActiveSubscription)
                                            {
                                                <PremiumBadge />
                                            }
                                            <MudSpacer />
                                            @if (player.IsOwner)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.AdminPanelSettings">@AppStrings.T("Host")</MudChip>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudStack Spacing="3">
                    <MudPaper Elevation="0" Class="qf-panel pa-5">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                            @AppStrings.T("RoomSettings")
                        </MudText>
                        <MudStack Spacing="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("Status")</MudText>
                                <MudChip T="string" Color="@GetStatusColor(room.Status)" Class="qf-status-chip">@AppStrings.Status(room.Status)</MudChip>
                            </MudStack>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("VictoryCondition")</MudText>
                                <MudText>@AppStrings.VictoryCondition(room.VictoryConditionType, room.VictoryValue)</MudText>
                            </MudStack>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("RoundTime")</MudText>
                                <MudText>@room.RoundTimeLimitSec s</MudText>
                            </MudStack>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("Access")</MudText>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@(room.IsPrivate ? Icons.Material.Filled.Lock : Icons.Material.Filled.Public)" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText>@(room.IsPrivate ? AppStrings.T("Private") : AppStrings.T("Public"))</MudText>
                                </MudStack>
                            </MudStack>
                        </MudStack>
                    </MudPaper>

                    @if (isOwner && room.Status == "Lobby" && room.Players.Count < 2)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Info">
                            @AppStrings.T("NeedTwoPlayers")
                        </MudAlert>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

@code {
    [Parameter] public Guid RoomId { get; set; }

    private RoomDetailsDto? room;
    private HubConnection? hubConnection;
    private bool isOwner;
    private Guid currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        currentUserId = user?.Id ?? Guid.Empty;
        await LoadRoomDetails();
        await InitializeSignalR();
    }

    private async Task LoadRoomDetails()
    {
        room = await RoomsClient.GetRoomAsync(RoomId);
        if (room != null)
        {
            isOwner = room.OwnerId == currentUserId;
            StateHasChanged();
        }
        else
        {
            Snackbar.Add(AppStrings.T("LoadRoomFailed"), Severity.Error);
        }
    }

    private async Task InitializeSignalR()
    {
        var hubUrl = "https://localhost:7001/hubs/lobby";
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options => { options.AccessTokenProvider = async () => await AuthService.GetTokenAsync(); })
                .ConfigureLogging(logging => { logging.SetMinimumLevel(LogLevel.Debug); })
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<object>("PlayerJoined", async (_) => await LoadRoomDetails());
            hubConnection.On<object>("PlayerLeft", async (_) => await LoadRoomDetails());
            hubConnection.On<Guid>("GameStarted", (sessionId) => Navigation.NavigateTo($"/game/{sessionId}"));

            await hubConnection.StartAsync();
            await hubConnection.InvokeAsync("JoinRoomGroup", RoomId.ToString());
        }
        catch (Exception ex)
        {
            Snackbar.Add(AppStrings.Tf("RealtimeConnectFailed", ex.Message), Severity.Error);
        }
    }

    private async Task StartGame()
    {
        var success = await RoomsClient.StartGameAsync(RoomId);
        if (!success)
        {
            Snackbar.Add(AppStrings.T("StartGameFailed"), Severity.Error);
        }
    }

    private async Task LeaveRoom()
    {
        if (hubConnection != null)
        {
            await hubConnection.InvokeAsync("LeaveRoomGroup", RoomId.ToString());
        }

        await RoomsClient.LeaveRoomAsync(RoomId);
        Navigation.NavigateTo("/lobby");
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Lobby" => Color.Success,
            "InProgress" => Color.Warning,
            "Finished" => Color.Default,
            _ => Color.Default
        };
    }

    private string GetInitial(string? username)
    {
        return string.IsNullOrWhiteSpace(username) ? "?" : username.Trim()[0].ToString().ToUpperInvariant();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
