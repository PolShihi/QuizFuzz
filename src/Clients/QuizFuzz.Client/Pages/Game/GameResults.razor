@page "/game/{SessionId:guid}/results"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Game
@using QuizFuzz.Client.Localization
@attribute [Authorize]
@inject IGameApiClient GameClient
@inject NavigationManager Navigation

<PageTitle>@AppStrings.T("GameResultsPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="qf-page-shell">
    <MudPaper Elevation="0" Class="qf-hero mb-5">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Size="Size.Large" Class="qf-page-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" />
            </MudAvatar>
            <MudText Typo="Typo.h3" Align="Align.Center" Class="qf-section-title">@AppStrings.T("GameResultsHeading")</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="qf-muted">@AppStrings.T("GameResultsDescription")</MudText>
        </MudStack>
    </MudPaper>

    @if (scoreboard == null)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Class="qf-muted">@AppStrings.T("LoadingResults")</MudText>
        </MudPaper>
    }
    else if (scoreboard.Players.Any())
    {
        var ordered = scoreboard.Players
            .OrderByDescending(p => p.TotalScore)
            .ThenByDescending(p => p.CorrectAnswers)
            .ThenBy(p => p.Username)
            .Select((player, index) => new { Player = player, Rank = index + 1 })
            .ToList();
        var winner = ordered.First().Player;

        <MudPaper Elevation="0" Class="qf-panel pa-5 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Warning" />
                <MudText Typo="Typo.h5">@AppStrings.T("Winner"): @winner.Username</MudText>
                @if (winner.HasActiveSubscription)
                {
                    <PremiumBadge />
                }
            </MudStack>

            <MudStack Spacing="2">
                @foreach (var item in ordered)
                {
                    var player = item.Player;
                    var rank = item.Rank;

                    <MudPaper Elevation="0" Class="qf-standing-row">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap gap-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <span class="qf-rank-badge @(rank == 1 ? "qf-rank-top" : string.Empty)">#@rank</span>
                                <MudText Typo="Typo.h6">@player.Username</MudText>
                                @if (player.HasActiveSubscription)
                                {
                                    <PremiumBadge />
                                }
                            </MudStack>
                            <MudStack AlignItems="AlignItems.End" Spacing="0">
                                <MudText Typo="Typo.h6" Color="Color.Primary">@player.TotalScore @AppStrings.T("PointsShort")</MudText>
                                <MudText Typo="Typo.caption" Class="qf-muted">@player.CorrectAnswers @AppStrings.T("CorrectShort")</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    }

    <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="qf-action-row">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Home"
                   OnClick="@(() => Navigation.NavigateTo("/lobby"))">
            @AppStrings.T("BackToLobby")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.BarChart"
                   OnClick="@(() => Navigation.NavigateTo("/profile"))">
            @AppStrings.T("ViewStats")
        </MudButton>
    </MudStack>
</MudContainer>

@code {
    [Parameter] public Guid SessionId { get; set; }
    private ScoreboardDto? scoreboard;

    protected override async Task OnInitializedAsync()
    {
        scoreboard = await GameClient.GetScoreboardAsync(SessionId);
    }
}
