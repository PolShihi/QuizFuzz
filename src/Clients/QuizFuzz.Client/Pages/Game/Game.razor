@page "/game/{SessionId:guid}"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Client.Services.Auth
@using QuizFuzz.Client.Components.Shared
@using QuizFuzz.Shared.Dtos.Game
@using Microsoft.AspNetCore.SignalR.Client
@attribute [Authorize]
@inject IGameApiClient GameClient
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Game - QuizFuzz</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (isLoading)
    {
        <MudPaper Class="pa-8 d-flex justify-center">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudPaper>
    }
    else if (currentQuestion == null)
    {
        <MudPaper Elevation="3" Class="pa-8">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h5">Waiting for next question...</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            <!-- Timer and Scoreboard Column -->
            <MudItem xs="12" md="4" lg="3">
                <MudStack Spacing="3">
                    <GameTimer TotalSeconds="@currentQuestion.TimeLimit"
                               StartedAt="@currentQuestion.StartedAt"
                               OnTimeExpired="@OnTimeExpired" />
                    
                    <ScoreboardPanel Scoreboard="@scoreboard" />
                </MudStack>
            </MudItem>

            <!-- Question and Answer Column -->
            <MudItem xs="12" md="8" lg="9">
                <MudPaper Elevation="3" Class="pa-6">
                    <!-- Question -->
                    <MudText Typo="Typo.h4" Class="mb-4">@currentQuestion.Text</MudText>

                    <!-- Media (if any) -->
                    @if (!string.IsNullOrEmpty(currentQuestion.MediaUrl))
                    {
                        <MudPaper Elevation="2" Class="pa-4 mb-4">
                            @if (currentQuestion.QuestionType?.Equals("Image", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <MudImage Src="@currentQuestion.MediaUrl" 
                                          Alt="Question Image" 
                                          Elevation="0" 
                                          Class="rounded-lg" 
                                          ObjectFit="ObjectFit.Contain"
                                          Style="max-height: 400px; width: 100%;" />
                            }
                            else if (currentQuestion.QuestionType?.Equals("Audio", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <audio controls style="width: 100%;">
                                    <source src="@currentQuestion.MediaUrl" type="audio/mpeg">
                                    Your browser does not support audio.
                                </audio>
                            }
                        </MudPaper>
                    }

                    <!-- Hints -->
                    @if (visibleHints.Any())
                    {
                        <MudPaper Elevation="1" Class="pa-3 mb-4" Style="background-color: #fff3cd;">
                            <MudStack Spacing="2">
                                @foreach (var hint in visibleHints)
                                {
                                    <MudText>
                                        <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" Color="Color.Warning" />
                                        Hint @(hint.OrderIndex + 1): @hint.Text
                                    </MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    }

                    <!-- Answer Input -->
                    <MudPaper Elevation="2" Class="pa-4">
                        @if (hasAnsweredCorrectly)
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-4">
                                <MudText>✅ Correct! +@lastScore points</MudText>
                                <MudText Typo="Typo.caption">Waiting for round to end...</MudText>
                            </MudAlert>
                        }
                        else if (lastAnswerCorrect == false && previousAnswers.Any())
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-4">
                                <MudText>❌ Wrong answer. Try again!</MudText>
                            </MudAlert>
                        }

                        <MudTextField @bind-Value="@currentAnswer"
                                      Label="Your Answer"
                                      Variant="Variant.Outlined"
                                      Disabled="@(hasAnsweredCorrectly || timeExpired)"
                                      OnKeyDown="@OnKeyDown"
                                      Immediate="true"
                                      HelperText="@(hasAnsweredCorrectly ? "Correct! Waiting for others..." : "Press Enter to submit. Multiple attempts allowed!")"
                                      Class="mb-4" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   OnClick="@SubmitAnswer"
                                   Disabled="@(string.IsNullOrWhiteSpace(currentAnswer) || hasAnsweredCorrectly || timeExpired)">
                            @if (isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Submitting...</span>
                            }
                            else if (hasAnsweredCorrectly)
                            {
                                <span>✓ Correct! Waiting for others...</span>
                            }
                            else if (timeExpired)
                            {
                                <span>Time's Up!</span>
                            }
                            else
                            {
                                <span>Submit Answer (Attempt @(previousAnswers.Count + 1))</span>
                            }
                        </MudButton>
                    </MudPaper>

                    <!-- Previous Answers -->
                    @if (previousAnswers.Any())
                    {
                        <MudPaper Elevation="1" Class="pa-3 mt-4">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Your attempts this round:</MudText>
                            <MudStack Spacing="1">
                                @foreach (var ans in previousAnswers)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">• @ans</MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private HubConnection? hubConnection;
    private GameQuestionDto? currentQuestion;
    private ScoreboardDto? scoreboard;
    private string currentAnswer = string.Empty;
    private List<string> previousAnswers = new();
    private List<HintDto> visibleHints = new();
    private bool isLoading = true;
    private bool hasAnsweredCorrectly = false;
    private bool timeExpired = false;
    private bool isSubmitting = false;
    private bool lastAnswerCorrect = false;
    private int lastScore = 0;
    private DateTime questionStartTime;

    protected override async Task OnInitializedAsync()
    {
        await LoadGameData();
        await InitializeSignalR();
        StartHintTimer();
    }

    private async Task LoadGameData()
    {
        Console.WriteLine($"🔄 [Game.LoadGameData] Loading game data for session {SessionId}");
        isLoading = true;
        
        currentQuestion = await GameClient.GetCurrentQuestionAsync(SessionId);
        scoreboard = await GameClient.GetScoreboardAsync(SessionId);
        
        if (currentQuestion != null)
        {
            Console.WriteLine($"✅ [Game.LoadGameData] Question loaded:");
            Console.WriteLine($"   📝 Text: {currentQuestion.Text}");
            Console.WriteLine($"   🎯 Type: {currentQuestion.QuestionType}");
            Console.WriteLine($"   🔗 MediaUrl: {currentQuestion.MediaUrl ?? "NULL"}");
            
            questionStartTime = currentQuestion.StartedAt;
            
            // 🔥 ПРОВЕРКА: Есть ли MediaUrl при первой загрузке?
            if (!string.IsNullOrEmpty(currentQuestion.MediaUrl))
            {
                Console.WriteLine($"🖼️ [Game.LoadGameData] MEDIA DETECTED on initial load!");
            }
        }
        else
        {
            Console.WriteLine($"⚠️ [Game.LoadGameData] No current question available");
        }
        
        isLoading = false;
        Console.WriteLine($"✅ [Game.LoadGameData] Loading complete");
    }

    private async Task InitializeSignalR()
    {
        Console.WriteLine("🎮 [Game] ========== INITIALIZING SIGNALR ==========");
        
        var token = await AuthService.GetTokenAsync();
        Console.WriteLine($"🔑 [Game] Token: {(string.IsNullOrEmpty(token) ? "MISSING!" : "EXISTS")}");
        
        // 🔥 КРИТИЧНО: Используем правильный API URL!
        var apiBase = "https://localhost:7001";
        var hubUrl = $"{apiBase}/hubs/game";
        
        Console.WriteLine($"🔌 [Game] Connecting to GameHub: {hubUrl}");
        Console.WriteLine($"🎯 [Game] Session ID: {SessionId}");
        
        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                options.AccessTokenProvider = () => Task.FromResult(token);
            })
            .ConfigureLogging(logging =>
            {
                logging.SetMinimumLevel(LogLevel.Debug);
            })
            .WithAutomaticReconnect()
            .Build();
        
        Console.WriteLine("✅ [Game] HubConnection created");

        // Round Started - New Question
        hubConnection.On<string>("RoundStarted", async (questionJson) =>
        {
            await InvokeAsync(async () =>
            {
                Console.WriteLine("════════════════════════════════════════");
                Console.WriteLine("🎮 [Game] RoundStarted event received!");
                Console.WriteLine($"📦 [Game] Raw JSON: {questionJson}");
                
                try
                {
                    var options = new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        // Игнорировать лишние поля которых нет в DTO
                        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.Never
                    };
                    
                    currentQuestion = System.Text.Json.JsonSerializer.Deserialize<GameQuestionDto>(questionJson, options);
                    Console.WriteLine($"✅ [Game] Question deserialized successfully!");
                    Console.WriteLine($"   Question ID: {currentQuestion?.QuestionId}");
                    Console.WriteLine($"   Text: {currentQuestion?.Text}");
                    Console.WriteLine($"   Round ID: {currentQuestion?.RoundId}");
                    Console.WriteLine($"   🎯 Type: {currentQuestion?.QuestionType}");
                    Console.WriteLine($"   🔗 MediaUrl: {currentQuestion?.MediaUrl ?? "NULL"}");
                    Console.WriteLine($"   ⏱️ TimeLimit: {currentQuestion?.TimeLimit}s");
                    
                    // 🔥 ПРОВЕРКА: Отображается ли MediaUrl в UI?
                    if (!string.IsNullOrEmpty(currentQuestion?.MediaUrl))
                    {
                        Console.WriteLine($"🖼️ [Game] MEDIA DETECTED! Type={currentQuestion.QuestionType}, URL={currentQuestion.MediaUrl}");
                        if (currentQuestion.QuestionType?.Equals("Image", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            Console.WriteLine($"   📸 [Game] Will display IMAGE: {currentQuestion.MediaUrl}");
                        }
                        else if (currentQuestion.QuestionType?.Equals("Audio", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            Console.WriteLine($"   🔊 [Game] Will play AUDIO: {currentQuestion.MediaUrl}");
                        }
                        else
                        {
                            Console.WriteLine($"   ⚠️ [Game] Unknown media type: {currentQuestion.QuestionType}");
                        }
                    }
                    else
                    {
                        Console.WriteLine($"ℹ️ [Game] No media for this question (Type: {currentQuestion?.QuestionType})");
                    }
                    
                    hasAnsweredCorrectly = false;
                    timeExpired = false;
                    currentAnswer = string.Empty;
                    previousAnswers.Clear();
                    visibleHints.Clear();
                    lastAnswerCorrect = false;
                    lastScore = 0;
                    
                    if (currentQuestion != null)
                    {
                        questionStartTime = currentQuestion.StartedAt;
                        StartHintTimer();
                        Console.WriteLine($"⏱️ [Game] Timer started. Question start time: {questionStartTime}");
                    }
                    else
                    {
                        Console.WriteLine("⚠️ [Game] currentQuestion is NULL after deserialization!");
                    }
                    
                    Console.WriteLine("🔄 [Game] Calling StateHasChanged...");
                    StateHasChanged();
                    Console.WriteLine("✅ [Game] StateHasChanged complete. UI should update now!");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"❌ [Game] ERROR in RoundStarted handler: {ex.Message}");
                    Console.WriteLine($"   Stack: {ex.StackTrace}");
                }
                
                Console.WriteLine("════════════════════════════════════════");
            });
        });

        // Round Ended
        hubConnection.On<object>("RoundEnded", async (data) =>
        {
            await InvokeAsync(() =>
            {
                Console.WriteLine("════════════════════════════════════════");
                Console.WriteLine("🏁 [Game] RoundEnded event received!");
                Console.WriteLine($"📦 [Game] Data: {System.Text.Json.JsonSerializer.Serialize(data)}");
                
                timeExpired = true;
                
                Console.WriteLine("⏳ [Game] Waiting for next round...");
                Console.WriteLine("   (Should receive RoundStarted in ~5 seconds)");
                
                StateHasChanged();
                Console.WriteLine("════════════════════════════════════════");
            });
        });

        // Scoreboard Updated
        hubConnection.On<string>("ScoreboardUpdated", async (scoreboardJson) =>
        {
            await InvokeAsync(() =>
            {
                Console.WriteLine("📊 [Game] ScoreboardUpdated event received!");
                scoreboard = System.Text.Json.JsonSerializer.Deserialize<ScoreboardDto>(scoreboardJson);
                StateHasChanged();
            });
        });
        
        // Player Answered - перезагружаем scoreboard
        hubConnection.On<object>("PlayerAnswered", async (data) =>
        {
            await InvokeAsync(async () =>
            {
                Console.WriteLine("👤 [Game] PlayerAnswered event received! Reloading scoreboard...");
                // Перезагружаем scoreboard чтобы получить актуальные очки
                scoreboard = await GameClient.GetScoreboardAsync(SessionId);
                Console.WriteLine($"📊 [Game] Scoreboard reloaded. Players: {scoreboard?.Players?.Count ?? 0}");
                StateHasChanged();
            });
        });

        // Answer Result (from SubmitAnswer in GameHub)
        hubConnection.On<object>("AnswerResult", async (resultData) =>
        {
            await InvokeAsync(() =>
            {
                Console.WriteLine("📝 [Game] AnswerResult event received!");
                Console.WriteLine($"   Data: {System.Text.Json.JsonSerializer.Serialize(resultData)}");
                
                var json = System.Text.Json.JsonSerializer.Serialize(resultData);
                var result = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json);
                
                if (result.TryGetProperty("isCorrect", out var isCorrectProp))
                {
                    lastAnswerCorrect = isCorrectProp.GetBoolean();
                    if (lastAnswerCorrect)
                    {
                        hasAnsweredCorrectly = true;
                        Console.WriteLine("✅ [Game] Correct answer! Waiting for round to end...");
                    }
                }
                
                if (result.TryGetProperty("scoreAwarded", out var scoreProp))
                {
                    lastScore = scoreProp.GetInt32();
                }
                
                // Если получили ответ - перезагрузим scoreboard для актуальных данных
                if (lastAnswerCorrect)
                {
                    Console.WriteLine("📊 [Game] Correct answer! Reloading scoreboard...");
                    Task.Run(async () =>
                    {
                        await Task.Delay(500); // Небольшая задержка чтобы backend успел обновить
                        scoreboard = await GameClient.GetScoreboardAsync(SessionId);
                        await InvokeAsync(StateHasChanged);
                    });
                }
                
                StateHasChanged();
            });
        });

        // Game Finished
        hubConnection.On<object>("GameFinished", async (data) =>
        {
            await InvokeAsync(() =>
            {
                Console.WriteLine("════════════════════════════════════════");
                Console.WriteLine("🏁 [Game] GameFinished event received!");
                Console.WriteLine($"📦 [Game] Data: {System.Text.Json.JsonSerializer.Serialize(data)}");
                Console.WriteLine($"🎯 [Game] Navigating to results page...");
                
                Navigation.NavigateTo($"/game/{SessionId}/results");
                
                Console.WriteLine("✅ [Game] Navigation complete!");
                Console.WriteLine("════════════════════════════════════════");
            });
        });

        try
        {
            Console.WriteLine("🚀 [Game] Starting SignalR connection...");
            await hubConnection.StartAsync();
            Console.WriteLine("✅ [Game] SignalR connection started!");
            Console.WriteLine($"   ConnectionId: {hubConnection.ConnectionId}");
            Console.WriteLine($"   State: {hubConnection.State}");
            
            Console.WriteLine($"📡 [Game] Invoking JoinGame with SessionId: {SessionId}");
            await hubConnection.InvokeAsync("JoinGame", SessionId.ToString());
            Console.WriteLine("✅ [Game] Successfully joined game!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ [Game] SignalR Error: {ex.GetType().Name}");
            Console.WriteLine($"❌ [Game] Message: {ex.Message}");
            if (ex.InnerException != null)
            {
                Console.WriteLine($"❌ [Game] Inner: {ex.InnerException.Message}");
            }
            Console.WriteLine($"❌ [Game] Stack: {ex.StackTrace}");
            throw;
        }
    }

    private void StartHintTimer()
    {
        if (currentQuestion?.Hints == null) return;

        // Запускаем таймер для показа подсказок
        var timer = new System.Threading.Timer(_ =>
        {
            var elapsed = (DateTime.UtcNow - questionStartTime).TotalSeconds;
            var newHints = currentQuestion.Hints
                .Where(h => h.RevealTimeSeconds <= elapsed && !visibleHints.Contains(h))
                .ToList();

            if (newHints.Any())
            {
                InvokeAsync(() =>
                {
                    visibleHints.AddRange(newHints);
                    StateHasChanged();
                });
            }
        }, null, 1000, 1000);
    }

    private async Task SubmitAnswer()
    {
        if (string.IsNullOrWhiteSpace(currentAnswer) || hasAnsweredCorrectly || timeExpired)
            return;

        isSubmitting = true;

        var elapsed = (DateTime.UtcNow - questionStartTime).TotalMilliseconds;
        
        Console.WriteLine($"📤 [Game] Submitting answer: '{currentAnswer}'");
        
        previousAnswers.Add(currentAnswer.Trim());
        var answerToSubmit = currentAnswer.Trim();
        currentAnswer = string.Empty; // Очищаем поле сразу для следующей попытки

        try
        {
            // Отправляем через SignalR
            if (hubConnection?.State == HubConnectionState.Connected)
            {
                await hubConnection.InvokeAsync("SubmitAnswer", currentQuestion!.RoundId, answerToSubmit);
                Console.WriteLine("✅ [Game] Answer submitted via SignalR");
            }
            else
            {
                Console.WriteLine("❌ [Game] SignalR not connected!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ [Game] Error submitting answer: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitAnswer();
        }
    }

    private void OnTimeExpired()
    {
        timeExpired = true;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
