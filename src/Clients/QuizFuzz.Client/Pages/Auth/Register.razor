@page "/register"
@using QuizFuzz.Client.Services.Auth
@using QuizFuzz.Shared.Dtos.Auth
@using QuizFuzz.Client.Localization
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@AppStrings.T("RegisterPageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="qf-auth-shell">
    <MudPaper Elevation="0" Class="qf-auth-card pa-8">
        <MudAvatar Class="qf-auth-mark">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" />
        </MudAvatar>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="qf-section-title" GutterBottom="true">
            @AppStrings.T("RegisterHeading")
        </MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="qf-muted mb-6">
            @AppStrings.T("RegisterDescription")
        </MudText>

        <EditForm Model="@registerRequest" OnValidSubmit="@HandleRegister">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="registerRequest.Username"
                          Label="@AppStrings.T("Username")"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Class="mb-4"
                          For="@(() => registerRequest.Username)" />

            <MudTextField @bind-Value="registerRequest.Email"
                          Label="@AppStrings.T("Email")"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Class="mb-4"
                          For="@(() => registerRequest.Email)" />

            <MudTextField @bind-Value="registerRequest.Password"
                          Label="@AppStrings.T("Password")"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock"
                          Class="mb-4"
                          For="@(() => registerRequest.Password)" />

            <MudTextField @bind-Value="registerRequest.ConfirmPassword"
                          Label="@AppStrings.T("ConfirmPassword")"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.VerifiedUser"
                          Class="mb-4"
                          For="@(() => registerRequest.ConfirmPassword)" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@isLoading"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Class="qf-submit-button mb-4">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <MudText>@AppStrings.T("RegisterInProgress")</MudText>
                }
                else
                {
                    <MudText>@AppStrings.T("RegisterSubmit")</MudText>
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="my-4 qf-soft-divider" />

        <MudText Align="Align.Center" Class="qf-muted">
            @AppStrings.T("AlreadyHaveAccount")
            <MudLink Href="/login" Color="Color.Primary">@AppStrings.T("Login")</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private RegisterRequest registerRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.RegisterAsync(registerRequest);

            if (result != null)
            {
                if (AuthStateProvider is CustomAuthStateProvider customProvider)
                {
                    customProvider.NotifyAuthStateChanged();
                }

                Navigation.NavigateTo("/lobby");
            }
            else
            {
                errorMessage = AppStrings.T("RegisterFailed");
            }
        }
        catch
        {
            errorMessage = AppStrings.T("RegisterError");
        }
        finally
        {
            isLoading = false;
        }
    }
}
