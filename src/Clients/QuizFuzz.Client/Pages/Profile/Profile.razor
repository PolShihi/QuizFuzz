@page "/profile"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Client.Services.Auth
@using QuizFuzz.Shared.Dtos.Users
@attribute [Authorize]
@inject IUsersApiClient UsersClient
@inject IAuthService AuthService

<PageTitle>Profile - QuizFuzz</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (stats == null)
    {
        <MudPaper Class="pa-8 d-flex justify-center">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudPaper>
    }
    else
    {
        <MudGrid>
            <!-- User Info Card -->
            <MudItem xs="12">
                <MudPaper Elevation="3" Class="pa-6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                        <MudAvatar Size="Size.Large" Color="Color.Primary">
                            @stats.Username.Substring(0, 1).ToUpper()
                        </MudAvatar>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h4">@stats.Username</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@stats.Email</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Stats Cards -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" 
                                 Size="Size.Large" 
                                 Color="Color.Primary" />
                        <MudText Typo="Typo.h4">@stats.GamesPlayed</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Games Played</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" 
                                 Size="Size.Large" 
                                 Color="Color.Warning" />
                        <MudText Typo="Typo.h4">@stats.GamesWon</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Games Won</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" 
                                 Size="Size.Large" 
                                 Color="Color.Success" />
                        <MudText Typo="Typo.h4">@stats.QuestionsAnswered</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Questions Answered</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" 
                                 Size="Size.Large" 
                                 Color="Color.Info" />
                        <MudText Typo="Typo.h4">@GetAverageTimeDisplay()</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Avg Answer Time</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Performance Metrics -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">Win Rate</MudText>
                    <MudProgressLinear Value="@stats.WinRate" 
                                       Size="Size.Large" 
                                       Color="Color.Success" 
                                       Class="mb-2" />
                    <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Success">
                        @stats.WinRate.ToString("F1")%
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">Accuracy</MudText>
                    <MudProgressLinear Value="@stats.Accuracy" 
                                       Size="Size.Large" 
                                       Color="Color.Primary" 
                                       Class="mb-2" />
                    <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary">
                        @stats.Accuracy.ToString("F1")%
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- Achievements (placeholder) -->
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">Achievements</MudText>
                    <MudGrid>
                        @if (stats.GamesPlayed >= 1)
                        {
                            <MudItem xs="6" sm="4" md="3">
                                <MudPaper Elevation="1" Class="pa-3">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                                        <MudText Typo="Typo.caption" Align="Align.Center">First Game</MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                        @if (stats.GamesWon >= 1)
                        {
                            <MudItem xs="6" sm="4" md="3">
                                <MudPaper Elevation="1" Class="pa-3">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" />
                                        <MudText Typo="Typo.caption" Align="Align.Center">First Win</MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                        @if (stats.QuestionsAnswered >= 10)
                        {
                            <MudItem xs="6" sm="4" md="3">
                                <MudPaper Elevation="1" Class="pa-3">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Quiz" Color="Color.Info" />
                                        <MudText Typo="Typo.caption" Align="Align.Center">10 Questions</MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                        @if (stats.GamesWon >= 10)
                        {
                            <MudItem xs="6" sm="4" md="3">
                                <MudPaper Elevation="1" Class="pa-3">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Success" />
                                        <MudText Typo="Typo.caption" Align="Align.Center">Veteran</MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private UserStatsDto? stats;

    protected override async Task OnInitializedAsync()
    {
        stats = await UsersClient.GetMyStatsAsync();
    }

    private string GetAverageTimeDisplay()
    {
        if (stats == null || stats.AverageAnswerTimeMs == 0)
            return "N/A";

        var seconds = stats.AverageAnswerTimeMs / 1000.0;
        return $"{seconds:F1}s";
    }
}
