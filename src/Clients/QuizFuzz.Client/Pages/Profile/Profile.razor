@page "/profile"
@using QuizFuzz.Client.Services.Api
@using QuizFuzz.Shared.Dtos.Users
@using QuizFuzz.Shared.Dtos.Subscriptions
@using QuizFuzz.Client.Localization
@attribute [Authorize]
@inject IUsersApiClient UsersClient
@inject ISubscriptionsApiClient SubscriptionsClient
@inject ISnackbar Snackbar

<PageTitle>@AppStrings.T("ProfilePageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="qf-page-shell">
    @if (stats == null)
    {
        <MudPaper Elevation="0" Class="qf-empty-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Class="qf-muted">@AppStrings.T("LoadingProfile")</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="qf-hero mb-5">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="flex-wrap">
                <MudAvatar Size="Size.Large" Class="qf-page-header-icon">
                    @stats.Username.Substring(0, 1).ToUpperInvariant()
                </MudAvatar>
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                        <MudText Typo="Typo.h4" Class="qf-section-title">@stats.Username</MudText>
                        @if (subscription?.IsActive == true || stats.HasActiveSubscription)
                        {
                            <PremiumBadge />
                        }
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="qf-muted">@stats.Email</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (stats.IsDetailedStatsAvailable)
        {
        <MudPaper Elevation="0" Class="qf-panel pa-4 mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-3">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6">@AppStrings.T("Leaderboard")</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("LeaderboardProfileHint")</MudText>
                    </MudStack>
                    <MudButton Href="/leaderboard" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Leaderboard">
                        @AppStrings.T("OpenLeaderboard")
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="qf-stat-card pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h4">@stats.GamesPlayed</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("GamesPlayed")</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="qf-stat-card pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Color="Color.Warning" />
                        <MudText Typo="Typo.h4">@stats.GamesWon</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("GamesWon")</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="qf-stat-card pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                        <MudText Typo="Typo.h4">@stats.CorrectAnswers</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("CorrectAnswers")</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="qf-stat-card pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Large" Color="Color.Info" />
                        <MudText Typo="Typo.h4">@GetAverageTimeDisplay()</MudText>
                        <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("AvgAnswerTime")</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="qf-panel pa-5">
                    <MudText Typo="Typo.h6" Class="mb-4">@AppStrings.T("WinRate")</MudText>
                    <MudProgressLinear Value="@stats.WinRate" Size="Size.Large" Color="Color.Success" Class="mb-3" />
                    <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Success">@stats.WinRate.ToString("F1")%</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="qf-panel pa-5">
                    <MudText Typo="Typo.h6" Class="mb-4">@AppStrings.T("Accuracy")</MudText>
                    <MudProgressLinear Value="@stats.Accuracy" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                    <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary">@stats.Accuracy.ToString("F1")%</MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="qf-muted d-block mt-2">
                        @AppStrings.Tf("AccuracyRoundsHint", stats.QuestionsAnswered, stats.CorrectAnswers, stats.AnswerAttempts)
                    </MudText>
                </MudPaper>
            </MudItem>

            @if (stats.IsDetailedStatsAvailable)
            {
            <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="qf-panel pa-5">
                        <MudText Typo="Typo.h6" Class="mb-4">@AppStrings.T("BestResults")</MudText>
                        <MudSimpleTable Dense="true" Hover="false">
                            <tbody>
                                <tr><td>@AppStrings.T("TotalScore")</td><td class="text-end">@stats.TotalScore</td></tr>
                                <tr><td>@AppStrings.T("AverageScore")</td><td class="text-end">@stats.AverageScorePerGame.ToString("F1")</td></tr>
                                <tr><td>@AppStrings.T("BestGameScore")</td><td class="text-end">@stats.BestGameScore</td></tr>
                                <tr><td>@AppStrings.T("BestAnswerTime")</td><td class="text-end">@GetTimeDisplay(stats.BestAnswerTimeMs)</td></tr>
                                <tr><td>@AppStrings.T("BestWinStreak")</td><td class="text-end">@stats.BestWinStreak</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                </MudItem>
    
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="qf-panel pa-5">
                        <MudText Typo="Typo.h6" Class="mb-4">@AppStrings.T("FavoriteTags")</MudText>
                        @if (stats.FavoriteTags.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("NoTagStatsYet")</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var tag in stats.FavoriteTags)
                                {
                                    <MudPaper Elevation="0" Class="qf-player-row pa-3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="gap-3">
                                            <MudText Typo="Typo.body2">@tag.TagName</MudText>
                                            <MudText Typo="Typo.caption" Class="qf-muted">
                                                @AppStrings.Tf("TagStatSummary", tag.QuestionsAnswered, tag.Accuracy)
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
    
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="qf-panel pa-5">
                        <MudText Typo="Typo.h6" Class="mb-4">@AppStrings.T("StrongCategories")</MudText>
                        @if (stats.StrongTags.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("NoStrongCategoriesYet")</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var tag in stats.StrongTags)
                                {
                                    <MudPaper Elevation="0" Class="qf-player-row pa-3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="gap-3">
                                            <MudText Typo="Typo.body2">@tag.TagName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Success">@AppStrings.Tf("TagStatSummary", tag.QuestionsAnswered, tag.Accuracy)</MudText>
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
    
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="qf-panel pa-5">
                        <MudText Typo="Typo.h6" Class="mb-4">@AppStrings.T("WeakCategories")</MudText>
                        @if (stats.WeakTags.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("NoWeakCategoriesYet")</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var tag in stats.WeakTags)
                                {
                                    <MudPaper Elevation="0" Class="qf-player-row pa-3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="gap-3">
                                            <MudText Typo="Typo.body2">@tag.TagName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Warning">@AppStrings.Tf("TagStatSummary", tag.QuestionsAnswered, tag.Accuracy)</MudText>
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
    
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="qf-panel pa-5">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.EditNote" Color="Color.Info" />
                            <MudText Typo="Typo.h6">@AppStrings.T("AuthorQuestionStats")</MudText>
                        </MudStack>
    
                        @if (stats.AuthorStats.TotalQuestions == 0)
                        {
                            <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("NoAuthorStatsYet")</MudText>
                        }
                        else
                        {
                            <MudGrid>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Class="qf-muted">@AppStrings.T("QuestionsTotal")</MudText>
                                    <MudText Typo="Typo.h6">@stats.AuthorStats.TotalQuestions</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Class="qf-muted">@AppStrings.T("QuestionsApproved")</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Success">@stats.AuthorStats.ApprovedQuestions</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Class="qf-muted">@AppStrings.T("ApprovalRate")</MudText>
                                    <MudText Typo="Typo.h6">@stats.AuthorStats.ApprovalRate.ToString("F1")%</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Class="qf-muted">@AppStrings.T("QuestionsPlayed")</MudText>
                                    <MudText Typo="Typo.h6">@stats.AuthorStats.TimesPlayed</MudText>
                                </MudItem>
                            </MudGrid>
                            <MudSimpleTable Dense="true" Class="mt-4">
                                <tbody>
                                    <tr><td>@AppStrings.T("StatusUnderReview")</td><td class="text-end">@stats.AuthorStats.UnderReviewQuestions</td></tr>
                                    <tr><td>@AppStrings.T("StatusRejected")</td><td class="text-end">@stats.AuthorStats.RejectedQuestions</td></tr>
                                    <tr><td>@AppStrings.T("StatusDraft")</td><td class="text-end">@stats.AuthorStats.DraftQuestions</td></tr>
                                    <tr><td>@AppStrings.T("AuthorQuestionsAnswerAccuracy")</td><td class="text-end">@stats.AuthorStats.AnswerAccuracy.ToString("F1")%</td></tr>
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudPaper>
                </MudItem>
            }

            <MudItem xs="12">
                <MudPaper Elevation="0" Class="qf-panel pa-5">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-3">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">@AppStrings.T("PremiumSubscription")</MudText>
                                @if (subscription?.IsActive == true || stats.HasActiveSubscription)
                                {
                                    <PremiumBadge />
                                }
                            </MudStack>
                            <MudText Typo="Typo.body2" Class="qf-muted">@GetSubscriptionDescription()</MudText>
                        </MudStack>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.WorkspacePremium"
                                   Disabled="@isActivatingSubscription"
                                   OnClick="@ActivateSubscription">
                            @(isActivatingSubscription ? AppStrings.T("Activating") : AppStrings.T(subscription?.IsActive == true ? "ExtendMonthlySubscription" : "ActivateMonthlySubscription"))
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            @if (!stats.IsDetailedStatsAvailable)
            {
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="qf-panel pa-5">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="flex-wrap gap-4">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
                                    <MudText Typo="Typo.h6">@AppStrings.T("PremiumStatsLockedTitle")</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("PremiumStatsLockedDescription")</MudText>
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Class="qf-muted">• @AppStrings.T("PremiumStatsFeatureCategories")</MudText>
                                    <MudText Typo="Typo.caption" Class="qf-muted">• @AppStrings.T("PremiumStatsFeatureHistory")</MudText>
                                    <MudText Typo="Typo.caption" Class="qf-muted">• @AppStrings.T("PremiumStatsFeatureAuthor")</MudText>
                                    <MudText Typo="Typo.caption" Class="qf-muted">• @AppStrings.T("PremiumStatsFeatureLeaderboard")</MudText>
                                </MudStack>
                            </MudStack>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.WorkspacePremium"
                                       Disabled="@isActivatingSubscription"
                                       OnClick="@ActivateSubscription">
                                @(isActivatingSubscription ? AppStrings.T("Activating") : AppStrings.T("ActivateMonthlySubscription"))
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }

            <MudItem xs="12">
                <MudPaper Elevation="0" Class="qf-panel pa-5">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Warning" />
                        <MudText Typo="Typo.h6">@AppStrings.T("Achievements")</MudText>
                    </MudStack>
                    <MudGrid>
                        @foreach (var achievement in stats.Achievements)
                        {
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudPaper Elevation="0" Class="qf-player-row pa-3" Style="@(achievement.IsUnlocked ? string.Empty : "opacity:0.55")">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@GetAchievementIcon(achievement.Icon)" Color="@(achievement.IsUnlocked ? Color.Warning : Color.Default)" />
                                            <MudText Typo="Typo.subtitle2">@AppStrings.T($"Achievement.{achievement.Code}.Title")</MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Class="qf-muted">@AppStrings.T($"Achievement.{achievement.Code}.Description")</MudText>
                                        @if (achievement.IsUnlocked)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Success">@AppStrings.Tf("UnlockedAt", achievement.UnlockedAt?.ToLocalTime().ToString("dd.MM.yyyy"))</MudText>
                                        }
                                        else
                                        {
                                            <MudProgressLinear Value="@GetAchievementProgressPercent(achievement)" Size="Size.Small" Color="Color.Primary" />
                                            <MudText Typo="Typo.caption" Class="qf-muted">@achievement.Progress / @achievement.Target</MudText>
                                        }
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @if (stats.IsDetailedStatsAvailable)
            {
            <MudItem xs="12">
                    <MudPaper Elevation="0" Class="qf-panel pa-5">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Info" />
                            <MudText Typo="Typo.h6">@AppStrings.T("RecentGames")</MudText>
                        </MudStack>
                        @if (stats.RecentGames.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="qf-muted">@AppStrings.T("NoGamesYet")</MudText>
                        }
                        else
                        {
                            <MudTable Items="@stats.RecentGames" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>@AppStrings.T("Room")</MudTh>
                                    <MudTh>@AppStrings.T("Rank")</MudTh>
                                    <MudTh>@AppStrings.T("Score")</MudTh>
                                    <MudTh>@AppStrings.T("CorrectAnswers")</MudTh>
                                    <MudTh>@AppStrings.T("Date")</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.RoomName</MudTd>
                                    <MudTd>#@context.Rank / @context.PlayersCount</MudTd>
                                    <MudTd>@context.ScoreTotal</MudTd>
                                    <MudTd>@context.CorrectCount</MudTd>
                                    <MudTd>@context.PlayedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private UserStatsDto? stats;
    private SubscriptionStatusDto? subscription;
    private bool isActivatingSubscription;

    protected override async Task OnInitializedAsync()
    {
        stats = await UsersClient.GetMyStatsAsync();
        subscription = await SubscriptionsClient.GetMySubscriptionAsync();
    }

    private async Task ActivateSubscription()
    {
        isActivatingSubscription = true;
        try
        {
            var result = await SubscriptionsClient.ActivateDemoMonthlyAsync();
            if (result == null)
            {
                Snackbar.Add(AppStrings.T("SubscriptionActivationFailed"), Severity.Error);
                return;
            }

            subscription = result;
            stats = await UsersClient.GetMyStatsAsync();

            Snackbar.Add(AppStrings.T("SubscriptionActivated"), Severity.Success);
        }
        finally
        {
            isActivatingSubscription = false;
        }
    }

    private string GetSubscriptionDescription()
    {
        var expiresAt = subscription?.ExpiresAt ?? stats?.SubscriptionExpiresAt;
        var isActive = subscription?.IsActive == true || stats?.HasActiveSubscription == true;

        if (!isActive || !expiresAt.HasValue)
            return AppStrings.T("SubscriptionInactiveDescription");

        return AppStrings.Tf("SubscriptionActiveUntil", expiresAt.Value.ToLocalTime().ToString("dd.MM.yyyy"));
    }

    private string GetAverageTimeDisplay() => GetTimeDisplay(stats?.AverageAnswerTimeMs ?? 0);

    private static string GetTimeDisplay(int milliseconds)
    {
        if (milliseconds <= 0)
            return AppStrings.T("NotAvailable");

        var seconds = milliseconds / 1000.0;
        return $"{seconds:F1}s";
    }

    private static double GetAchievementProgressPercent(UserAchievementDto achievement)
    {
        if (achievement.Target <= 0)
            return 0;

        return Math.Clamp((double)achievement.Progress / achievement.Target * 100, 0, 100);
    }

    private static string GetAchievementIcon(string icon) => icon switch
    {
        "SportsEsports" => Icons.Material.Filled.SportsEsports,
        "EmojiEvents" => Icons.Material.Filled.EmojiEvents,
        "LocalFireDepartment" => Icons.Material.Filled.LocalFireDepartment,
        "CheckCircle" => Icons.Material.Filled.CheckCircle,
        "Quiz" => Icons.Material.Filled.Quiz,
        "Bolt" => Icons.Material.Filled.Bolt,
        "Stars" => Icons.Material.Filled.Stars,
        "MilitaryTech" => Icons.Material.Filled.MilitaryTech,
        "WorkspacePremium" => Icons.Material.Filled.WorkspacePremium,
        _ => Icons.Material.Filled.Star
    };
}
